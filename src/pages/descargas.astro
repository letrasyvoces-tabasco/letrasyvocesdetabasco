---
// src/pages/descargas.astro - Centro de Descargas Documentales, Certámenes y Afiliación de LVT
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import CentroDescargas from '../components/CentroDescargas.astro';
import Convocatorias from '../components/Convocatorias.astro';
import ProcesoMembresia from '../components/ProcesoMembresia.astro';
import GaleriaEventos from '../components/GaleriaEventos.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const basePath = "/letrasyvocesdetabasco";
---

<BaseLayout 
  title="Centro de Descargas Documentales, Certámenes & Afiliación · Sociedad de Escritores LVT"
  description="Descarga de estatutos sociales, actas de asamblea, bases del Certamen «Un Soneto por Sor Juana», protocolo de afiliación y formatos oficiales de LVT, A.C."
>
  <Navbar />

  <main class="pt-16 sm:pt-20">
    <div class="bg-[#F5EFE6] border-b border-[#E6DCCE] py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs font-title uppercase tracking-wider text-gray-500">
        <a href={`${basePath}/`} class="hover:text-[#EF7B38] transition">Inicio</a>
        <span>/</span>
        <span class="text-[#EF7B38] font-bold">Descargas, Convocatorias & Afiliación</span>
      </div>
    </div>

    <!-- 1. Repositorio de Documentos PDF -->
    <CentroDescargas />

    <!-- 2. Certámenes y Convocatorias Estatales -->
    <Convocatorias />

    <!-- 3. Protocolo de Ingreso y Membresía Gremial -->
    <ProcesoMembresia />

    <!-- 4. Galería y Archivo Gráfico -->
    <GaleriaEventos />
  </main>

  <Footer />
</BaseLayout>
