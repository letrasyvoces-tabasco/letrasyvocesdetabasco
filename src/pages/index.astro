---
// index.astro - Portal Institucional Maestro de Letras y Voces de Tabasco, A.C.
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Semblanza from '../components/Semblanza.astro';
import EscuelaGorostiza from '../components/EscuelaGorostiza.astro';
import Publicaciones from '../components/Publicaciones.astro';
import VocesDeTabasco from '../components/VocesDeTabasco.astro';
import DirectorioAutores from '../components/DirectorioAutores.astro';
import GobernanzaHub from '../components/GobernanzaHub.astro';
import Convocatorias from '../components/Convocatorias.astro';
import GaleriaEventos from '../components/GaleriaEventos.astro';
import RifaInteractiva from '../components/RifaInteractiva.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import ReadingModal from '../components/ReadingModal.astro';
import '../styles/global.css';
---

<BaseLayout>
  <!-- Barra de Navegación Flotante Translúcida y Despejada -->
  <Navbar />

  <!-- 1. Pórtico Editorial con Rotador de Citas e Hitos Históricos -->
  <Hero />

  <!-- 2. Historia Fundacional 1987, Cuadro de Pioneros y Cronología de Mesas Directivas -->
  <Semblanza />

  <!-- 3. Filial Académica: Escuela de Escritores «José Gorostiza» (Diplomados UJAT) -->
  <EscuelaGorostiza />

  <!-- 4. Fondo Editorial LVT (Catálogo de 12 Obras Históricas y Coediciones) -->
  <Publicaciones />

  <!-- 5. Fonoteca Audiovisual (Videos Reales) & Sala Lírica de 23 Poetas Íntegros -->
  <VocesDeTabasco />

  <!-- 6. Directorio y Padrón de Escritores con Filtro por Género -->
  <DirectorioAutores />

  <!-- 7. Pabellón Maestro de Gobernanza, Solvencia, Membresía y Descargas PDF -->
  <GobernanzaHub />

  <!-- 8. Convocatorias Oficiales, Certamen «Un Soneto por Sor Juana» y Encuentros Estatales -->
  <Convocatorias />

  <!-- 9. Archivo Histórico y Memoria Gráfica (Fotos Reales de Eventos) -->
  <GaleriaEventos />

  <!-- 10. Iniciativa Pro-Fondos A.C. (Rifa 2026 con Cuadrícula 00-99) -->
  <RifaInteractiva />

  <!-- 11. Secretaría General, Correspondencia y Vinculación -->
  <Contacto />

  <!-- Pie de Página Institucional con Firma Legal -->
  <Footer />

  <!-- Visor Inmersivo Modal de Muestras de Lectura (Pergamino, Marfil, Noche) -->
  <ReadingModal />
</BaseLayout>
