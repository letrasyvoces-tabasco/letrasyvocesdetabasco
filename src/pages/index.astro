import CronologiaFundacional from '../components/CronologiaFundacional.astro';
import EscuelaGorostiza from '../components/EscuelaGorostiza.astro';
import SolvenciaInstitucional from '../components/SolvenciaInstitucional.astro';
import Publicaciones from '../components/Publicaciones.astro';
import VocesDeTabasco from '../components/VocesDeTabasco.astro';
import DirectorioAutores from '../components/DirectorioAutores.astro';
import CentroDescargas from '../components/CentroDescargas.astro';
import ProcesoMembresia from '../components/ProcesoMembresia.astro';
import Convocatorias from '../components/Convocatorias.astro';
