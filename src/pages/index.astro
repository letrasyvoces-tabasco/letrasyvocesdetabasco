---
// index.astro - Portal Institucional Maestro de la Sociedad de Escritores Letras y Voces de Tabasco, A.C.
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Semblanza from '../components/Semblanza.astro';
import SolvenciaInstitucional from '../components/SolvenciaInstitucional.astro';
import Publicaciones from '../components/Publicaciones.astro';
import VocesDeTabasco from '../components/VocesDeTabasco.astro';
import DirectorioAutores from '../components/DirectorioAutores.astro';
import CentroDescargas from '../components/CentroDescargas.astro';
import ProcesoMembresia from '../components/ProcesoMembresia.astro';
import Convocatorias from '../components/Convocatorias.astro';
import GaleriaEventos from '../components/GaleriaEventos.astro';
import RifaInteractiva from '../components/RifaInteractiva.astro';
import MesaDirectiva from '../components/MesaDirectiva.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import ReadingModal from '../components/ReadingModal.astro';
import '../styles/global.css';
---

<BaseLayout>
  <!-- Barra de Navegación Flotante Translúcida -->
  <Navbar />

  <!-- 1. Pórtico Editorial con Rotador de Frases e Hitos Históricos -->
  <Hero />

  <!-- 2. Semblanza Institucional, Misión y Memoria Histórica -->
  <Semblanza />

  <!-- 3. Solvencia Jurídica, Transparencia Notarial y Convenios -->
  <SolvenciaInstitucional />

  <!-- 4. Fondo Editorial LVT (Vitrina con Portadas 3D Interactivas) -->
  <Publicaciones />

  <!-- 5. Dimensión Sonora: Voces de Tabasco (Fonoteca y Sala Lírica) -->
  <VocesDeTabasco />

  <!-- 6. Directorio y Padrón de Escritores con Filtros por Género -->
  <DirectorioAutores />

  <!-- 7. Centro de Documentación y Descargas Oficiales en PDF -->
  <CentroDescargas />

  <!-- 8. Protocolo de Admisión: Proceso de Incorporación de Nuevos Socios -->
  <ProcesoMembresia />

  <!-- 9. Convocatorias Oficiales 2026 y Certámenes Abiertos -->
  <Convocatorias />

  <!-- 10. Archivo Gráfico y Memoria de Encuentros Culturales -->
  <GaleriaEventos />

  <!-- 11. Iniciativa Pro-Fondos A.C. (Rifa Interactiva 2026 con Cuadrícula 00-99) -->
  <RifaInteractiva />

  <!-- 12. Mesa Directiva y Gobernanza Institucional (Gestión 2026 – 2029) -->
  <MesaDirectiva />

  <!-- 13. Secretaría General, Correspondencia y Vinculación -->
  <Contacto />

  <!-- Pie de Página Institucional -->
  <Footer />

  <!-- Visor de Lectura Inmersiva Modal (Marfil, Pergamino, Noche) -->
  <ReadingModal />
</BaseLayout>
