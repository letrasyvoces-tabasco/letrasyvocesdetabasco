---
// index.astro - Página Principal Oficial de Letras y Voces de Tabasco, A.C.
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Semblanza from '../components/Semblanza.astro';
import Publicaciones from '../components/Publicaciones.astro';
import ReadingModal from '../components/ReadingModal.astro';
import Convocatorias from '../components/Convocatorias.astro';
import GaleriaEventos from '../components/GaleriaEventos.astro';
import RifaInteractiva from '../components/RifaInteractiva.astro';
import MesaDirectiva from '../components/MesaDirectiva.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout>
  <!-- Barra de Navegación Flotante Translúcida -->
  <Navbar />

  <!-- Sección 1: Pórtico Editorial con Rotador de Frases e Hitos Históricos -->
  <Hero />

  <!-- Sección 2: Semblanza Institucional, Misión y Visión -->
  <Semblanza />

  <!-- Sección 3: Fondo Editorial LVT (Portadas 3D de Libros) -->
  <Publicaciones />

  <!-- Sección 4: Convocatorias Oficiales 2026 y Cuenta Regresiva -->
  <Convocatorias />

  <!-- Sección 5: Archivo Histórico y Memoria Gráfica de Eventos -->
  <GaleriaEventos />

  <!-- Sección 6: Iniciativa Pro-Fondos A.C. (Rifa 2026 con Cuadrícula 00-99) -->
  <RifaInteractiva />

  <!-- Sección 7: Mesa Directiva y Gobernanza Institucional -->
  <MesaDirectiva />

  <!-- Sección 8: Secretaría General, Correspondencia y Vinculación -->
  <Contacto />

  <!-- Pie de Página Institucional -->
  <Footer />

  <!-- Visor Inmersivo Modal de Muestras de Lectura -->
  <ReadingModal />
</BaseLayout>
