---
// index.astro - Portal Institucional Maestro de Letras y Voces de Tabasco, A.C.
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Semblanza from '../components/Semblanza.astro';
import Publicaciones from '../components/Publicaciones.astro';
import VocesDeTabasco from '../components/VocesDeTabasco.astro';
import DirectorioAutores from '../components/DirectorioAutores.astro';
import GobernanzaHub from '../components/GobernanzaHub.astro';
import Convocatorias from '../components/Convocatorias.astro';
import GaleriaEventos from '../components/GaleriaEventos.astro';
import RifaInteractiva from '../components/RifaInteractiva.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import ReadingModal from '../components/ReadingModal.astro';
import '../styles/global.css';
---

<BaseLayout>
  <!-- Barra de Navegación Flotante Translúcida y Despejada -->
  <Navbar />

  <!-- 1. Pórtico Editorial con Rotador de Citas e Hitos Históricos -->
  <Hero />

  <!-- 2. Semblanza Institucional, Misión y Memoria de 38 Años -->
  <Semblanza />

  <!-- 3. Fondo Editorial LVT (Portadas 3D Interactivas y Lector) -->
  <Publicaciones />

  <!-- 4. Dimensión Sonora: Voces de Tabasco & 20 Maestros Universales -->
  <VocesDeTabasco />

  <!-- 5. Directorio y Padrón de Escritores con Filtro por Género -->
  <DirectorioAutores />

  <!-- 6. Pabellón Maestro de Gobernanza, Solvencia, Membresía y Descargas PDF -->
  <GobernanzaHub />

  <!-- 7. Convocatorias Oficiales 2026 y Cuenta Regresiva al 1 de Octubre -->
  <Convocatorias />

  <!-- 8. Archivo Histórico y Memoria Gráfica (Fotos Reales de Eventos) -->
  <GaleriaEventos />

  <!-- 9. Iniciativa Pro-Fondos A.C. (Rifa 2026 con Cuadrícula 00-99) -->
  <RifaInteractiva />

  <!-- 10. Secretaría General, Correspondencia y Vinculación -->
  <Contacto />

  <!-- Pie de Página Institucional con Firma Legal -->
  <Footer />

  <!-- Visor Inmersivo Modal de Muestras de Lectura (Pergamino, Marfil, Noche) -->
  <ReadingModal />
</BaseLayout>
