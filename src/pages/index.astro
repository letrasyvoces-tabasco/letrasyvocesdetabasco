---
// src/pages/index.astro - Pórtico Editorial y Portal de Bienvenida Autónomo LVT
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import LanzadoresDashboard from '../components/LanzadoresDashboard.astro';
import RifaInteractiva from '../components/RifaInteractiva.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Sociedad de Escritores Letras y Voces de Tabasco, A.C. · Portal Oficial">
  <Navbar />
  
  <main>
    <!-- 1. Pórtico de Bienvenida Editorial -->
    <Hero />
    
    <!-- 2. Pabellones y Lanzadores Interactivos 3D a cada Área Especializada -->
    <LanzadoresDashboard />

    <!-- 3. Rifa Pro-Fondos Conmemorativa -->
    <RifaInteractiva />

    <!-- 4. Secretaría General, Correspondencia y Buzón Directo -->
    <Contacto />
  </main>

  <Footer />
</BaseLayout>
