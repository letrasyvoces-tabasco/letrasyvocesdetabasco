---
// src/pages/autores.astro - Padrón Oficial de Escritores, Fundadores y Plumas de Tabasco
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import DirectorioAutores from '../components/DirectorioAutores.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const basePath = "/letrasyvocesdetabasco";
---

<BaseLayout 
  title="Padrón Oficial de Autores y Fundadores · Sociedad de Escritores LVT, A.C."
  description="Directorio de escritoras, escritores, poetas, cronistas y miembros de la Sociedad de Escritores Letras y Voces de Tabasco, A.C."
>
  <Navbar />

  <main class="pt-16 sm:pt-20">
    <div class="bg-[#F5EFE6] border-b border-[#E6DCCE] py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs font-title uppercase tracking-wider text-gray-500">
        <a href={`${basePath}/`} class="hover:text-[#EF7B38] transition">Inicio</a>
        <span>/</span>
        <span class="text-[#EF7B38] font-bold">Padrón de Escritores y Fundadores</span>
      </div>
    </div>

    <DirectorioAutores />
  </main>

  <Footer />
</BaseLayout>
