---
// src/pages/404.astro - Página 404 Editorial con Enrutador Inteligente
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Página No Encontrada (404) · Letras y Voces de Tabasco, A.C.">
  <Navbar />

  <main class="min-h-[70vh] flex items-center justify-center py-20 px-4 sm:px-6 bg-paper text-ink">
    <div class="max-w-xl text-center space-y-6">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-paper-warm border border-paper-border text-cacao font-swiss text-xs font-bold uppercase tracking-widest">
        <span>Error 404 • Enlace No Encontrado</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-monograph font-bold text-ink">
        Página en <span class="italic text-cacao">Construcción</span>
      </h1>

      <p class="font-serif italic text-base sm:text-lg text-ink-muted leading-relaxed">
        «El sendero literario solicitado no existe o ha sido reubicado en nuestro nuevo ecosistema institucional».
      </p>

      <div class="french-rule max-w-xs mx-auto"><span>⁂</span></div>

      <!-- Accesos Directos -->
      <div class="flex flex-wrap gap-3 justify-center pt-4">
        <a 
          href="/" 
          class="touch-target-48 px-6 py-3 rounded-2xl bg-cacao text-white font-swiss text-xs font-bold uppercase tracking-wider hover:bg-cacao-dark shadow-subtle transition active:scale-95"
        >
          Volver al Inicio
        </a>
        <a 
          href="/escuela" 
          class="touch-target-48 px-6 py-3 rounded-2xl bg-paper-warm text-ink border border-paper-border font-swiss text-xs font-bold uppercase tracking-wider hover:bg-paper-card shadow-subtle transition active:scale-95"
        >
          Escuela Gorostiza
        </a>
        <a 
          href="/publicaciones" 
          class="touch-target-48 px-6 py-3 rounded-2xl bg-paper-warm text-ink border border-paper-border font-swiss text-xs font-bold uppercase tracking-wider hover:bg-paper-card shadow-subtle transition active:scale-95"
        >
          Fondo Editorial
        </a>
      </div>

    </div>
  </main>

  <Footer />

  <!-- Script Inteligente de Redirección Automática para Enlaces Antiguos o Alias -->
  <script is:inline>
    (function() {
      var path = window.location.pathname;
      var lower = path.toLowerCase().replace(/\/$/, "");
      
      // Si el usuario intentó entrar a /eejg o /eejg/ o /escuela
      if (lower === "/eejg" || lower === "/escuela") {
        window.location.replace("/escuela/");
        return;
      }
      
      // Si el usuario venía con el prefijo antiguo de GitHub Pages
      if (path.indexOf("/letrasyvocesdetabasco") === 0) {
        var newPath = path.replace("/letrasyvocesdetabasco", "") || "/";
        window.location.replace(newPath);
      }
    })();
  </script>
</BaseLayout>
