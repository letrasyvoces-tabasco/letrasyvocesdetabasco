---
// src/pages/escuela.astro - Portal Académico Oficial de la Escuela de Escritores «José Gorostiza» (EEJG)
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import EscuelaGorostiza from '../components/EscuelaGorostiza.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout 
  title="Escuela de Escritores «José Gorostiza» (EEJG) · Filial Académica Oficial de LVT, A.C."
  description="Oferta académica 2026: 10 Diplomados, 7 Cursos y Talleres continuos en Creación Literaria, Redacción Profesional y Periodismo Cultural con aval académico UJAT."
>
  <Navbar />

  <main class="pt-16 sm:pt-20">
    <!-- Migas de pan / Breadcrumb -->
    <div class="bg-paper-warm border-b border-paper-border py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs font-swiss uppercase tracking-wider text-ink-muted">
        <a href="/" class="hover:text-cacao transition">Inicio</a>
        <span>/</span>
        <span class="text-cacao font-bold">Escuela de Escritores «José Gorostiza» (EEJG)</span>
      </div>
    </div>

    <!-- Contenido Modular de la Escuela -->
    <EscuelaGorostiza />
  </main>

  <Footer />
</BaseLayout>
