---
// Convocatorias.astro - Certámenes Oficiales, Convocatorias Literarias y Encuentros Estatales de LVT
---

<section id="convocatorias" class="py-14 sm:py-16 bg-editorial border-b border-editorial-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Cabecera de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-editorial-warm border border-editorial-border text-terracota font-title text-[10px] sm:text-[11px] font-bold uppercase tracking-widest mb-3 shadow-subtle">
        <span class="w-2 h-2 rounded-full bg-terracota animate-pulse"></span>
        <span>Certámenes, Encuentros y Convocatorias Oficiales</span>
      </div>
      <h2 class="font-title text-2xl sm:text-3xl lg:text-4xl font-black text-carbon">
        Convocatorias Abiertas y Certámenes
      </h2>
      <p class="text-xs sm:text-sm text-gray-600 mt-2 font-serif italic">
        Mecanismos transparentes de participación democrática, estímulo a la creación lírica y encuentros descentralizados en los 17 municipios de Tabasco.
      </p>
      <div class="w-16 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Bloque 1: Convocatoria Vigente 2026 (Cuenta Regresiva al 1 de Octubre) -->
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-editorial-border shadow-subtle mb-12">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-terracota/10 text-terracota text-[10px] font-title font-bold uppercase tracking-widest">
            <span>[CONVOCATORIA EDITORIAL 2026]</span>
          </div>
          <h3 class="font-serif text-3xl sm:text-4xl font-bold text-carbon leading-tight">
            Antología Estatal LVT 2026
          </h3>
          <p class="text-gray-700 font-light text-sm sm:text-base leading-relaxed">
            Se convoca a escritoras, escritores y poetas con residencia comprobada en el Estado de Tabasco a postular textos inéditos de <strong>poesía, cuento breve o ensayo lírico</strong> para integrar la próxima edición colegiada conmemorativa.
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs text-gray-600 font-light pt-2">
            <div><strong>Géneros:</strong> Poesía / Narrativa</div>
            <div><strong>Extensión:</strong> 1 a 5 cuartillas</div>
            <div><strong>Recepción:</strong> Plica digital</div>
          </div>
        </div>

        <!-- Reloj de Cuenta Regresiva al 1 de Octubre de 2026 -->
        <div class="lg:col-span-5 bg-editorial-warm p-6 sm:p-8 rounded-3xl border border-editorial-border text-center space-y-4">
          <span class="text-[10px] font-title font-bold uppercase tracking-widest text-gray-500 block">
            Cierre de Recepción: 01 de Octubre de 2026
          </span>
          <div class="grid grid-cols-4 gap-2 text-carbon">
            <div class="p-3 bg-white rounded-2xl border border-editorial-border shadow-subtle">
              <span id="timer-days" class="font-serif text-2xl sm:text-3xl font-bold text-terracota block">--</span>
              <span class="text-[9px] font-title uppercase font-semibold text-gray-400">Días</span>
            </div>
            <div class="p-3 bg-white rounded-2xl border border-editorial-border shadow-subtle">
              <span id="timer-hours" class="font-serif text-2xl sm:text-3xl font-bold text-carbon block">--</span>
              <span class="text-[9px] font-title uppercase font-semibold text-gray-400">Horas</span>
            </div>
            <div class="p-3 bg-white rounded-2xl border border-editorial-border shadow-subtle">
              <span id="timer-mins" class="font-serif text-2xl sm:text-3xl font-bold text-carbon block">--</span>
              <span class="text-[9px] font-title uppercase font-semibold text-gray-400">Min</span>
            </div>
            <div class="p-3 bg-white rounded-2xl border border-editorial-border shadow-subtle">
              <span id="timer-secs" class="font-serif text-2xl sm:text-3xl font-bold text-dorado block">--</span>
              <span class="text-[9px] font-title uppercase font-semibold text-gray-400">Seg</span>
            </div>
          </div>
          <a 
            href="https://wa.me/522205889391?text=Hola%20Mesa%20Directiva%20de%20LVT,%20deseo%20solicitar%20las%20bases%20completas%20de%20la%20Convocatoria%202026." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full py-3 rounded-2xl bg-terracota text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-terracota-hover transition shadow-subtle inline-block"
          >
            Solicitar Bases en PDF por WhatsApp
          </a>
        </div>

      </div>
    </div>

    <!-- Bloque 2: Certamen Estatal «Un Soneto por Sor Juana» y Encuentros Históricos -->
    <div class="grid md:grid-cols-2 gap-8">
      
      <!-- Certamen: Un Soneto por Sor Juana -->
      <div class="bg-white p-8 rounded-3xl border border-editorial-border shadow-subtle flex flex-col justify-between hover:shadow-elevated transition">
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="px-3 py-1 rounded-full bg-dorado/15 text-dorado text-[10px] font-title font-bold uppercase tracking-widest">Certamen Clásico Anual</span>
            <span class="text-xs font-mono text-gray-400">Escuela Gorostiza & LVT</span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-carbon">Certamen Estatal «Un Soneto por Sor Juana»</h3>
          <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
            Concurso anual organizado en coordinación con la filial Escuela de Escritores «José Gorostiza» para premiar la composición inédita de sonetos clásicos endecasílabos y alejandrinos, fomentando la métrica y el rigor poético en honor al Fénix de América.
          </p>
          <ul class="text-xs text-gray-600 font-light space-y-1.5 pt-2">
            <li>✦ <strong>Métrica:</strong> Soneto clásico con rima consonante.</li>
            <li>✦ <strong>Participantes:</strong> Poetas y estudiantes radicados en Tabasco.</li>
            <li>✦ <strong>Dictamen:</strong> Jurado calificador colegiado independiente.</li>
          </ul>
        </div>
        <div class="mt-6 pt-4 border-t border-editorial-border flex justify-between items-center">
          <span class="text-xs font-title font-bold uppercase text-dorado">Edición Conmemorativa</span>
          <a 
            href="https://wa.me/522205889391?text=Deseo%20conocer%20las%20bases%20del%20Certamen%20Un%20Soneto%20por%20Sor%20Juana" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-xs font-title font-bold uppercase text-terracota hover:underline"
          >
            Consultar Bases →
          </a>
        </div>
      </div>

      <!-- Encuentro de Escritores: Así Habla Mi Ciudad y Aniversarios -->
      <div class="bg-white p-8 rounded-3xl border border-editorial-border shadow-subtle flex flex-col justify-between hover:shadow-elevated transition">
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="px-3 py-1 rounded-full bg-editorial-warm text-carbon text-[10px] font-title font-bold uppercase tracking-widest">Memoria de Encuentros</span>
            <span class="text-xs font-mono text-gray-400">Descentralización Municipal</span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-carbon">XXVIII Encuentro «Así Habla Mi Ciudad»</h3>
          <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
            Homenaje póstumo a la escritora <strong>Gabriela Gutiérrez Lomasto</strong> con foros descentralizados en 7 municipios (Centro, Centla, Cárdenas, Tacotalpa, Jalpa de Méndez, Paraíso y Nacajuca), integrando talleres de crónica impartidos por Ana Livia Salinas.
          </p>
          <div class="p-4 rounded-2xl bg-editorial-warm border border-editorial-border text-xs text-gray-700 font-light space-y-1">
            <strong>Defensa de las Lenguas Maternas (36º Aniversario):</strong>
            <span>Posicionamiento público en El Jaguar Despertado para proteger el valor intrínseco de las lenguas originarias sin folclorización política.</span>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-editorial-border flex justify-between items-center">
          <span class="text-xs font-title font-bold uppercase text-gray-500">Foro Multisede</span>
          <span class="text-xs font-mono text-gray-400">Archivo Histórico LVT</span>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Cuenta Regresiva Dinámica al 1 de Octubre de 2026
  function updateCountdown() {
    const targetDate = new Date('2026-10-01T23:59:59').getTime();
    const now = new Date().getTime();
    const diff = targetDate - now;

    if (diff <= 0) {
      const el = document.getElementById('timer-days');
      if (el) el.innerText = '0';
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const secs = Math.floor((diff % (1000 * 60)) / 1000);

    const dEl = document.getElementById('timer-days');
    const hEl = document.getElementById('timer-hours');
    const mEl = document.getElementById('timer-mins');
    const sEl = document.getElementById('timer-secs');

    if (dEl) dEl.innerText = days.toString();
    if (hEl) hEl.innerText = hours.toString().padStart(2, '0');
    if (mEl) mEl.innerText = mins.toString().padStart(2, '0');
    if (sEl) sEl.innerText = secs.toString().padStart(2, '0');
  }

  setInterval(updateCountdown, 1000);
  updateCountdown();
</script>
