---
// SolvenciaInstitucional.astro - Certeza Jurídica, Transparencia y Convenios Institucionales
const basePath = "/letrasyvocesdetabasco";
---

<section id="solvencia" class="py-20 bg-white border-b border-editorial-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-editorial-warm border border-editorial-border text-terracota font-title text-[11px] font-bold uppercase tracking-widest mb-3 shadow-subtle">
        <span class="w-2 h-2 rounded-full bg-terracota"></span>
        <span>Marco Jurídico & Alianzas Estratégicas</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-carbon">
        Solvencia Institucional y Gobernanza
      </h2>
      <p class="text-sm sm:text-base text-gray-600 mt-3 font-light leading-relaxed">
        Garantía de legalidad, probidad estatutaria y colaboración activa con organismos culturales, universidades y dependencias gubernamentales.
      </p>
      <div class="w-20 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Cuadrícula de 4 Pilares de Certeza Jurídica -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      
      <!-- Pilar 1: Constitución Legal -->
      <div class="p-7 rounded-3xl bg-editorial border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-terracota/10 border border-terracota/30 flex items-center justify-center text-terracota mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Protocolo Notarial</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Constitución Legal</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Asociación Civil legalmente protocolizada ante Notaría Pública conforme a las leyes del Estado de Tabasco, facultada para la gestión y fomento literario.
          </p>
        </div>
        <div class="mt-5 pt-3 border-t border-editorial-border/70 text-[11px] font-title font-semibold text-terracota">
          Vigencia Estatutaria Plena
        </div>
      </div>

      <!-- Pilar 2: Objeto Social -->
      <div class="p-7 rounded-3xl bg-editorial border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-dorado/10 border border-dorado/30 flex items-center justify-center text-dorado mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Misión Estatutaria</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Objeto Cultural</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Fomento, edición y preservación del patrimonio lírico, formación de nuevas generaciones y vinculación con la comunidad artística nacional.
          </p>
        </div>
        <div class="mt-5 pt-3 border-t border-editorial-border/70 text-[11px] font-title font-semibold text-dorado">
          Fines No Lucrativos
        </div>
      </div>

      <!-- Pilar 3: Gobernanza Democrática -->
      <div class="p-7 rounded-3xl bg-editorial border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-terracota/10 border border-terracota/30 flex items-center justify-center text-terracota mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Estructura Colegiada</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Gobernanza</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Órganos de gobierno electos por asamblea general ordinaria con actas colegiadas y rendición periódica de cuentas ante la membresía.
          </p>
        </div>
        <div class="mt-5 pt-3 border-t border-editorial-border/70 text-[11px] font-title font-semibold text-terracota">
          Periodo 2026 – 2029
        </div>
      </div>

      <!-- Pilar 4: Transparencia y Archivo -->
      <div class="p-7 rounded-3xl bg-editorial border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-dorado/10 border border-dorado/30 flex items-center justify-center text-dorado mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Archivo de Custodia</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Resguardo Legal</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Documentación institucional en custodia formal de la Secretaría General. Disponible para consulta previa acreditación oficial.
          </p>
        </div>
        <div class="mt-5 pt-3 border-t border-editorial-border/70 text-[11px] font-title font-semibold text-dorado">
          Acceso Acreditado
        </div>
      </div>

    </div>

    <!-- Alianzas Estratégicas y Convenios -->
    <div class="bg-editorial p-8 sm:p-10 rounded-3xl border border-editorial-border shadow-subtle">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">
          Vinculación Interinstitucional
        </span>
        <h3 class="font-serif text-2xl font-bold text-carbon">
          Alianzas con Organismos Culturales y Educativos
        </h3>
        <p class="text-xs text-gray-500 font-light mt-1">
          Convenios vigentes y coediciones de fomento literario y preservación patrimonial:
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-5 rounded-2xl bg-white border border-editorial-border shadow-subtle">
          <div class="font-serif text-lg font-bold text-carbon">UJAT</div>
          <div class="text-xs text-gray-500 font-light mt-1">Universidad Juárez Autónoma de Tabasco</div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-editorial-border shadow-subtle">
          <div class="font-serif text-lg font-bold text-carbon">IEC Tabasco</div>
          <div class="text-xs text-gray-500 font-light mt-1">Instituto Estatal de Cultura</div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-editorial-border shadow-subtle">
          <div class="font-serif text-lg font-bold text-carbon">FECA</div>
          <div class="text-xs text-gray-500 font-light mt-1">Fondo Estatal para la Cultura y las Artes</div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-editorial-border shadow-subtle">
          <div class="font-serif text-lg font-bold text-carbon">INBAL</div>
          <div class="text-xs text-gray-500 font-light mt-1">Instituto Nacional de Bellas Artes y Literatura</div>
        </div>
      </div>
    </div>

  </div>
</section>
