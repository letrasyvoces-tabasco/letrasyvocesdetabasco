---
// SolvenciaInstitucional.astro - Certeza Jurídica, Transparencia y Convenios Institucionales
const basePath = "/letrasyvocesdetabasco";
---

<section id="solvencia" class="py-20 bg-white border-b border-editorial-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-editorial-warm border border-editorial-border text-terracota font-title text-[11px] font-bold uppercase tracking-widest mb-3 shadow-subtle">
        <span class="w-2 h-2 rounded-full bg-terracota"></span>
        <span>Marco Jurídico & Alianzas Estratégicas</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-carbon">
        Solvencia Institucional y Transparencia
      </h2>
      <p class="text-sm sm:text-base text-gray-600 mt-3 font-light leading-relaxed">
        Garantía de legalidad, probidad administrativa y colaboración activa con organismos culturales y gubernamentales.
      </p>
      <div class="w-20 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Cuadrícula de 4 Pilares de Certeza Jurídica -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      
      <!-- Pilar 1: Constitución Legal -->
      <div class="p-7 rounded-3xl bg-editorial border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-terracota/10 border border-terracota/30 flex items-center justify-center text-terracota mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Acta Notarial 3426</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Constitución Legal</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Asociación Civil legalmente protocolizada ante Notaría Pública, facultada para la gestión, fomento y defensa de la literatura.
          </p>
        </div>
        <div class="mt-5 pt-3 border-t border-editorial-border/70 text-[11px] font-title font-semibold text-terracota">
          Vigencia Estatutaria Plena
        </div>
      </div>

      <!-- Pilar 2: Objeto Social -->
      <div class="p-7 rounded-3xl bg-editorial border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-dorado/10 border border-dorado/30 flex items-center justify-center text-dorado mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Misión Estatutaria</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Objeto Cultural</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Fomento, edición y preservación del patrimonio lírico, formación de nuevas generaciones y vinculación con la comunidad artística.
          </p>
        </div>
        <div class="mt-5 pt-3 border-t border-editorial-border/70 text-[11px] font-title font-semibold text-dorado">
          Sin Fines de Lucro
        </div>
      </div>

      <!-- Pilar 3: Gobernanza Democrática -->
      <div class="p-7 rounded-3xl bg-editorial border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-terracota/10 border border-terracota/30 flex items-center justify-center text-terracota mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Colegiado 2026 – 2029</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Asamblea & Directiva</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Órganos de gobierno electos por asamblea general ordinaria con actas protocolizadas y rendición periódica de cuentas.
          </p>
        </div>
        <div class="mt-5 pt-3 border-t border-editorial-border/70 text-[11px] font-title font-semibold text-terracota">
          Gobernanza Colegiada
        </div>
      </div>

      <!-- Pilar 4: Autonomía y Sedes -->
      <div class="p-7 rounded-3xl bg-editorial border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-dorado/10 border border-dorado/30 flex items-center justify-center text-dorado mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-widest block mb-1">Sureste de México</span>
          <h3 class="font-serif text-xl font-bold text-carbon mb-2">Sede & Vinculación</h3>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Domicilio fiscal y sede operativa en Villahermosa, con convenios en recintos universitarios y centros culturales del Estado.
          </p>
        </div>
        <div class="mt-5 pt-3 border-t border-editorial-border/70 text-[11px] font-title font-semibold text-dorado">
          Villahermosa, Tabasco
        </div>
      </div>

    </div>

    <!-- Muro de Vínculos y Recintos Culturales de Colaboración -->
    <div class="p-8 sm:p-10 rounded-3xl bg-editorial-warm border border-editorial-border">
      <div class="text-center mb-6">
        <span class="text-[11px] font-title font-bold uppercase tracking-widest text-gray-500">
          Recintos y Entidades con Vínculo de Difusión y Colaboración
        </span>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 items-center justify-items-center text-center">
        <div class="p-4 bg-white/80 rounded-2xl border border-editorial-border/60 w-full shadow-subtle">
          <span class="font-serif text-sm sm:text-base font-bold text-carbon block">Secretaría de Cultura</span>
          <span class="text-[10px] text-gray-500 font-light">Gobierno del Estado de Tabasco</span>
        </div>
        <div class="p-4 bg-white/80 rounded-2xl border border-editorial-border/60 w-full shadow-subtle">
          <span class="font-serif text-sm sm:text-base font-bold text-carbon block">Casa Cacao y Chocolate</span>
          <span class="text-[10px] text-gray-500 font-light">Recinto Universitario Villahermosa</span>
        </div>
        <div class="p-4 bg-white/80 rounded-2xl border border-editorial-border/60 w-full shadow-subtle">
          <span class="font-serif text-sm sm:text-base font-bold text-carbon block">UJAT</span>
          <span class="text-[10px] text-gray-500 font-light">Divulgación y Actividades Académicas</span>
        </div>
        <div class="p-4 bg-white/80 rounded-2xl border border-editorial-border/60 w-full shadow-subtle">
          <span class="font-serif text-sm sm:text-base font-bold text-carbon block">Gremio Independiente</span>
          <span class="text-[10px] text-gray-500 font-light">Autonomía y Pluralidad Lírica</span>
        </div>
      </div>
    </div>

  </div>
</section>
