---
// ReadingModal.astro - Visor Inmersivo de Muestras Literarias con Lógica de Color Rigurosa
---

<div 
  id="reading-modal" 
  class="fixed inset-0 z-50 hidden bg-carbon/85 backdrop-blur-lg flex items-center justify-center p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-book-title"
>
  <div class="relative w-full max-w-3xl max-h-[90vh] bg-editorial rounded-3xl border border-editorial-border shadow-2xl flex flex-col overflow-hidden animate-modal-enter">
    
    <!-- Barra Superior de Control del Lector -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-editorial-border bg-editorial-warm">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-terracota animate-pulse"></span>
        <span id="modal-badge" class="font-title text-[11px] font-bold uppercase tracking-widest text-carbon">
          Muestra de Lectura Oficial
        </span>
      </div>

      <!-- Controles de Accesibilidad de Lectura -->
      <div class="flex items-center gap-2.5">
        <!-- Control de Tamaño de Letra -->
        <div class="flex items-center bg-white border border-editorial-border rounded-xl px-2.5 py-1 gap-1.5 text-xs shadow-subtle">
          <button id="font-decrease" type="button" class="px-2 py-0.5 hover:bg-editorial-warm rounded-lg font-bold text-carbon transition" title="Disminuir tamaño de fuente">A-</button>
          <span class="text-gray-300">|</span>
          <button id="font-increase" type="button" class="px-2 py-0.5 hover:bg-editorial-warm rounded-lg font-bold text-carbon transition" title="Aumentar tamaño de fuente">A+</button>
        </div>

        <!-- Selector de Modo de Fondo -->
        <div class="flex items-center bg-white border border-editorial-border rounded-xl p-1 gap-1.5 shadow-subtle">
          <button id="theme-pergamino" type="button" class="w-6 h-6 rounded-full bg-[#F8F4EC] border-2 border-editorial-border hover:scale-105 transition" title="Modo Pergamino Editorial"></button>
          <button id="theme-marfil" type="button" class="w-6 h-6 rounded-full bg-[#FFFFFF] border-2 border-editorial-border hover:scale-105 transition" title="Modo Marfil Puro"></button>
          <button id="theme-noche" type="button" class="w-6 h-6 rounded-full bg-[#181615] border-2 border-gray-600 hover:scale-105 transition" title="Modo Nocturno"></button>
        </div>

        <!-- Botón Cerrar -->
        <button 
          id="close-reading-modal" 
          type="button" 
          class="p-2 rounded-xl text-gray-500 hover:text-terracota hover:bg-white transition"
          aria-label="Cerrar visor de lectura"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Contenido de Lectura Scrollable -->
    <div id="reader-content-box" class="p-8 sm:p-12 overflow-y-auto flex-1 reader-pergamino transition-colors duration-200">
      <div class="max-w-2xl mx-auto space-y-6">
        
        <div class="text-center pb-6 border-b border-editorial-border/60">
          <h3 id="modal-book-title" class="font-serif text-3xl sm:text-4xl font-bold tracking-tight">
            Animalia Literaria
          </h3>
          <p id="modal-book-author" class="text-xs font-title uppercase tracking-widest reader-badge font-bold mt-2">
            Antología Colectiva de la Sociedad de Escritores
          </p>
        </div>

        <div id="modal-book-text" class="font-serif text-base sm:text-lg leading-relaxed space-y-4">
          <!-- Inyectado dinámicamente -->
        </div>

      </div>
    </div>

    <!-- Barra Inferior con Acciones -->
    <div class="px-6 py-4 border-t border-editorial-border bg-editorial-warm flex flex-col sm:flex-row justify-between items-center gap-4">
      <span class="text-[11px] text-gray-500 font-light">
        Sociedad de Escritores Letras y Voces de Tabasco, A.C.
      </span>
      <div class="flex gap-3">
        <a 
          id="modal-wa-btn" 
          href="https://wa.me/529932647502" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-6 py-2.5 rounded-full bg-terracota text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-terracota-hover transition shadow-subtle inline-flex items-center gap-2"
        >
          <span>Solicitar Ejemplar</span>
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  // Control del Visor de Lectura Inmersivo
  const modal = document.getElementById('reading-modal');
  const closeBtn = document.getElementById('close-reading-modal');
  const contentBox = document.getElementById('reader-content-box');
  const modalTitle = document.getElementById('modal-book-title');
  const modalAuthor = document.getElementById('modal-book-author');
  const modalText = document.getElementById('modal-book-text');
  const modalWaBtn = document.getElementById('modal-wa-btn');

  const bookData: Record<string, { title: string; author: string; waText: string; contentHtml: string }> = {
    'animalia': {
      title: 'Animalia Literaria',
      author: 'Antología Colectiva · 16 Escritores · 131 Páginas',
      waText: 'Hola Mesa Directiva de LVT, leí la muestra de Animalia Literaria y deseo información sobre su adquisición y preventa.',
      contentHtml: `
        <p class="italic text-center mb-6 font-serif">
          «En el trópico húmedo la palabra no se escribe: brota como mangle y canta como agua viva.»
        </p>
        <p class="font-serif text-lg leading-relaxed first-letter:text-5xl first-letter:font-bold first-letter:float-left first-letter:mr-3 first-letter:text-terracota">
          En los meandros del Grijalva y la espesura de la chontalpa, los animales no son meras criaturas del paisaje; son custodios silenciosos de nuestra mitología. En esta obra conmemorativa, dieciséis plumas tabasqueñas entrelazan versos y relatos donde el quelonio, el jaguar y la garza morena dialogan con el alma del navegante.
        </p>
        <p class="font-serif leading-relaxed">
          Cada página es un testimonio de la biodiversidad que palpita en el Sureste de México, uniendo el rigor formal de la métrica con la libertad del cuento moderno. Una edición cuidadosamente diagramada en 131 páginas que constituye ya una pieza clave en el acervo bibliográfico de nuestra entidad.
        </p>
        <div class="my-6 p-4 rounded-xl reader-quote-box border-l-4 italic text-sm">
          «Bajo la sombra del guayacán florecido,<br>
          el ojo del reptil vigila el río:<br>
          no hay tiempo en el pantano, solo canto.»
        </div>
      `
    },
    'corazon': {
      title: 'A corazón abierto',
      author: 'María de los Ángeles Cervantes Rosas',
      waText: 'Hola Mesa Directiva de LVT, leí la muestra de A corazón abierto de María Cervantes y deseo adquirir un ejemplar.',
      contentHtml: `
        <p class="italic text-center mb-6 font-serif">
          «Abrir el pecho a la memoria es dejar que el río lave las heridas de la tarde.»
        </p>
        <p class="font-serif text-lg leading-relaxed first-letter:text-5xl first-letter:font-bold first-letter:float-left first-letter:mr-3 first-letter:text-terracota">
          Hay libros que se leen y libros que se sienten en la piel. «A corazón abierto» es un viaje de redención lírica donde María de los Ángeles Cervantes Rosas explora los laberintos de la ausencia, la ternura y la reconciliación con el destino.
        </p>
        <p class="font-serif leading-relaxed">
          Presentada el 30 de mayo de 2026 en el emblemático recinto de la Casa Universitaria Cacao y Chocolate de Villahermosa, esta obra se consolida como una de las voces más honestas y emotivas de la literatura contemporánea en Tabasco.
        </p>
        <div class="my-6 p-4 rounded-xl reader-quote-box border-l-4 italic text-sm">
          «No guardo rencor al viento que deshojó mi jardín;<br>
          en cada pétalo caído aprendí el nombre del agua<br>
          y en cada silencio hallé mi propia voz.»
        </div>
      `
    },
    'tardes': {
      title: 'Tardes Tabasqueñas de Ópalos y Topacios',
      author: 'Antología Conmemorativa Histórica LVT',
      waText: 'Hola Mesa Directiva de LVT, deseo adquirir un ejemplar de la antología conmemorativa Tardes Tabasqueñas de Ópalos y Topacios.',
      contentHtml: `
        <p class="italic text-center mb-6 font-serif">
          «El atardecer en Villahermosa tiñe el río de ópalo y funde el cielo en topacio.»
        </p>
        <p class="font-serif text-lg leading-relaxed first-letter:text-5xl first-letter:font-bold first-letter:float-left first-letter:mr-3 first-letter:text-terracota">
          Compilación histórica que reúne las plumas fundadoras y contemporáneas de Letras y Voces de Tabasco, rindiendo homenaje a la luz crepuscular, a la fertilidad de la tierra y a las costumbres que moldean la identidad del Edén mexicano.
        </p>
      `
    }
  };

  (window as any).openReadingSample = function(bookKey: string) {
    const data = bookData[bookKey];
    if (!data || !modal || !modalTitle || !modalAuthor || !modalText || !modalWaBtn) return;

    modalTitle.innerText = data.title;
    modalAuthor.innerText = data.author;
    modalText.innerHTML = data.contentHtml;
    modalWaBtn.setAttribute('href', `https://wa.me/529932647502?text=${encodeURIComponent(data.waText)}`);

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  };

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  // Controles de Tamaño de Fuente
  let currentFontSize = 18;
  const fontInc = document.getElementById('font-increase');
  const fontDec = document.getElementById('font-decrease');
  if (fontInc && modalText) {
    fontInc.addEventListener('click', () => {
      if (currentFontSize < 26) {
        currentFontSize += 2;
        modalText.style.fontSize = `${currentFontSize}px`;
      }
    });
  }
  if (fontDec && modalText) {
    fontDec.addEventListener('click', () => {
      if (currentFontSize > 14) {
        currentFontSize -= 2;
        modalText.style.fontSize = `${currentFontSize}px`;
      }
    });
  }

  // Controles de Temas
  const themePergamino = document.getElementById('theme-pergamino');
  const themeMarfil = document.getElementById('theme-marfil');
  const themeNoche = document.getElementById('theme-noche');

  function applyTheme(themeClass: string) {
    if (!contentBox) return;
    contentBox.className = `p-8 sm:p-12 overflow-y-auto flex-1 transition-colors duration-200 ${themeClass}`;
  }

  if (themePergamino) themePergamino.addEventListener('click', () => applyTheme('reader-pergamino'));
  if (themeMarfil) themeMarfil.addEventListener('click', () => applyTheme('reader-marfil'));
  if (themeNoche) themeNoche.addEventListener('click', () => applyTheme('reader-noche'));
</script>
