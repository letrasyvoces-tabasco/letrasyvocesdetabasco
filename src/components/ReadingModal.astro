---
// ReadingModal.astro - Visor Inmersivo de Muestras Literarias con Ergonomía Táctil de 48px y 100dvh
---

<div 
  id="reading-modal" 
  class="fixed inset-0 z-50 hidden bg-black/85 backdrop-blur-md flex items-end sm:items-center justify-center p-0 sm:p-4 overscroll-contain"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-book-title"
>
  <div class="relative w-full max-w-3xl modal-viewport-safe bg-paper rounded-t-3xl sm:rounded-3xl border border-paper-border shadow-2xl flex flex-col overflow-hidden animate-modal-enter">
    
    <!-- Barra Superior de Control del Lector (48px Touch Targets) -->
    <div class="flex items-center justify-between px-4 sm:px-6 py-3 border-b border-paper-border bg-paper-warm shrink-0">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-cacao animate-pulse"></span>
        <span id="modal-badge" class="font-swiss text-xs font-bold uppercase tracking-wider text-ink">
          Muestra de Lectura
        </span>
      </div>

      <!-- Controles de Accesibilidad de Lectura -->
      <div class="flex items-center gap-2">
        <!-- Control de Tamaño de Letra -->
        <div class="flex items-center bg-white border border-paper-border rounded-xl shadow-subtle overflow-hidden">
          <button id="font-decrease" type="button" class="touch-target-48 px-3 font-bold text-ink hover:bg-paper-warm transition active:scale-95" title="Disminuir tamaño de fuente" aria-label="Disminuir tamaño">A-</button>
          <span class="text-gray-300">|</span>
          <button id="font-increase" type="button" class="touch-target-48 px-3 font-bold text-ink hover:bg-paper-warm transition active:scale-95" title="Aumentar tamaño de fuente" aria-label="Aumentar tamaño">A+</button>
        </div>

        <!-- Selector de Modo de Fondo -->
        <div class="flex items-center bg-white border border-paper-border rounded-xl p-1 gap-1.5 shadow-subtle">
          <button id="theme-pergamino" type="button" class="w-7 h-7 rounded-full bg-[#F8F4EC] border-2 border-paper-border hover:scale-105 transition" title="Modo Pergamino Editorial" aria-label="Modo Pergamino"></button>
          <button id="theme-marfil" type="button" class="w-7 h-7 rounded-full bg-[#FFFFFF] border-2 border-paper-border hover:scale-105 transition" title="Modo Marfil Puro" aria-label="Modo Marfil"></button>
          <button id="theme-noche" type="button" class="w-7 h-7 rounded-full bg-[#141210] border-2 border-gray-600 hover:scale-105 transition" title="Modo Nocturno" aria-label="Modo Nocturno"></button>
        </div>

        <!-- Botón Cerrar (48x48px) -->
        <button 
          id="close-reading-modal" 
          type="button" 
          class="touch-target-48 rounded-xl bg-white border border-paper-border text-ink hover:text-cacao transition active:scale-95 shadow-subtle"
          aria-label="Cerrar visor de lectura"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Contenido de Lectura Scrollable con Padding Proporcional Móvil -->
    <div id="reader-content-box" class="p-5 sm:p-10 overflow-y-auto flex-1 reader-pergamino transition-colors duration-200">
      <div class="max-w-2xl mx-auto space-y-6">
        
        <div class="text-center pb-5 border-b border-paper-border">
          <h3 id="modal-book-title" class="font-monograph text-2xl sm:text-4xl font-bold tracking-tight text-ink">
            Animalia Literaria
          </h3>
          <p id="modal-book-author" class="text-xs font-swiss uppercase tracking-wider text-oro-dark font-bold mt-2">
            Antología Colectiva de la Sociedad de Escritores
          </p>
        </div>

        <div id="modal-book-text" class="font-serif text-base sm:text-lg leading-relaxed space-y-4 text-ink">
          <!-- Inyectado dinámicamente -->
        </div>

        <div class="french-rule my-6"><span>⁂</span></div>

        <div class="text-center text-xs text-ink-faint font-serif italic pt-2">
          Edición y Custodia: Sociedad de Escritores Letras y Voces de Tabasco, A.C.
        </div>

      </div>
    </div>

    <!-- Barra Inferior con Acciones de 48px y Safe Area -->
    <div class="px-5 sm:px-6 py-3.5 border-t border-paper-border bg-paper-warm flex flex-col sm:flex-row justify-between items-center gap-3 shrink-0 pb-[max(0.875rem,env(safe-area-inset-bottom))]">
      <span class="text-xs text-ink-muted font-sans hidden sm:inline">
        Sociedad de Escritores Letras y Voces de Tabasco, A.C.
      </span>
      <div class="w-full sm:w-auto flex gap-3">
        <a 
          id="modal-wa-btn" 
          href="https://wa.me/522205889391" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="touch-target-48 w-full sm:w-auto px-6 py-3 rounded-2xl bg-cacao text-white font-swiss text-xs font-bold uppercase tracking-wider hover:bg-cacao-dark active:scale-95 transition shadow-elevated text-center inline-flex items-center justify-center gap-2"
        >
          <span>Solicitar Ejemplar por WhatsApp</span>
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  // Control del Visor de Lectura Inmersivo
  const modal = document.getElementById('reading-modal');
  const closeBtn = document.getElementById('close-reading-modal');
  const contentBox = document.getElementById('reader-content-box');
  const modalTitle = document.getElementById('modal-book-title');
  const modalAuthor = document.getElementById('modal-book-author');
  const modalText = document.getElementById('modal-book-text');
  const modalWaBtn = document.getElementById('modal-wa-btn') as HTMLAnchorElement | null;

  const fontDecBtn = document.getElementById('font-decrease');
  const fontIncBtn = document.getElementById('font-increase');
  const themePergamino = document.getElementById('theme-pergamino');
  const themeMarfil = document.getElementById('theme-marfil');
  const themeNoche = document.getElementById('theme-noche');

  let currentFontSize = 18;

  const bookData: Record<string, { title: string; author: string; waText: string; contentHtml: string }> = {
    'animalia': {
      title: 'Animalia Literaria',
      author: 'Antología Colectiva · 16 Escritores · 131 Páginas',
      waText: 'Hola Mesa Directiva de LVT, leí la muestra de Animalia Literaria y deseo información sobre su adquisición.',
      contentHtml: `
        <p class="italic text-center mb-6 font-serif text-ink-muted">
          «En el trópico húmedo la palabra no se escribe: brota como mangle y canta como agua viva.»
        </p>
        <p class="drop-cap">
          En los meandros del Grijalva y la espesura de la chontalpa, los animales no son meras criaturas del paisaje; son custodios silenciosos de nuestra mitología. En esta obra conmemorativa, dieciséis plumas tabasqueñas entrelazan versos y relatos donde el quelonio, el jaguar y la garza morena dialogan con el alma del navegante.
        </p>
        <p class="font-serif leading-relaxed">
          Cada página es un testimonio de la biodiversidad que palpita en el Sureste de México, uniendo el rigor formal de la métrica con la libertad del cuento moderno. Una edición cuidadosamente diagramada en 131 páginas que constituye ya una pieza clave en el acervo bibliográfico de nuestra entidad.
        </p>
        <div class="my-6 p-4 rounded-2xl bg-paper-warm border-l-4 border-cacao italic text-sm text-ink-muted font-serif">
          «Bajo la sombra del guayacán florecido,<br>
          el ojo del reptil vigila el río:<br>
          no hay tiempo en el pantano, solo canto.»
        </div>
      `
    },
    'corazon': {
      title: 'A corazón abierto',
      author: 'María de los Ángeles Cervantes Rosas',
      waText: 'Hola Mesa Directiva de LVT, leí la muestra de A corazón abierto de María Cervantes y deseo adquirir un ejemplar.',
      contentHtml: `
        <p class="italic text-center mb-6 font-serif text-ink-muted">
          «Abrir el pecho a la memoria es dejar que el río lave las heridas de la tarde.»
        </p>
        <p class="drop-cap">
          Hay libros que se leen y libros que se sienten en la piel. «A corazón abierto» es un viaje de redención lírica donde María de los Ángeles Cervantes Rosas explora los laberintos de la ausencia, la ternura y la reconciliación con el destino.
        </p>
        <p class="font-serif leading-relaxed">
          Presentada en el emblemático recinto de la Casa Universitaria Cacao y Chocolate de Villahermosa, esta obra se consolida como una de las voces más honestas y emotivas de la literatura contemporánea en Tabasco.
        </p>
      `
    },
    'tardes': {
      title: 'Tardes Tabasqueñas de Ópalos y Topacios',
      author: 'Compilación Oficial LVT (INDAUTOR 2025)',
      waText: 'Hola Mesa Directiva de LVT, deseo adquirir un ejemplar de Tardes Tabasqueñas de Ópalos y Topacios.',
      contentHtml: `
        <p class="italic text-center mb-6 font-serif text-ink-muted">
          «La tarde en Villahermosa no cae: se derrama en oro sobre las aguas del río.»
        </p>
        <p class="drop-cap">
          Monumental compilación que reúne la producción lírica y ensayística de los miembros de la Sociedad de Escritores Letras y Voces de Tabasco, A.C. Registrada formalmente ante el INDAUTOR en 2025, esta antología representa el pulso vivo de las letras tabasqueñas.
        </p>
      `
    }
  };

  function openReader(bookKey: string) {
    const data = bookData[bookKey] || bookData['animalia'];
    if (modalTitle) modalTitle.innerText = data.title;
    if (modalAuthor) modalAuthor.innerText = data.author;
    if (modalText) modalText.innerHTML = data.contentHtml;
    if (modalWaBtn) {
      modalWaBtn.href = `https://wa.me/522205889391?text=${encodeURIComponent(data.waText)}`;
    }
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeReader() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  // Event Listeners
  if (closeBtn) closeBtn.addEventListener('click', closeReader);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeReader();
    });
  }

  // Controles de Tamaño de Letra
  if (fontIncBtn && contentBox) {
    fontIncBtn.addEventListener('click', () => {
      if (currentFontSize < 24) {
        currentFontSize += 2;
        contentBox.style.fontSize = `${currentFontSize}px`;
      }
    });
  }

  if (fontDecBtn && contentBox) {
    fontDecBtn.addEventListener('click', () => {
      if (currentFontSize > 14) {
        currentFontSize -= 2;
        contentBox.style.fontSize = `${currentFontSize}px`;
      }
    });
  }

  // Selector de Modos de Lectura
  if (themePergamino && contentBox) {
    themePergamino.addEventListener('click', () => {
      contentBox.className = 'p-5 sm:p-10 overflow-y-auto flex-1 reader-pergamino transition-colors duration-200';
    });
  }
  if (themeMarfil && contentBox) {
    themeMarfil.addEventListener('click', () => {
      contentBox.className = 'p-5 sm:p-10 overflow-y-auto flex-1 reader-marfil transition-colors duration-200';
    });
  }
  if (themeNoche && contentBox) {
    themeNoche.addEventListener('click', () => {
      contentBox.className = 'p-5 sm:p-10 overflow-y-auto flex-1 reader-noche transition-colors duration-200';
    });
  }

  // Exponer función globalmente para botones de las tarjetas de libros
  (window as any).openReadingModal = openReader;
</script>
