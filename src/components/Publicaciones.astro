---
// Publicaciones.astro - Catálogo Editorial con Portadas 3D y Acceso a Muestra de Lectura
const basePath = "/letrasyvocesdetabasco";
---

<section id="antologias" class="py-24 bg-white border-b border-editorial-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[11px] font-title font-bold text-terracota uppercase tracking-widest block mb-2">Fondo Editorial LVT</span>
      <h2 class="font-serif text-4xl sm:text-5xl font-bold text-carbon">Publicaciones y Antologías</h2>
      <p class="text-sm text-gray-600 mt-2 font-light">Catálogo de obras individuales y compilaciones colectivas editadas bajo el sello institucional.</p>
      <div class="w-16 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Ficha 1: Animalia Literaria (Antología Colectiva - EN IMPRENTA) -->
    <div class="bg-editorial rounded-3xl p-8 sm:p-12 border border-editorial-border shadow-subtle hover:shadow-elevated transition duration-300 mb-12">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        
        <!-- Portada 3D del Libro -->
        <div class="w-full lg:w-2/5 flex justify-center book-stage">
          <div class="relative group cursor-pointer" onclick="openReadingSample('animalia')">
            <img 
              src={`${basePath}/assets/portada_animalialieteraria.png`} 
              alt="Portada Oficial Animalia Literaria" 
              class="w-64 sm:w-72 book-3d object-cover" 
              onerror="this.src='/letrasyvocesdetabasco/assets/logo.svg'" 
            />
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-carbon/90 text-white text-[10px] font-title font-bold uppercase tracking-widest px-3 py-1.5 rounded-full pointer-events-none shadow-lg">
              📖 Clic para leer muestra
            </div>
          </div>
        </div>

        <!-- Ficha Técnica -->
        <div class="w-full lg:w-3/5 text-center lg:text-left space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-terracota text-white text-[10px] font-title font-bold uppercase tracking-widest shadow-sm">
            <span>[EN PROCESO DE IMPRENTA]</span>
          </div>
          
          <h3 class="font-serif text-4xl sm:text-5xl font-bold text-carbon leading-tight">
            Animalia Literaria
          </h3>
          
          <p class="text-gray-700 font-light text-base sm:text-lg leading-relaxed">
            Un mosaico vivo donde convergen plumajes e impresiones heterogéneas. A través de versos íntimos y relatos en claroscuro, 16 escritoras y escritores entablan un diálogo directo con la fauna nativa de Tabasco.
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-6 border-y border-editorial-border text-left">
            <div>
              <span class="text-[10px] font-title font-bold uppercase tracking-wider text-gray-400 block">Autores</span>
              <span class="font-serif text-lg font-bold text-carbon">16 Escritores</span>
            </div>
            <div>
              <span class="text-[10px] font-title font-bold uppercase tracking-wider text-gray-400 block">Páginas</span>
              <span class="font-serif text-lg font-bold text-carbon">131 Páginas</span>
            </div>
            <div>
              <span class="text-[10px] font-title font-bold uppercase tracking-wider text-gray-400 block">Género</span>
              <span class="font-serif text-lg font-bold text-carbon">Poesía & Cuento</span>
            </div>
            <div>
              <span class="text-[10px] font-title font-bold uppercase tracking-wider text-gray-400 block">Estatus</span>
              <span class="font-serif text-lg font-bold text-terracota">En Imprenta</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-4 pt-2 justify-center lg:justify-start">
            <button 
              type="button" 
              onclick="openReadingSample('animalia')" 
              class="px-6 py-3.5 rounded-full bg-editorial-warm border border-editorial-border text-carbon font-title text-xs font-bold uppercase tracking-wider hover:border-terracota hover:text-terracota shadow-subtle transition inline-flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-terracota" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <span>Explorar Muestra de Lectura</span>
            </button>
            <a 
              href="https://wa.me/522205889391?text=Hola%20Mesa%20Directiva%20de%20LVT%2C%20deseo%20informaci%C3%B3n%20sobre%20la%20preventa%20y%20presentaci%C3%B3n%20de%20la%20antolog%C3%ADa%20Animalia%20Literaria." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-6 py-3.5 rounded-full bg-terracota text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-terracota-hover shadow-subtle hover:shadow-elevated transition"
            >
              Solicitar Información / Preventa
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Ficha 2: A corazón abierto (Obra Individual - María Cervantes) -->
    <div class="bg-editorial rounded-3xl p-8 sm:p-12 border border-editorial-border shadow-subtle hover:shadow-elevated transition duration-300 mb-12">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        
        <!-- Portada 3D del Libro -->
        <div class="w-full lg:w-2/5 flex justify-center book-stage">
          <div class="relative group cursor-pointer" onclick="openReadingSample('corazon')">
            <img 
              src={`${basePath}/assets/a corazon abierto.png`} 
              alt="Portada A corazón abierto de María Cervantes" 
              class="w-64 sm:w-72 book-3d object-cover" 
              onerror="this.src='/letrasyvocesdetabasco/assets/logo.svg'" 
            />
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-carbon/90 text-white text-[10px] font-title font-bold uppercase tracking-widest px-3 py-1.5 rounded-full pointer-events-none shadow-lg">
              📖 Clic para leer muestra
            </div>
          </div>
        </div>

        <!-- Ficha Técnica -->
        <div class="w-full lg:w-3/5 text-center lg:text-left space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-carbon text-white text-[10px] font-title font-bold uppercase tracking-widest shadow-sm">
            <span>[PUBLICACIÓN INDIVIDUAL]</span>
          </div>
          
          <h3 class="font-serif text-4xl sm:text-5xl font-bold text-carbon leading-tight">
            A corazón abierto
          </h3>
          <p class="font-serif text-lg italic text-terracota font-medium">Autora: María de los Ángeles Cervantes Rosas</p>
          
          <p class="text-gray-700 font-light text-base sm:text-lg leading-relaxed">
            Obra introspectiva que transita entre la poesía lírica y la crónica sensible. Presentada magistralmente bajo el auspicio de la asociación el 30 de mayo de 2026 en el recinto de la Casa Universitaria Cacao y Chocolate.
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 py-6 border-y border-editorial-border text-left">
            <div>
              <span class="text-[10px] font-title font-bold uppercase tracking-wider text-gray-400 block">Autoría</span>
              <span class="font-serif text-base font-bold text-carbon">María Cervantes</span>
            </div>
            <div>
              <span class="text-[10px] font-title font-bold uppercase tracking-wider text-gray-400 block">Presentación</span>
              <span class="font-serif text-base font-bold text-carbon">30 Mayo 2026</span>
            </div>
            <div>
              <span class="text-[10px] font-title font-bold uppercase tracking-wider text-gray-400 block">Recinto</span>
              <span class="font-serif text-base font-bold text-carbon">Casa Cacao y Chocolate</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-4 pt-2 justify-center lg:justify-start">
            <button 
              type="button" 
              onclick="openReadingSample('corazon')" 
              class="px-6 py-3.5 rounded-full bg-editorial-warm border border-editorial-border text-carbon font-title text-xs font-bold uppercase tracking-wider hover:border-terracota hover:text-terracota shadow-subtle transition inline-flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-terracota" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <span>Explorar Muestra de Lectura</span>
            </button>
            <a 
              href="https://wa.me/522205889391?text=Hola%20Mesa%20Directiva%20de%20LVT%2C%20deseo%20adquirir%20un%20ejemplar%20del%20libro%20A%20coraz%C3%B3n%20abierto%20de%20Mar%C3%ADa%20Cervantes." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-6 py-3.5 rounded-full bg-carbon text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-terracota transition shadow-subtle hover:shadow-elevated"
            >
              Adquirir Ejemplar vía WhatsApp
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Ficha 3: Tardes Tabasqueñas -->
    <div class="bg-editorial-warm rounded-3xl p-8 border border-editorial-border flex flex-col md:flex-row justify-between items-center gap-6 shadow-subtle">
      <div>
        <span class="text-[10px] font-title font-bold uppercase tracking-widest text-carbon block mb-1">Antología Conmemorativa</span>
        <h4 class="font-serif text-2xl font-bold text-carbon">«Tardes Tabasqueñas de Ópalos y Topacios»</h4>
        <p class="text-xs text-gray-600 mt-1 max-w-2xl font-light">
          Compilación histórica de poemas y relatos que rescata la memoria lírica y tradicional de Tabasco.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <button 
          type="button" 
          onclick="openReadingSample('tardes')" 
          class="px-5 py-3 rounded-full bg-white border border-editorial-border text-carbon font-title text-xs font-bold uppercase hover:border-terracota hover:text-terracota shadow-subtle transition"
        >
          Muestra de Lectura
        </button>
        <a 
          href="https://wa.me/522205889391?text=Hola%20Mesa%20Directiva%20de%20LVT%2C%20deseo%20adquirir%20la%20antolog%C3%ADa%20Tardes%20Tabasque%C3%B1as%20de%20%C3%93palos%20y%20Topacios." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-5 py-3 rounded-full bg-terracota text-white font-title text-xs font-bold uppercase hover:bg-terracota-hover shadow-subtle transition"
        >
          Adquirir Vía WhatsApp
        </a>
      </div>
    </div>

  </div>
</section>
