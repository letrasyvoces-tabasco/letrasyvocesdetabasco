---
// Publicaciones.astro - Catálogo Editorial Exhaustivo & Fondo Bibliográfico Histórico de LVT
import { CATALOGO_EDITORIAL } from '../data/libros';
const basePath = "";

const obrasDestacadas = CATALOGO_EDITORIAL.filter(libro => 
  ['animalia-literaria', 'a-corazon-abierto', 'tardes-tabasquenas', 'la-mujer-en-el-siglo-xxi', 'amarellus'].includes(libro.id)
);
---

<section id="publicaciones" class="py-14 sm:py-16 bg-white border-b border-[#E6DCCE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Cabecera de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#EF7B38]/10 text-[#EF7B38] text-[10px] sm:text-xs font-title font-bold tracking-widest uppercase rounded-full mb-3">
        Fondo Editorial & Acervo Bibliográfico 1987 – 2026
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-title font-black tracking-tight text-[#222222]">
        Antologías, Poemarios y <span class="text-[#EF7B38]">Publicaciones</span>
      </h2>
      <p class="mt-3 text-xs sm:text-sm md:text-base font-serif italic text-[#555555]">
        Acervo editorial histórico y contemporáneo editado y coeditado por la Sociedad de Escritores Letras y Voces de Tabasco, A.C., con registros oficiales ante INDAUTOR e ISBN.
      </p>
      <div class="w-20 h-0.5 bg-[#EF7B38] mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Obras Insignia con Portadas Reales Oficiales -->
    <div class="mb-20">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h3 class="text-xl sm:text-2xl font-title font-black text-[#222222]">
            Antologías y Obras Oficiales de la Asociación
          </h3>
          <p class="text-xs sm:text-sm text-gray-500 font-sans mt-1">
            Producciones colectivas y poemarios conmemorativos con registro formal
          </p>
        </div>
        <span class="text-xs font-mono text-[#EF7B38] font-bold hidden sm:inline-block">
          5 Obras Oficiales Verificadas
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {obrasDestacadas.map((libro) => (
          <div class="bg-[#FDFBF7] rounded-2xl p-6 border border-[#E6DCCE] shadow-subtle hover:border-[#EF7B38] hover:shadow-elevated transition-all flex flex-col justify-between group">
            <div>
              <!-- Portada Real -->
              <div class="relative w-full h-72 sm:h-80 mb-5 bg-[#F5EFE6] rounded-xl overflow-hidden flex items-center justify-center p-2 border border-[#E6DCCE]/50">
                {libro.portadaImg ? (
                  <img 
                    src={`${basePath}${libro.portadaImg}`} 
                    alt={`Portada oficial del libro ${libro.titulo}`} 
                    class="w-full h-full object-contain drop-shadow-md group-hover:scale-102 transition-transform duration-300"
                    loading="lazy"
                  />
                ) : (
                  <div class={`w-full h-full rounded-lg bg-gradient-to-br ${libro.portadaColor} flex items-center justify-center p-6 text-center text-white`}>
                    <span class="font-serif font-bold text-lg">{libro.titulo}</span>
                  </div>
                )}
                
                <span class="absolute top-4 right-4 px-2.5 py-1 rounded-full bg-[#222222]/80 backdrop-blur-sm text-white text-[10px] font-title font-bold uppercase tracking-wider">
                  {libro.anio}
                </span>
              </div>

              <!-- Metadatos de la Antología -->
              <div class="space-y-2.5">
                <div class="flex items-center justify-between gap-2">
                  <span class="px-2.5 py-0.5 rounded-full bg-[#EF7B38]/10 text-[#EF7B38] text-[10px] font-title font-bold uppercase tracking-wider">
                    {libro.genero}
                  </span>
                  <span class="text-[10px] font-mono text-gray-500 font-medium">
                    {libro.paginas} págs. · {libro.disponibilidad}
                  </span>
                </div>

                <h4 class="text-xl font-title font-black text-[#222222] leading-snug group-hover:text-[#EF7B38] transition-colors">
                  {libro.titulo}
                </h4>
                {libro.subtitulo && (
                  <p class="text-xs font-serif italic text-gray-500 -mt-1">{libro.subtitulo}</p>
                )}

                <div class="text-xs font-title font-semibold text-[#B8860B]">
                  {libro.compiladores ? `Compilación: ${libro.compiladores}` : libro.autores}
                </div>

                {libro.prologo && (
                  <p class="text-[11px] text-gray-500 font-sans">
                    <span class="font-bold text-gray-700">Prólogo:</span> {libro.prologo}
                  </p>
                )}

                {(libro.isbn || libro.indautor) && (
                  <div class="text-[10px] font-mono text-gray-500 bg-[#F5EFE6] px-2.5 py-1 rounded border border-[#E6DCCE] flex flex-wrap gap-2">
                    {libro.isbn && <span><strong>ISBN:</strong> {libro.isbn}</span>}
                    {libro.indautor && <span><strong>INDAUTOR:</strong> {libro.indautor}</span>}
                  </div>
                )}

                <p class="text-xs font-sans text-gray-600 leading-relaxed line-clamp-3 pt-1">
                  {libro.sinopsis}
                </p>
              </div>
            </div>

            <!-- Acciones y Detalles -->
            <div class="mt-6 pt-4 border-t border-[#E6DCCE] flex items-center justify-between gap-2">
              <button 
                type="button" 
                onclick={`openBookModal('${libro.id}')`}
                class="px-4 py-2 rounded-xl bg-[#222222] hover:bg-[#EF7B38] text-white font-title text-xs font-bold uppercase tracking-wider transition shadow-sm"
              >
                Ver Ficha Completa
              </button>

              <a 
                href={`https://wa.me/522205889391?text=Hola%20Mesa%20Directiva,%20deseo%20consultar%20informaci%C3%B3n%20sobre%20el%20libro:%20${encodeURIComponent(libro.titulo)}`}
                target="_blank" 
                rel="noopener"
                class="text-xs font-title font-bold uppercase text-[#EF7B38] hover:text-[#D96620] transition-colors"
              >
                Consultar Ejemplar →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Catálogo Completo y Fondo Bibliográfico Histórico -->
    <div class="pt-8 border-t border-[#E6DCCE]">
      
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8">
        <div>
          <h3 class="text-xl sm:text-2xl font-title font-black text-[#222222]">
            Fondo Bibliográfico Completo
          </h3>
          <p class="text-xs sm:text-sm text-gray-500 font-sans mt-1">
            Publicaciones históricas, ensayos, memorias y revistas (1987 – 2026)
          </p>
        </div>

        <!-- Filtros por Género del Acervo Editorial -->
        <div class="inline-flex flex-wrap justify-center p-1 rounded-xl bg-[#F5EFE6] border border-[#E6DCCE] shadow-subtle gap-1">
          <button type="button" class="pub-filter active px-3.5 py-1.5 rounded-lg text-xs font-title font-bold uppercase tracking-wider bg-[#EF7B38] text-white shadow-sm transition" data-filter="all">Todos ({CATALOGO_EDITORIAL.length})</button>
          <button type="button" class="pub-filter px-3.5 py-1.5 rounded-lg text-xs font-title font-bold uppercase tracking-wider text-[#222222] hover:text-[#EF7B38] transition" data-filter="Multigénero">Antologías</button>
          <button type="button" class="pub-filter px-3.5 py-1.5 rounded-lg text-xs font-title font-bold uppercase tracking-wider text-[#222222] hover:text-[#EF7B38] transition" data-filter="Narrativa">Narrativa</button>
          <button type="button" class="pub-filter px-3.5 py-1.5 rounded-lg text-xs font-title font-bold uppercase tracking-wider text-[#222222] hover:text-[#EF7B38] transition" data-filter="Poesía">Poesía</button>
          <button type="button" class="pub-filter px-3.5 py-1.5 rounded-lg text-xs font-title font-bold uppercase tracking-wider text-[#222222] hover:text-[#EF7B38] transition" data-filter="Ensayo">Ensayo</button>
          <button type="button" class="pub-filter px-3.5 py-1.5 rounded-lg text-xs font-title font-bold uppercase tracking-wider text-[#222222] hover:text-[#EF7B38] transition" data-filter="Revista">Revista</button>
        </div>
      </div>

      <!-- Rejilla de Libros Históricos -->
      <div id="books-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {CATALOGO_EDITORIAL.map((libro) => (
          <div class="book-card bg-[#FDFBF7] p-6 rounded-2xl border border-[#E6DCCE] shadow-subtle flex flex-col justify-between hover:border-[#EF7B38] hover:shadow-elevated transition-all" data-genero={libro.genero}>
            <div class="space-y-3">
              <div class="flex justify-between items-start">
                <span class="px-2.5 py-1 rounded-md bg-[#F5EFE6] text-[#222222] text-[10px] font-title font-bold uppercase tracking-wider">
                  {libro.anio} · {libro.genero}
                </span>
                <span class="text-[10px] font-mono text-[#EF7B38] font-bold">
                  {libro.fondo}
                </span>
              </div>

              <div>
                <h4 class="text-lg font-title font-bold text-[#222222] leading-snug">{libro.titulo}</h4>
                {libro.subtitulo && <div class="text-xs font-serif italic text-[#777777] mt-0.5">{libro.subtitulo}</div>}
              </div>

              <p class="text-xs font-medium text-[#B8860B]">{libro.autores}</p>
              
              {libro.indautor && (
                <div class="text-[10px] font-mono text-gray-500">INDAUTOR: {libro.indautor}</div>
              )}
              {libro.isbn && (
                <div class="text-[10px] font-mono text-gray-500">ISBN: {libro.isbn}</div>
              )}

              <p class="text-xs font-sans text-[#555555] leading-relaxed line-clamp-3">{libro.sinopsis}</p>
            </div>

            <div class="mt-6 pt-4 border-t border-[#E6DCCE] flex justify-between items-center text-xs">
              <button 
                type="button" 
                onclick={`openBookModal('${libro.id}')`}
                class="text-xs font-title font-bold uppercase text-[#222222] hover:text-[#EF7B38] transition-colors"
              >
                Ver Ficha →
              </button>
              <a 
                href={`https://wa.me/522205889391?text=Hola%20Mesa%20Directiva,%20deseo%20consultar%20la%20disponibilidad%20del%20libro:%20${encodeURIComponent(libro.titulo)}`}
                target="_blank"
                rel="noopener"
                class="text-xs font-title font-bold uppercase text-[#EF7B38] hover:text-[#D96620] transition-colors"
              >
                Disponibilidad
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>

  <!-- Modal Interactivo de Ficha Bibliográfica y Muestra de Lectura -->
  <div id="book-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 sm:p-8 shadow-2xl border border-[#E6DCCE] relative">
      <button 
        type="button" 
        onclick="closeBookModal()"
        class="absolute top-6 right-6 w-9 h-9 rounded-full bg-[#F5EFE6] text-[#222222] hover:bg-[#EF7B38] hover:text-white flex items-center justify-center transition"
      >
        ✕
      </button>

      <div id="modal-content" class="space-y-4">
        <!-- Contenido generado por JavaScript -->
      </div>
    </div>
  </div>

</section>

<script is:inline define:vars={{ CATALOGO_EDITORIAL, basePath }}>
  // Base de datos expuesta al cliente para el modal interactivo
  window.CATALOGO_EDITORIAL = CATALOGO_EDITORIAL;
  window.basePath = basePath;

  window.openBookModal = function(bookId) {
    const libro = window.CATALOGO_EDITORIAL.find(b => b.id === bookId);
    if (!libro) return;

    const modal = document.getElementById('book-modal');
    const content = document.getElementById('modal-content');
    if (!modal || !content) return;

    let autoresHtml = '';
    if (libro.autoresDetallados && libro.autoresDetallados.length > 0) {
      autoresHtml = `
        <div class="mt-4 pt-4 border-t border-[#E6DCCE]">
          <h5 class="text-xs font-title font-bold uppercase tracking-wider text-[#222222] mb-2">Autores Participantes (${libro.autoresDetallados.length}):</h5>
          <div class="flex flex-wrap gap-1.5 max-h-40 overflow-y-auto p-2 bg-[#FDFBF7] rounded-xl border border-[#E6DCCE]">
            ${libro.autoresDetallados.map(a => `<span class="px-2 py-1 bg-white text-gray-700 text-xs rounded-md border border-[#E6DCCE] font-sans">${a}</span>`).join('')}
          </div>
        </div>
      `;
    }

    let legalHtml = '';
    if (libro.isbn || libro.indautor || libro.coeditores) {
      legalHtml = `
        <div class="p-3 bg-[#F5EFE6] rounded-xl border border-[#E6DCCE] text-xs font-mono space-y-1 text-gray-700">
          ${libro.indautor ? `<div><strong>Registro INDAUTOR:</strong> ${libro.indautor}</div>` : ''}
          ${libro.isbn ? `<div><strong>ISBN:</strong> ${libro.isbn}</div>` : ''}
          ${libro.coeditores ? `<div><strong>Editorial / Coedición:</strong> ${libro.coeditores}</div>` : ''}
          ${libro.prologo ? `<div><strong>Prólogo:</strong> ${libro.prologo}</div>` : ''}
          ${libro.ilustracionPortada ? `<div><strong>Arte de Cubierta / Ilustración:</strong> ${libro.ilustracionPortada}</div>` : ''}
        </div>
      `;
    }

    content.innerHTML = `
      <div class="flex flex-col sm:flex-row items-center gap-6 mb-4">
        ${libro.portadaImg ? `
          <img src="${window.basePath}${libro.portadaImg}" alt="${libro.titulo}" class="w-32 sm:w-36 h-auto rounded-lg shadow-md border border-[#E6DCCE]" />
        ` : ''}
        <div class="space-y-1 text-center sm:text-left flex-1">
          <span class="px-2.5 py-0.5 rounded-full bg-[#EF7B38]/10 text-[#EF7B38] text-[10px] font-title font-bold uppercase tracking-wider">${libro.anio} · ${libro.genero}</span>
          <h3 class="text-2xl font-title font-black text-[#222222]">${libro.titulo}</h3>
          ${libro.subtitulo ? `<p class="text-xs font-serif italic text-gray-500">${libro.subtitulo}</p>` : ''}
          <p class="text-xs font-title font-bold text-[#B8860B] pt-1">${libro.autores}</p>
        </div>
      </div>

      ${legalHtml}

      <div class="space-y-2">
        <h5 class="text-xs font-title font-bold uppercase tracking-wider text-[#222222]">Sinopsis & Contexto Histórico:</h5>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed font-sans">${libro.sinopsis}</p>
      </div>

      <div class="p-4 rounded-2xl bg-[#FDFBF7] border border-[#E6DCCE] space-y-2">
        <h5 class="text-xs font-title font-bold uppercase tracking-wider text-[#EF7B38]">Fragmento de Muestra:</h5>
        <p class="text-xs sm:text-sm font-serif italic text-gray-700 leading-relaxed">«${libro.fragmentoMuestra}»</p>
      </div>

      ${autoresHtml}

      <div class="pt-4 flex flex-wrap justify-between items-center gap-3">
        <span class="text-xs text-gray-400 font-mono">Estado: ${libro.disponibilidad} (${libro.paginas} páginas)</span>
        <a 
          href="https://wa.me/522205889391?text=Hola%20Mesa%20Directiva,%20deseo%20consultar%20el%20ejemplar:%20${encodeURIComponent(libro.titulo)}"
          target="_blank"
          rel="noopener"
          class="px-5 py-2 rounded-xl bg-[#EF7B38] text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-[#D96620] transition shadow-sm"
        >
          Consultar con Mesa Directiva
        </a>
      </div>
    `;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  };

  window.closeBookModal = function() {
    const modal = document.getElementById('book-modal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  };

  window.openReadingSample = function(sampleId) {
    if (sampleId === 'animalia') {
      window.openBookModal('animalia-literaria');
    } else if (sampleId === 'corazon') {
      window.openBookModal('a-corazon-abierto');
    }
  };

  // Filtros de Publicaciones
  const filters = document.querySelectorAll('.pub-filter');
  const cards = document.querySelectorAll('.book-card');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => {
        b.classList.remove('bg-[#EF7B38]', 'text-white', 'shadow-sm');
        b.classList.add('text-[#222222]');
      });
      btn.classList.remove('text-[#222222]');
      btn.classList.add('bg-[#EF7B38]', 'text-white', 'shadow-sm');

      const filterVal = btn.getAttribute('data-filter');

      cards.forEach(card => {
        const genero = card.getAttribute('data-genero');
        if (filterVal === 'all' || genero === filterVal) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
