---
// Publicaciones.astro - Catálogo Editorial Exhaustivo & Fondo Bibliográfico Histórico de LVT
import { CATALOGO_EDITORIAL } from '../data/libros';
const basePath = "/letrasyvocesdetabasco";
---

<section id="publicaciones" class="py-24 bg-white border-b border-[#E6DCCE]">
  <div class="max-w-7xl mx-auto px-6 sm:px-8">
    
    <!-- Cabecera de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#EF7B38]/10 text-[#EF7B38] text-xs font-title font-bold tracking-widest uppercase rounded-full mb-4">
        Fondo Editorial & Acervo Bibliográfico 1987 – 2026
      </div>
      <h2 class="text-3xl sm:text-5xl font-title font-black tracking-tight text-[#222222]">
        Publicaciones, Antologías y <span class="text-[#EF7B38]">Coediciones</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg font-serif italic text-[#555555]">
        Catálogo bibliográfico producido y auspiciado por la Sociedad de Escritores Letras y Voces de Tabasco, A.C., en coedición con la UJAT, el IEC, el ICT y el FECA.
      </p>
    </div>

    <!-- Obras Insignia 2026 (Portadas Originales en Alta Resolución) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
      
      <!-- Ficha 1: Animalia Literaria -->
      <div class="bg-[#FDFBF7] rounded-2xl p-6 sm:p-8 border border-[#E6DCCE] shadow-subtle hover:border-[#EF7B38] transition-all flex flex-col sm:flex-row items-center gap-6">
        <div class="w-44 sm:w-48 shrink-0 flex justify-center">
          <img 
            src={`${basePath}/assets/portada_animalialieteraria.png`} 
            alt="Portada oficial del libro Animalia Literaria" 
            class="w-full max-h-64 object-contain rounded-lg shadow-md cursor-pointer hover:scale-103 transition-transform"
            onclick="openReadingSample('animalia')"
          />
        </div>
        <div class="space-y-3 text-center sm:text-left flex-1">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-[#EF7B38] text-white text-[10px] font-title font-bold uppercase tracking-wider">
              En Imprenta 2026
            </span>
            <span class="text-xs font-mono text-[#777777]">131 Páginas</span>
          </div>
          <h3 class="text-2xl font-title font-black text-[#222222]">Animalia Literaria</h3>
          <p class="text-xs text-[#EF7B38] font-title font-bold">16 Autores Tabasqueños · Poesía & Cuento</p>
          <p class="text-xs sm:text-sm font-sans text-[#555555] leading-relaxed">
            Mosaico vivo donde dieciséis escritoras y escritores entablan un diálogo directo con la fauna nativa del trópico a través de versos íntimos y relatos en claroscuro.
          </p>
          <div class="pt-2">
            <button 
              type="button" 
              onclick="openReadingSample('animalia')"
              class="px-5 py-2 rounded-lg bg-[#222222] hover:bg-[#EF7B38] text-white font-title text-xs font-bold uppercase tracking-wider transition shadow-sm"
            >
              Leer Muestra
            </button>
          </div>
        </div>
      </div>

      <!-- Ficha 2: A corazón abierto -->
      <div class="bg-[#FDFBF7] rounded-2xl p-6 sm:p-8 border border-[#E6DCCE] shadow-subtle hover:border-[#EF7B38] transition-all flex flex-col sm:flex-row items-center gap-6">
        <div class="w-44 sm:w-48 shrink-0 flex justify-center">
          <img 
            src={`${basePath}/assets/a_corazon_abierto.png`} 
            alt="Portada oficial del libro A corazón abierto" 
            class="w-full max-h-64 object-contain rounded-lg shadow-md cursor-pointer hover:scale-103 transition-transform"
            onclick="openReadingSample('corazon')"
          />
        </div>
        <div class="space-y-3 text-center sm:text-left flex-1">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-[#B8860B] text-white text-[10px] font-title font-bold uppercase tracking-wider">
              Presentación 2026
            </span>
            <span class="text-xs font-mono text-[#777777]">Casa Cacao y Chocolate</span>
          </div>
          <h3 class="text-2xl font-title font-black text-[#222222]">A corazón abierto</h3>
          <p class="text-xs text-[#B8860B] font-title font-bold">María de los Ángeles Cervantes Rosas</p>
          <p class="text-xs sm:text-sm font-sans text-[#555555] leading-relaxed">
            Obra testimonial y vivencial presentada formalmente en la Casa Universitaria Cacao y Chocolate en mayo de 2026, con prólogo e integración gremial de LVT.
          </p>
          <div class="pt-2">
            <button 
              type="button" 
              onclick="openReadingSample('corazon')"
              class="px-5 py-2 rounded-lg bg-[#222222] hover:bg-[#B8860B] text-white font-title text-xs font-bold uppercase tracking-wider transition shadow-sm"
            >
              Leer Muestra
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- Filtros por Género del Acervo Editorial -->
    <div class="flex justify-center mb-10">
      <div class="inline-flex flex-wrap justify-center p-1.5 rounded-2xl bg-[#F5EFE6] border border-[#E6DCCE] shadow-subtle gap-1.5 max-w-full">
        <button type="button" class="pub-filter active px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-[#EF7B38] text-white shadow-sm transition" data-filter="all">Todos los Títulos ({CATALOGO_EDITORIAL.length})</button>
        <button type="button" class="pub-filter px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider text-[#222222] hover:text-[#EF7B38] transition" data-filter="Narrativa">Narrativa</button>
        <button type="button" class="pub-filter px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider text-[#222222] hover:text-[#EF7B38] transition" data-filter="Poesía">Poesía</button>
        <button type="button" class="pub-filter px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider text-[#222222] hover:text-[#EF7B38] transition" data-filter="Ensayo">Ensayo</button>
        <button type="button" class="pub-filter px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider text-[#222222] hover:text-[#EF7B38] transition" data-filter="Multigénero">Antologías</button>
        <button type="button" class="pub-filter px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider text-[#222222] hover:text-[#EF7B38] transition" data-filter="Revista">Revista Letra Voz</button>
      </div>
    </div>

    <!-- Rejilla de Libros Históricos -->
    <div id="books-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {CATALOGO_EDITORIAL.map((libro) => (
        <div class="book-card bg-[#FDFBF7] p-6 rounded-2xl border border-[#E6DCCE] shadow-subtle flex flex-col justify-between hover:border-[#EF7B38] hover:shadow-elevated transition-all" data-genero={libro.genero}>
          <div class="space-y-3">
            <div class="flex justify-between items-start">
              <span class="px-2.5 py-1 rounded-md bg-[#F5EFE6] text-[#222222] text-[10px] font-title font-bold uppercase tracking-wider">
                {libro.anio} · {libro.genero}
              </span>
              <span class="text-[10px] font-mono text-[#EF7B38] font-bold">
                {libro.fondo}
              </span>
            </div>

            <div>
              <h4 class="text-lg font-title font-bold text-[#222222] leading-snug">{libro.titulo}</h4>
              {libro.subtitulo && <div class="text-xs font-serif italic text-[#777777] mt-0.5">{libro.subtitulo}</div>}
            </div>

            <p class="text-xs font-medium text-[#EF7B38]">{libro.autores}</p>
            <p class="text-xs font-sans text-[#555555] leading-relaxed line-clamp-3">{libro.sinopsis}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#E6DCCE] flex justify-between items-center text-xs">
            <span class="text-[#777777] font-mono text-[11px]">{libro.coeditores.split('/')[0]}</span>
            <a 
              href={`https://wa.me/522205889391?text=Hola%20Mesa%20Directiva,%20deseo%20consultar%20la%20disponibilidad%20del%20libro:%20${encodeURIComponent(libro.titulo)}`}
              target="_blank"
              rel="noopener"
              class="text-xs font-title font-bold uppercase text-[#EF7B38] hover:text-[#D96620] transition-colors"
            >
              Consultar →
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Filtros de Publicaciones
  const filters = document.querySelectorAll('.pub-filter');
  const cards = document.querySelectorAll('.book-card');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => {
        b.classList.remove('bg-[#EF7B38]', 'text-white', 'shadow-sm');
        b.classList.add('text-[#222222]');
      });
      btn.classList.remove('text-[#222222]');
      btn.classList.add('bg-[#EF7B38]', 'text-white', 'shadow-sm');

      const filterVal = btn.getAttribute('data-filter');

      cards.forEach(card => {
        const genero = card.getAttribute('data-genero');
        if (filterVal === 'all' || genero === filterVal) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
