---
// RifaInteractiva.astro - Sistema Interactivo Pro-Fondos LVT conectado con Notion
import boletosData from '../data/boletos_rifa.json';

const precioBoleto = boletosData.precio_boleto || 100;
const totalBoletos = 100;
const boletosOcupados = boletosData.boletos_ocupados || {};

// Generación de la lista 00 - 99 con estatus sincronizado
const listaBoletos = Array.from({ length: totalBoletos }, (_, i) => {
  const numStr = i.toString().padStart(2, '0');
  const ocupadoInfo = boletosOcupados[numStr];
  const estaOcupado = !!ocupadoInfo;
  const estado = estaOcupado ? ocupadoInfo.estado : 'Disponible';
  return {
    numero: numStr,
    ocupado: estaOcupado,
    estado: estado, // 'Disponible', 'Apartado', 'Pagado'
    participante: estaOcupado ? ocupadoInfo.participante || 'Reservado' : null
  };
});

const totalOcupados = listaBoletos.filter(b => b.ocupado).length;
const totalDisponibles = totalBoletos - totalOcupados;
const porcentajeProgreso = Math.round((totalOcupados / totalBoletos) * 100);
---

<section id="rifa" class="py-14 sm:py-16 bg-editorial-warm/50 border-t border-editorial-border relative overflow-hidden">
  <!-- Fondo decorativo sutil -->
  <div class="absolute inset-0 bg-[radial-gradient(#EF7B38_1px,transparent_1px)] [background-size:32px_32px] opacity-5 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-terracota/10 border border-terracota/30 text-terracota text-[10px] sm:text-xs font-semibold uppercase tracking-wider mb-3">
        <span class="w-2 h-2 rounded-full bg-terracota animate-ping"></span>
        <span>Iniciativa Pro-Fondos A.C. • Sincronizada con Notion</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-title font-bold text-carbon mb-4 tracking-tight">
        Gran Rifa Cultural de las Letras Tabasqueñas
      </h2>
      <p class="font-serif italic text-lg text-gray-600 leading-relaxed mb-6">
        «Cada boleto adquirido financia directamente la impresión de nuevas antologías y el fortalecimiento de los talleres literarios en los municipios de Tabasco».
      </p>

      <!-- Tarjeta de Premio y Transparencia -->
      <div class="bg-white border border-editorial-border rounded-2xl p-6 shadow-subtle text-left grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="md:col-span-2 space-y-2">
          <span class="text-xs font-bold text-dorado uppercase tracking-wider">Gran Premio Conmemorativo</span>
          <h3 class="text-lg font-title font-bold text-carbon">
            {boletosData.premio_principal}
          </h3>
          <p class="text-xs text-gray-500 leading-relaxed">
            Incluye ejemplares de lujo de <em>Animalia literaria</em>, <em>Tardes de ópalos y topacios</em>, <em>A corazón abierto</em> y pase de honor a los recitales de gala.
          </p>
        </div>
        <div class="flex flex-col justify-center items-start md:items-end border-t md:border-t-0 md:border-l border-editorial-border pt-4 md:pt-0 md:pl-6 space-y-1">
          <span class="text-xs text-gray-500 font-medium">Aportación por Boleto</span>
          <span class="text-3xl font-title font-bold text-terracota">${precioBoleto} <span class="text-sm font-sans text-gray-600 font-normal">MXN</span></span>
          <span class="text-[11px] text-gray-400">Sincronizado con Notion</span>
        </div>
      </div>

      <!-- Barra de Progreso y Estadísticas en Vivo -->
      <div class="bg-white/80 backdrop-blur-sm border border-editorial-border/80 rounded-xl p-4 shadow-sm max-w-2xl mx-auto">
        <div class="flex justify-between items-center text-xs font-medium text-gray-700 mb-2">
          <span class="flex items-center gap-1.5 font-title">
            <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
            <strong>{totalDisponibles}</strong> Disponibles
          </span>
          <span class="flex items-center gap-1.5 font-title">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
            <strong>{totalOcupados}</strong> Asignados / Apartados
          </span>
          <span class="font-bold text-terracota font-title">{porcentajeProgreso}% de la Meta</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2.5 overflow-hidden">
          <div class="bg-gradient-to-r from-terracota to-dorado h-2.5 rounded-full transition-all duration-500" style={`width: ${porcentajeProgreso}%`}></div>
        </div>
      </div>
    </div>

    <!-- Leyenda de Estados -->
    <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-6 text-xs text-gray-600 mb-8 select-none">
      <div class="flex items-center gap-2">
        <span class="w-5 h-5 rounded-lg bg-white border-2 border-editorial-border flex items-center justify-center font-bold text-[10px] text-carbon">02</span>
        <span>Disponible (Clic para elegir)</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-5 h-5 rounded-lg bg-amber-100 border-2 border-amber-300 flex items-center justify-center font-bold text-[10px] text-amber-800">05</span>
        <span>Apartado (En trámite)</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-5 h-5 rounded-lg bg-gray-200 border-2 border-gray-300 flex items-center justify-center font-bold text-[10px] text-gray-400 line-through">00</span>
        <span>Pagado / Vendido (Bloqueado)</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-5 h-5 rounded-lg bg-terracota border-2 border-terracota text-white flex items-center justify-center font-bold text-[10px]">99</span>
        <span>Tu Selección</span>
      </div>
    </div>

    <!-- Cuadrícula Interactiva 00 - 99 -->
    <div class="bg-white border border-editorial-border rounded-3xl p-4 sm:p-8 shadow-elevated mb-10 max-w-5xl mx-auto">
      <div class="grid grid-cols-5 sm:grid-cols-10 gap-2 sm:gap-3 justify-items-center" id="grid-boletos">
        {listaBoletos.map((boleto) => {
          if (boleto.estado === 'Pagado') {
            return (
              <button
                type="button"
                disabled
                class="w-full aspect-square max-w-[56px] rounded-xl bg-gray-100 border border-gray-300 text-gray-400 font-title font-bold text-sm sm:text-base flex flex-col items-center justify-center cursor-not-allowed select-none opacity-60 shadow-inner relative group"
                title={`Boleto ${boleto.numero} - PAGADO Y VENDIDO`}
                data-num={boleto.numero}
                data-status="pagado"
              >
                <span class="line-through">{boleto.numero}</span>
                <span class="text-[8px] uppercase tracking-tighter text-gray-400 font-sans font-normal">Vendido</span>
              </button>
            );
          } else if (boleto.estado === 'Apartado') {
            return (
              <button
                type="button"
                disabled
                class="w-full aspect-square max-w-[56px] rounded-xl bg-amber-50 border-2 border-amber-300 text-amber-800 font-title font-bold text-sm sm:text-base flex flex-col items-center justify-center cursor-not-allowed select-none opacity-80 shadow-inner relative group"
                title={`Boleto ${boleto.numero} - APARTADO EN PROCESO`}
                data-num={boleto.numero}
                data-status="apartado"
              >
                <span>{boleto.numero}</span>
                <span class="text-[8px] uppercase tracking-tighter text-amber-700 font-sans font-normal">Apartado</span>
              </button>
            );
          } else {
            return (
              <button
                type="button"
                class="num-btn w-full aspect-square max-w-[56px] rounded-xl bg-editorial border-2 border-editorial-border hover:border-terracota hover:bg-terracota-light text-carbon font-title font-bold text-sm sm:text-base flex items-center justify-center cursor-pointer select-none transition-all duration-200 shadow-sm"
                data-num={boleto.numero}
                data-status="disponible"
                aria-label={`Seleccionar boleto número ${boleto.numero}`}
              >
                {boleto.numero}
              </button>
            );
          }
        })}
      </div>
    </div>

    <!-- Panel Flotante de Confirmación y Apartado -->
    <div class="max-w-2xl mx-auto bg-carbon text-editorial rounded-2xl p-6 sm:p-8 shadow-2xl border border-carbon-border">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-gray-800">
        <div>
          <span class="text-xs text-terracota font-bold uppercase tracking-wider block mb-1">Resumen de Apartado</span>
          <h4 class="text-xl font-title font-bold text-white">Boletos Seleccionados</h4>
        </div>
        <div class="text-left sm:text-right">
          <span class="text-xs text-gray-400 block">Total a Aportar</span>
          <span class="text-2xl font-title font-bold text-terracota" id="total-aportacion">$0 MXN</span>
        </div>
      </div>

      <div class="py-4">
        <p class="text-xs text-gray-400 mb-2">Números elegidos en esta sesión:</p>
        <div id="contenedor-seleccionados" class="flex flex-wrap gap-2 min-h-[2.5rem] items-center">
          <span class="text-xs text-gray-500 italic" id="texto-vacio">Haz clic en los números disponibles arriba para seleccionarlos...</span>
        </div>
      </div>

      <div class="pt-4 flex flex-col sm:flex-row gap-3">
        <a
          id="btn-apartar-whatsapp"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#25D366] hover:bg-[#128C7E] text-white font-title font-bold text-sm transition-all shadow-md opacity-50 pointer-events-none cursor-not-allowed"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.53 1.961.815 2.796.815 3.183 0 5.769-2.586 5.77-5.766.001-3.182-2.585-5.768-5.77-5.768zm0 10.455c-.779 0-1.695-.258-2.382-.665l-.171-.101-1.77.464.472-1.726-.112-.178c-.464-.737-.709-1.532-.708-2.483.001-2.585 2.103-4.688 4.671-4.688 2.569 0 4.671 2.103 4.671 4.688 0 2.586-2.102 4.689-4.671 4.689z"/>
          </svg>
          <span>Apartar Boletos por WhatsApp</span>
        </a>
        <button
          type="button"
          id="btn-limpiar-seleccion"
          class="px-4 py-3.5 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-300 text-xs font-semibold transition-colors"
        >
          Limpiar
        </button>
      </div>

      <div class="mt-4 text-[11px] text-gray-400 text-center leading-relaxed">
        🔒 <em>Los números se registran en la base de datos oficial en Notion. Tras enviar tu solicitud por WhatsApp, recibirás la confirmación y tu ficha digital de participación.</em>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ precioBoleto }}>
  document.addEventListener('DOMContentLoaded', () => {
    let seleccionados = [];
    const contenedorSeleccionados = document.getElementById('contenedor-seleccionados');
    const textoVacio = document.getElementById('texto-vacio');
    const totalAportacionEl = document.getElementById('total-aportacion');
    const btnWhatsApp = document.getElementById('btn-apartar-whatsapp');
    const btnLimpiar = document.getElementById('btn-limpiar-seleccion');
    const botones = document.querySelectorAll('.num-btn[data-status="disponible"]');

    function actualizarInterfaz() {
      // Limpiar contenedor
      contenedorSeleccionados.innerHTML = '';

      if (seleccionados.length === 0) {
        contenedorSeleccionados.appendChild(textoVacio);
        totalAportacionEl.textContent = '$0 MXN';
        btnWhatsApp.classList.add('opacity-50', 'pointer-events-none', 'cursor-not-allowed');
        btnWhatsApp.href = '#';
        return;
      }

      // Renderizar badges seleccionados
      seleccionados.sort((a, b) => parseInt(a) - parseInt(b)).forEach(num => {
        const badge = document.createElement('span');
        badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-terracota text-white font-title font-bold text-xs shadow-sm';
        badge.innerHTML = `Boleto <strong>${num}</strong> <button type="button" data-quitar="${num}" class="ml-1 text-white/80 hover:text-white font-normal">✕</button>`;
        contenedorSeleccionados.appendChild(badge);
      });

      // Calcular total
      const total = seleccionados.length * precioBoleto;
      totalAportacionEl.textContent = `$${total} MXN`;

      // Actualizar enlace WhatsApp
      const numerosTexto = seleccionados.join(', ');
      const mensaje = `Hola, me comunico desde el portal oficial de Letras y Voces de Tabasco, A.C. Deseo apartar el/los boleto(s) número: [${numerosTexto}] para la Gran Rifa Cultural Pro-Fondos 2026. Aportación total: $${total} MXN.`;
      const urlWA = `https://wa.me/529932647502?text=${encodeURIComponent(mensaje)}`;
      
      btnWhatsApp.href = urlWA;
      btnWhatsApp.classList.remove('opacity-50', 'pointer-events-none', 'cursor-not-allowed');
    }

    // Manejar selección de números
    botones.forEach(btn => {
      btn.addEventListener('click', () => {
        const num = btn.getAttribute('data-num');
        if (!num) return;

        if (seleccionados.includes(num)) {
          seleccionados = seleccionados.filter(n => n !== num);
          btn.classList.remove('selected');
        } else {
          seleccionados.push(num);
          btn.classList.add('selected');
        }
        actualizarInterfaz();
      });
    });

    // Eliminar desde badge
    contenedorSeleccionados.addEventListener('click', (e) => {
      const target = e.target;
      if (target && target.getAttribute('data-quitar')) {
        const num = target.getAttribute('data-quitar');
        seleccionados = seleccionados.filter(n => n !== num);
        const btn = document.querySelector(`.num-btn[data-num="${num}"]`);
        if (btn) btn.classList.remove('selected');
        actualizarInterfaz();
      }
    });

    // Limpiar selección
    if (btnLimpiar) {
      btnLimpiar.addEventListener('click', () => {
        seleccionados = [];
        document.querySelectorAll('.num-btn.selected').forEach(btn => btn.classList.remove('selected'));
        actualizarInterfaz();
      });
    }
  });
</script>
