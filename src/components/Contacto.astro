---
// Contacto.astro - Secretaría General, Vinculación, Correspondencia Oficial y Atención Directa
---

<section id="contacto" class="py-16 sm:py-20 bg-[#FDFBF7] border-b border-[#E6DCCE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-[11px] font-title font-bold text-[#EF7B38] uppercase tracking-widest block mb-2">Canal Oficial de Correspondencia & Atención</span>
      <h2 class="font-title text-3xl sm:text-4xl lg:text-5xl font-black text-[#222222]">Secretaría General & Contacto</h2>
      <p class="text-sm sm:text-base text-gray-600 mt-2 font-serif italic">
        Buzón institucional oficial: <a href="mailto:contacto@letrasyvocesdetabasco.org" class="text-[#EF7B38] font-bold hover:underline">contacto@letrasyvocesdetabasco.org</a>
      </p>
      <div class="w-20 h-0.5 bg-[#EF7B38] mx-auto mt-4 rounded-full"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12">
      
      <!-- Formulario Directo -->
      <div class="bg-white p-7 sm:p-10 rounded-3xl border border-[#E6DCCE] shadow-subtle">
        <h3 class="font-title text-2xl font-bold text-[#222222] mb-6">Envío de Mensaje Directo</h3>
        
        <form id="contact-form" class="space-y-4">
          <div>
            <label for="nombre" class="block text-[11px] font-title font-bold uppercase tracking-wider text-gray-600 mb-1.5">Nombre Completo *</label>
            <input 
              type="text" 
              id="nombre" 
              name="nombre" 
              required 
              placeholder="Ej. Mario Cruz Hernández" 
              class="w-full px-4 py-3 rounded-2xl border border-[#E6DCCE] focus:outline-none focus:border-[#EF7B38] focus:ring-1 focus:ring-[#EF7B38] bg-[#FDFBF7] text-sm text-[#222222]"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="telefono" class="block text-[11px] font-title font-bold uppercase tracking-wider text-gray-600 mb-1.5">Teléfono / WhatsApp *</label>
              <input 
                type="tel" 
                id="telefono" 
                name="telefono" 
                required 
                placeholder="Ej. 993 123 4567" 
                class="w-full px-4 py-3 rounded-2xl border border-[#E6DCCE] focus:outline-none focus:border-[#EF7B38] focus:ring-1 focus:ring-[#EF7B38] bg-[#FDFBF7] text-sm text-[#222222]"
              />
            </div>

            <div>
              <label for="correo" class="block text-[11px] font-title font-bold uppercase tracking-wider text-gray-600 mb-1.5">Correo Electrónico *</label>
              <input 
                type="email" 
                id="correo" 
                name="correo" 
                required 
                placeholder="correo@ejemplo.com" 
                class="w-full px-4 py-3 rounded-2xl border border-[#E6DCCE] focus:outline-none focus:border-[#EF7B38] focus:ring-1 focus:ring-[#EF7B38] bg-[#FDFBF7] text-sm text-[#222222]"
              />
            </div>
          </div>

          <div>
            <label for="asunto" class="block text-[11px] font-title font-bold uppercase tracking-wider text-gray-600 mb-1.5">Destino / Asunto de Interés *</label>
            <select 
              id="asunto" 
              name="asunto" 
              class="w-full px-4 py-3 rounded-2xl border border-[#E6DCCE] focus:outline-none focus:border-[#EF7B38] focus:ring-1 focus:ring-[#EF7B38] bg-[#FDFBF7] text-sm text-[#222222]"
            >
              <option value="secretaria@letrasyvocesdetabasco.org">Secretaría General (secretaria@letrasyvocesdetabasco.org)</option>
              <option value="presidencia@letrasyvocesdetabasco.org">Presidencia (presidencia@letrasyvocesdetabasco.org)</option>
              <option value="contacto@letrasyvocesdetabasco.org">Informes Generales & Convocatorias (contacto@letrasyvocesdetabasco.org)</option>
              <option value="contacto@letrasyvocesdetabasco.org">Fondo Editorial & Ejemplares</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="block text-[11px] font-title font-bold uppercase tracking-wider text-gray-600 mb-1.5">Mensaje *</label>
            <textarea 
              id="mensaje" 
              name="mensaje" 
              rows="4" 
              required 
              placeholder="Escriba aquí su mensaje..." 
              class="w-full px-4 py-3 rounded-2xl border border-[#E6DCCE] focus:outline-none focus:border-[#EF7B38] focus:ring-1 focus:ring-[#EF7B38] bg-[#FDFBF7] text-sm text-[#222222]"
            ></textarea>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row gap-3">
            <button 
              type="submit" 
              id="btn-enviar-email"
              class="flex-1 py-3.5 px-4 rounded-2xl bg-[#EF7B38] text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-[#D96620] shadow-subtle hover:shadow-elevated active:scale-95 transition duration-200 cursor-pointer text-center"
            >
              ✉️ Enviar por Correo
            </button>

            <button 
              type="button" 
              id="btn-enviar-wa"
              class="flex-1 py-3.5 px-4 rounded-2xl bg-[#25D366] text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-[#128C7E] shadow-subtle hover:shadow-elevated active:scale-95 transition duration-200 cursor-pointer flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.53 1.961.815 2.796.815 3.183 0 5.769-2.586 5.77-5.766.001-3.182-2.585-5.768-5.77-5.768zm0 10.455c-.779 0-1.695-.258-2.382-.665l-.171-.101-1.77.464.472-1.726-.112-.178c-.464-.737-.709-1.532-.708-2.483.001-2.585 2.103-4.688 4.671-4.688 2.569 0 4.671 2.103 4.671 4.688 0 2.586-2.102 4.689-4.671 4.689z"/>
              </svg>
              <span>Enviar por WhatsApp</span>
            </button>
          </div>
        </form>

        <div id="form-success" class="hidden mt-4 p-4 rounded-2xl bg-green-50 border border-green-200 text-green-900 text-xs text-center font-medium">
          ¡Gracias por comunicarse! Su mensaje ha sido enviado exitosamente. Nos pondremos en contacto con usted a la brevedad.
        </div>
      </div>

      <!-- Datos Legales, Correos Oficiales y Atención -->
      <div class="space-y-6 flex flex-col justify-between">
        
        <!-- Correos Oficiales LVT -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#E6DCCE] shadow-subtle space-y-4">
          <h4 class="font-title text-xl font-bold text-[#222222]">Buzones Oficiales de Correspondencia</h4>
          
          <div class="space-y-3 text-xs">
            <div class="p-3.5 rounded-2xl bg-[#FDFBF7] border border-[#E6DCCE] flex items-center justify-between">
              <div>
                <span class="block font-title font-bold text-[#222222] text-[11px] uppercase">Presidencia LVT</span>
                <a href="mailto:presidencia@letrasyvocesdetabasco.org" class="text-[#EF7B38] font-semibold hover:underline">presidencia@letrasyvocesdetabasco.org</a>
              </div>
              <span class="text-[10px] text-gray-400 font-mono">Oficial</span>
            </div>

            <div class="p-3.5 rounded-2xl bg-[#FDFBF7] border border-[#E6DCCE] flex items-center justify-between">
              <div>
                <span class="block font-title font-bold text-[#222222] text-[11px] uppercase">Secretaría General</span>
                <a href="mailto:secretaria@letrasyvocesdetabasco.org" class="text-[#EF7B38] font-semibold hover:underline">secretaria@letrasyvocesdetabasco.org</a>
              </div>
              <span class="text-[10px] text-gray-400 font-mono">Oficial</span>
            </div>

            <div class="p-3.5 rounded-2xl bg-[#FDFBF7] border border-[#E6DCCE] flex items-center justify-between">
              <div>
                <span class="block font-title font-bold text-[#222222] text-[11px] uppercase">Contacto General</span>
                <a href="mailto:contacto@letrasyvocesdetabasco.org" class="text-[#EF7B38] font-semibold hover:underline">contacto@letrasyvocesdetabasco.org</a>
              </div>
              <span class="text-[10px] text-gray-400 font-mono">Oficial</span>
            </div>
          </div>
        </div>

        <!-- Datos Institucionales -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#E6DCCE] shadow-subtle space-y-4">
          <h4 class="font-title text-xl font-bold text-[#222222]">Datos Institucionales & WhatsApp</h4>
          
          <div class="space-y-3 text-xs text-gray-600">
            <div>
              <strong class="block font-title uppercase tracking-wider text-[10px] text-gray-500">Razón Social:</strong>
              Sociedad de Escritores Letras y Voces de Tabasco, A.C.
            </div>
            <div>
              <strong class="block font-title uppercase tracking-wider text-[10px] text-gray-500">Sede Principal:</strong>
              Villahermosa, Tabasco, México.
            </div>
            <div>
              <strong class="block font-title uppercase tracking-wider text-[10px] text-gray-500">Línea Oficial WhatsApp LVT:</strong>
              <a href="https://wa.me/522205889391" target="_blank" rel="noopener noreferrer" class="text-[#EF7B38] font-bold hover:underline">+52 220 588 9391</a>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btnWa = document.getElementById('btn-enviar-wa');
  const successBox = document.getElementById('form-success');

  function getFormData() {
    const nombre = (document.getElementById('nombre') as HTMLInputElement)?.value.trim() || '';
    const telefono = (document.getElementById('telefono') as HTMLInputElement)?.value.trim() || '';
    const correo = (document.getElementById('correo') as HTMLInputElement)?.value.trim() || '';
    const asuntoSelect = document.getElementById('asunto') as HTMLSelectElement | null;
    const targetEmail = asuntoSelect?.value || 'contacto@letrasyvocesdetabasco.org';
    const asuntoText = asuntoSelect?.options[asuntoSelect.selectedIndex]?.text || 'Contacto General';
    const mensaje = (document.getElementById('mensaje') as HTMLTextAreaElement)?.value.trim() || '';
    return { nombre, telefono, correo, targetEmail, asuntoText, mensaje };
  }

  // 1. Envío por Correo Electrónico
  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const { nombre, telefono, correo, targetEmail, asuntoText, mensaje } = getFormData();

      if (!nombre || !correo || !telefono || !mensaje) {
        alert('Por favor, complete todos los campos obligatorios, incluyendo su teléfono de contacto.');
        return;
      }

      const subject = encodeURIComponent(`[LVT Portal] ${asuntoText} - ${nombre}`);
      const body = encodeURIComponent(`Nombre: ${nombre}\nTeléfono / WhatsApp de Contacto: ${telefono}\nCorreo: ${correo}\nAsunto: ${asuntoText}\n\nMensaje:\n${mensaje}`);
      
      window.location.href = `mailto:${targetEmail}?subject=${subject}&body=${body}`;
      
      successBox.classList.remove('hidden');
      form.reset();
    });
  }

  // 2. Envío Directo por WhatsApp
  if (btnWa) {
    btnWa.addEventListener('click', () => {
      const { nombre, telefono, correo, asuntoText, mensaje } = getFormData();

      if (!nombre || !telefono || !mensaje) {
        alert('Por favor, ingrese al menos su Nombre, Teléfono y Mensaje para enviar por WhatsApp.');
        return;
      }

      const waMsg = `Hola Sociedad de Escritores LVT, A.C.\n\nMi nombre es: ${nombre}\nTeléfono de contacto: ${telefono}\nCorreo: ${correo || 'No especificado'}\nAsunto: ${asuntoText}\n\nMensaje:\n${mensaje}`;
      const url = `https://wa.me/522205889391?text=${encodeURIComponent(waMsg)}`;
      
      window.open(url, '_blank');
      if (successBox) successBox.classList.remove('hidden');
    });
  }
</script>
