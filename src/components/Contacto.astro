---
// Contacto.astro - Secretaría General, Vinculación, Correspondencia Oficial y Datos Bancarios
---

<section id="contacto" class="py-16 sm:py-20 bg-paper border-b border-paper-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-[11px] font-swiss font-bold text-cacao uppercase tracking-widest block mb-2">Canal Oficial de Correspondencia</span>
      <h2 class="font-monograph text-3xl sm:text-4xl lg:text-5xl font-normal text-ink">Secretaría General & Vinculación</h2>
      <p class="text-sm sm:text-base text-ink-muted mt-2 font-serif italic">
        Buzón institucional oficial: <a href="mailto:contacto@letrasyvocesdetabasco.org" class="text-cacao font-bold hover:underline">contacto@letrasyvocesdetabasco.org</a>
      </p>
      <div class="french-rule max-w-xs mx-auto"><span>⁂</span></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12">
      
      <!-- Formulario Directo -->
      <div class="bg-paper-card p-7 sm:p-10 rounded-3xl border border-paper-border shadow-subtle">
        <h3 class="font-monograph text-2xl font-bold text-ink mb-6">Envío de Mensaje Directo</h3>
        
        <form id="contact-form" class="space-y-4">
          <div>
            <label for="nombre" class="block text-[11px] font-swiss font-bold uppercase tracking-wider text-ink-muted mb-1.5">Nombre Completo *</label>
            <input 
              type="text" 
              id="nombre" 
              name="nombre" 
              required 
              placeholder="Ej. Dr. Mario Cruz" 
              class="w-full px-4 py-3 rounded-2xl border border-paper-border focus:outline-none focus:border-cacao focus:ring-1 focus:ring-cacao bg-paper text-sm text-ink"
            />
          </div>

          <div>
            <label for="correo" class="block text-[11px] font-swiss font-bold uppercase tracking-wider text-ink-muted mb-1.5">Correo Electrónico *</label>
            <input 
              type="email" 
              id="correo" 
              name="correo" 
              required 
              placeholder="correo@ejemplo.com" 
              class="w-full px-4 py-3 rounded-2xl border border-paper-border focus:outline-none focus:border-cacao focus:ring-1 focus:ring-cacao bg-paper text-sm text-ink"
            />
          </div>

          <div>
            <label for="asunto" class="block text-[11px] font-swiss font-bold uppercase tracking-wider text-ink-muted mb-1.5">Destino / Asunto de Interés *</label>
            <select 
              id="asunto" 
              name="asunto" 
              class="w-full px-4 py-3 rounded-2xl border border-paper-border focus:outline-none focus:border-cacao focus:ring-1 focus:ring-cacao bg-paper text-sm text-ink"
            >
              <option value="secretaria@letrasyvocesdetabasco.org">Secretaría General (secretaria@letrasyvocesdetabasco.org)</option>
              <option value="presidencia@letrasyvocesdetabasco.org">Presidencia (presidencia@letrasyvocesdetabasco.org)</option>
              <option value="contacto@letrasyvocesdetabasco.org">Informes Generales & Convocatorias (contacto@letrasyvocesdetabasco.org)</option>
              <option value="contacto@letrasyvocesdetabasco.org">Fondo Editorial & Ejemplares</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="block text-[11px] font-swiss font-bold uppercase tracking-wider text-ink-muted mb-1.5">Mensaje *</label>
            <textarea 
              id="mensaje" 
              name="mensaje" 
              rows="4" 
              required 
              placeholder="Escriba aquí su mensaje..." 
              class="w-full px-4 py-3 rounded-2xl border border-paper-border focus:outline-none focus:border-cacao focus:ring-1 focus:ring-cacao bg-paper text-sm text-ink"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="touch-target-48 w-full py-3.5 rounded-2xl bg-cacao text-white font-swiss text-xs font-bold uppercase tracking-wider hover:bg-cacao-dark shadow-subtle hover:shadow-elevated active:scale-95 transition duration-200"
          >
            Enviar Mensaje Institucional
          </button>
        </form>

        <div id="form-success" class="hidden mt-4 p-4 rounded-2xl bg-green-50 border border-green-200 text-green-900 text-xs text-center font-medium">
          ¡Gracias por comunicarse! Su mensaje ha sido preparado para la Secretaría General (<a href="mailto:secretaria@letrasyvocesdetabasco.org" class="underline font-bold">secretaria@letrasyvocesdetabasco.org</a>).
        </div>
      </div>

      <!-- Datos Legales, Correos Oficiales y Seguridad Bancaria -->
      <div class="space-y-6 flex flex-col justify-between">
        
        <!-- Correos Oficiales LVT -->
        <div class="bg-paper-card p-6 sm:p-8 rounded-3xl border border-paper-border shadow-subtle space-y-4">
          <h4 class="font-monograph text-xl font-bold text-ink">Buzones Oficiales de Correspondencia</h4>
          
          <div class="space-y-3 text-xs">
            <div class="p-3.5 rounded-2xl bg-paper-warm border border-paper-border flex items-center justify-between">
              <div>
                <span class="block font-swiss font-bold text-ink text-[11px] uppercase">Presidencia LVT</span>
                <a href="mailto:presidencia@letrasyvocesdetabasco.org" class="text-cacao font-semibold hover:underline">presidencia@letrasyvocesdetabasco.org</a>
              </div>
              <span class="text-[10px] text-ink-faint font-mono">Oficial</span>
            </div>

            <div class="p-3.5 rounded-2xl bg-paper-warm border border-paper-border flex items-center justify-between">
              <div>
                <span class="block font-swiss font-bold text-ink text-[11px] uppercase">Secretaría General</span>
                <a href="mailto:secretaria@letrasyvocesdetabasco.org" class="text-cacao font-semibold hover:underline">secretaria@letrasyvocesdetabasco.org</a>
              </div>
              <span class="text-[10px] text-ink-faint font-mono">Oficial</span>
            </div>

            <div class="p-3.5 rounded-2xl bg-paper-warm border border-paper-border flex items-center justify-between">
              <div>
                <span class="block font-swiss font-bold text-ink text-[11px] uppercase">Contacto General</span>
                <a href="mailto:contacto@letrasyvocesdetabasco.org" class="text-cacao font-semibold hover:underline">contacto@letrasyvocesdetabasco.org</a>
              </div>
              <span class="text-[10px] text-ink-faint font-mono">Oficial</span>
            </div>
          </div>
        </div>

        <!-- Datos Institucionales -->
        <div class="bg-paper-card p-6 sm:p-8 rounded-3xl border border-paper-border shadow-subtle space-y-4">
          <h4 class="font-monograph text-xl font-bold text-ink">Datos Institucionales & WhatsApp</h4>
          
          <div class="space-y-3 text-xs text-ink-muted">
            <div>
              <strong class="block font-swiss uppercase tracking-wider text-[10px] text-ink-faint">Razón Social:</strong>
              Sociedad de Escritores Letras y Voces de Tabasco, A.C.
            </div>
            <div>
              <strong class="block font-swiss uppercase tracking-wider text-[10px] text-ink-faint">Sede Principal:</strong>
              Villahermosa, Tabasco, México.
            </div>
            <div>
              <strong class="block font-swiss uppercase tracking-wider text-[10px] text-ink-faint">Línea Oficial WhatsApp LVT:</strong>
              <a href="https://wa.me/522205889391" target="_blank" rel="noopener noreferrer" class="text-cacao font-bold hover:underline">+52 220 588 9391</a>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');

  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const nombre = (document.getElementById('nombre') as HTMLInputElement).value;
      const correo = (document.getElementById('correo') as HTMLInputElement).value;
      const asuntoSelect = (document.getElementById('asunto') as HTMLSelectElement);
      const targetEmail = asuntoSelect.value || 'contacto@letrasyvocesdetabasco.org';
      const asuntoText = asuntoSelect.options[asuntoSelect.selectedIndex].text;
      const mensaje = (document.getElementById('mensaje') as HTMLTextAreaElement).value;

      const subject = encodeURIComponent(`[LVT Portal] ${asuntoText} - ${nombre}`);
      const body = encodeURIComponent(`Nombre: ${nombre}\nCorreo de contacto: ${correo}\nAsunto: ${asuntoText}\n\nMensaje:\n${mensaje}`);
      
      window.location.href = `mailto:${targetEmail}?subject=${subject}&body=${body}`;
      
      successBox.classList.remove('hidden');
      form.reset();
    });
  }
</script>
