---
// MesaDirectiva.astro - Gobernanza y Representación Legal Institucional con Retratos Editoriales
const basePath = "/letrasyvocesdetabasco";
---

<section id="directiva" class="py-24 bg-editorial border-b border-editorial-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-editorial-warm border border-editorial-border text-terracota font-title text-[10px] font-bold uppercase tracking-widest mb-3">
        <span>Gobernanza Institucional</span>
      </div>
      <h2 class="font-serif text-4xl sm:text-5xl font-bold text-carbon">Mesa Directiva Institucional</h2>
      <p class="text-sm text-gray-600 mt-2 font-light">
        Representación jurídica y directiva de la Sociedad de Escritores Letras y Voces de Tabasco, A.C.
      </p>
      <div class="w-16 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      
      <!-- Presidente -->
      <div class="bg-white rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1.5 transition duration-300 overflow-hidden flex flex-col group">
        <!-- Retrato Editorial Blanco y Negro -->
        <div class="relative overflow-hidden aspect-[4/5] bg-editorial-warm">
          <img 
            src={`${basePath}/assets/directiva/juan_david_perez_cabrera.jpg`} 
            alt="Lic. Juan David Pérez Cabrera - Presidente de Letras y Voces de Tabasco, A.C." 
            class="w-full h-full object-cover object-center grayscale contrast-115 group-hover:scale-103 transition duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/75 via-transparent to-transparent opacity-80 group-hover:opacity-90 transition"></div>
          <div class="absolute bottom-4 left-5 right-5 text-white">
            <span class="text-[10px] font-title font-bold uppercase tracking-widest text-dorado-light block mb-0.5">
              Presidencia & Representación Legal
            </span>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-white leading-tight">
              Lic. Juan David Pérez Cabrera
            </h3>
          </div>
        </div>

        <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Dirección general, representación legal, gestión de alianzas interinstitucionales con entidades de gobierno y vinculación estratégica del gremio literario.
          </p>
          <div class="pt-3 border-t border-editorial-border flex items-center justify-between text-[11px] font-title font-bold uppercase tracking-wider text-gray-500">
            <span>Periodo Directivo</span>
            <span class="text-terracota">2024 – 2027</span>
          </div>
        </div>
      </div>

      <!-- Secretaria -->
      <div class="bg-white rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1.5 transition duration-300 overflow-hidden flex flex-col group">
        <!-- Retrato Editorial Blanco y Negro -->
        <div class="relative overflow-hidden aspect-[4/5] bg-editorial-warm">
          <img 
            src={`${basePath}/assets/directiva/eva_guadalupe_pineda_cruz.jpg`} 
            alt="Mtra. Eva Guadalupe Pineda Cruz - Secretaria General de Letras y Voces de Tabasco, A.C." 
            class="w-full h-full object-cover object-center grayscale contrast-115 group-hover:scale-103 transition duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/75 via-transparent to-transparent opacity-80 group-hover:opacity-90 transition"></div>
          <div class="absolute bottom-4 left-5 right-5 text-white">
            <span class="text-[10px] font-title font-bold uppercase tracking-widest text-dorado-light block mb-0.5">
              Secretaría General
            </span>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-white leading-tight">
              Mtra. Eva Guadalupe Pineda Cruz
            </h3>
          </div>
        </div>

        <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Atención institucional, actas de asambleas generales, formalización de acuerdos colegiados y coordinación de correspondencia oficial con los socios.
          </p>
          <div class="pt-3 border-t border-editorial-border flex items-center justify-between text-[11px] font-title font-bold uppercase tracking-wider text-gray-500">
            <span>Periodo Directivo</span>
            <span class="text-terracota">2024 – 2027</span>
          </div>
        </div>
      </div>

      <!-- Tesorera -->
      <div class="bg-white rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1.5 transition duration-300 overflow-hidden flex flex-col group">
        <!-- Retrato Editorial Blanco y Negro -->
        <div class="relative overflow-hidden aspect-[4/5] bg-editorial-warm">
          <img 
            src={`${basePath}/assets/directiva/ana_laura_hernandez_jimenez.jpg`} 
            alt="Ana Laura Hernández Jiménez - Tesorera Institucional de Letras y Voces de Tabasco, A.C." 
            class="w-full h-full object-cover object-center grayscale contrast-115 group-hover:scale-103 transition duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/75 via-transparent to-transparent opacity-80 group-hover:opacity-90 transition"></div>
          <div class="absolute bottom-4 left-5 right-5 text-white">
            <span class="text-[10px] font-title font-bold uppercase tracking-widest text-dorado-light block mb-0.5">
              Tesorería Institucional
            </span>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-white leading-tight">
              Ana Laura Hernández Jiménez
            </h3>
          </div>
        </div>

        <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Administración financiera, control y transparencia de fondos editoriales, expedición de recibos y regularización de aportaciones voluntarias.
          </p>
          <div class="pt-3 border-t border-editorial-border flex items-center justify-between text-[11px] font-title font-bold uppercase tracking-wider text-gray-500">
            <span>Periodo Directivo</span>
            <span class="text-terracota">2024 – 2027</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
