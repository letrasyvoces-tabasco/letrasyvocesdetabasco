---
// MesaDirectiva.astro - Gobernanza, Comisión de Honor y Justicia y Membresía Activa (Gestión 2026 – 2029)
const basePath = "";
---

<section id="directiva" class="py-14 sm:py-16 bg-editorial border-b border-editorial-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-editorial-warm border border-editorial-border text-terracota font-title text-[10px] sm:text-[11px] font-bold uppercase tracking-widest mb-3 shadow-subtle">
        <span class="w-2 h-2 rounded-full bg-terracota"></span>
        <span>Gobernanza Institucional • Gestión 2026 – 2029</span>
      </div>
      <h2 class="font-title text-2xl sm:text-3xl lg:text-4xl font-black text-carbon">Mesa Directiva & Gobernanza</h2>
      <p class="text-xs sm:text-sm text-gray-600 mt-2 font-serif italic">
        Representación jurídica, ejecutiva y colegiada de la Sociedad de Escritores Letras y Voces de Tabasco, A.C.
      </p>
      <div class="w-20 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- 1. Mesa Directiva Institucional (Presidencia, Secretaría, Tesorería) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- 1. Presidente -->
      <div class="bg-white rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1.5 transition duration-300 overflow-hidden flex flex-col group">
        <div class="relative overflow-hidden aspect-[4/5] bg-editorial-warm">
          <img 
            src={`${basePath}/assets/directiva/juan_david_perez_cabrera.jpg`} 
            alt="Lic. Juan David Pérez Cabrera - Presidente de Letras y Voces de Tabasco, A.C." 
            class="w-full h-full object-cover object-center grayscale contrast-115 group-hover:scale-103 transition duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/85 via-carbon/20 to-transparent opacity-85 group-hover:opacity-95 transition"></div>
          <div class="absolute bottom-4 left-4 right-4 text-white">
            <span class="text-[9px] font-title font-bold uppercase tracking-widest text-dorado-light block mb-1">
              Presidencia & Representación Legal
            </span>
            <h3 class="font-serif text-lg sm:text-xl font-bold text-white leading-tight">
              Lic. Juan David Pérez Cabrera
            </h3>
          </div>
        </div>

        <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
          <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
            Dirección ejecutiva, representación jurídica, gestión de convenios interinstitucionales y vinculación estratégica del gremio literario.
          </p>
          <div class="pt-3 border-t border-editorial-border flex items-center justify-between text-[11px] font-title font-bold uppercase tracking-wider text-gray-500">
            <span>Periodo</span>
            <span class="text-terracota font-bold">2026 – 2029</span>
          </div>
        </div>
      </div>

      <!-- 2. Secretaria General -->
      <div class="bg-white rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1.5 transition duration-300 overflow-hidden flex flex-col group">
        <div class="relative overflow-hidden aspect-[4/5] bg-editorial-warm">
          <img 
            src={`${basePath}/assets/directiva/eva_guadalupe_pineda_cruz.jpg`} 
            alt="Mtra. Eva Guadalupe Pineda Cruz - Secretaria General de Letras y Voces de Tabasco, A.C." 
            class="w-full h-full object-cover object-center grayscale contrast-115 group-hover:scale-103 transition duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/85 via-carbon/20 to-transparent opacity-85 group-hover:opacity-95 transition"></div>
          <div class="absolute bottom-4 left-4 right-4 text-white">
            <span class="text-[9px] font-title font-bold uppercase tracking-widest text-dorado-light block mb-1">
              Secretaría General
            </span>
            <h3 class="font-serif text-lg sm:text-xl font-bold text-white leading-tight">
              Mtra. Eva Guadalupe Pineda Cruz
            </h3>
          </div>
        </div>

        <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
          <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
            Atención institucional, acuerdos colegiados en asamblea general, control de expedientes y coordinación de correspondencia oficial.
          </p>
          <div class="pt-3 border-t border-editorial-border flex items-center justify-between text-[11px] font-title font-bold uppercase tracking-wider text-gray-500">
            <span>Periodo</span>
            <span class="text-terracota font-bold">2026 – 2029</span>
          </div>
        </div>
      </div>

      <!-- 3. Tesorera -->
      <div class="bg-white rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1.5 transition duration-300 overflow-hidden flex flex-col group">
        <div class="relative overflow-hidden aspect-[4/5] bg-editorial-warm">
          <img 
            src={`${basePath}/assets/directiva/ana_laura_hernandez_jimenez.jpg`} 
            alt="Ana Laura Hernández Jiménez - Tesorera Institucional de Letras y Voces de Tabasco, A.C." 
            class="w-full h-full object-cover object-center grayscale contrast-115 group-hover:scale-103 transition duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/85 via-carbon/20 to-transparent opacity-85 group-hover:opacity-95 transition"></div>
          <div class="absolute bottom-4 left-4 right-4 text-white">
            <span class="text-[9px] font-title font-bold uppercase tracking-widest text-dorado-light block mb-1">
              Tesorería Institucional
            </span>
            <h3 class="font-serif text-lg sm:text-xl font-bold text-white leading-tight">
              Ana Laura Hernández Jiménez
            </h3>
          </div>
        </div>

        <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
          <p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed">
            Administración financiera, control y transparencia de fondos editoriales, expedición de recibos y regularización de aportaciones voluntarias.
          </p>
          <div class="pt-3 border-t border-editorial-border flex items-center justify-between text-[11px] font-title font-bold uppercase tracking-wider text-gray-500">
            <span>Periodo</span>
            <span class="text-terracota font-bold">2026 – 2029</span>
          </div>
        </div>
      </div>

    </div>

    <!-- 2. Comisión de Honor y Justicia (Dra. Liliana Chuzeville & Mtra. Pragedis Hernández) -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-editorial-border shadow-subtle space-y-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-4 border-b border-editorial-border">
        <div>
          <span class="text-[10px] font-title font-bold text-terracota uppercase tracking-widest block mb-0.5">Órgano Colegiado de Vigilancia Estatutaria</span>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-carbon">Comisión de Honor y Justicia (2026–2029)</h3>
        </div>
        <span class="text-xs font-serif italic text-gray-500">Preservación ética y estatutaria del gremio</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Integrante 1: Dra. Liliana Chuzeville Córdoba -->
        <div class="p-5 rounded-2xl bg-editorial-warm border border-editorial-border flex items-start gap-4">
          <div class="w-16 h-16 rounded-2xl overflow-hidden bg-white shrink-0 border border-editorial-border">
            <img 
              src={`${basePath}/assets/directiva/liliana_chuzeville_cordoba.png`} 
              alt="Dra. Liliana Chuzeville Córdoba" 
              class="w-full h-full object-cover object-center grayscale contrast-110"
              loading="lazy"
            />
          </div>
          <div class="space-y-1">
            <span class="px-2 py-0.5 rounded-full bg-white text-terracota text-[9px] font-title font-bold uppercase tracking-wider inline-block">
              Delegada Emérita · Expresidenta LVT
            </span>
            <h4 class="font-serif font-bold text-base text-carbon">Dra. Liliana Chuzeville Córdoba</h4>
            <p class="text-xs text-gray-600 font-light leading-relaxed">
              Doctora en Criminología, Expresidenta de LVT, titular de la Comisión de Honor y Justicia y Directora General de la Escuela de Escritores «José Gorostiza».
            </p>
          </div>
        </div>

        <!-- Integrante 2: Mtra. Pragedis Hernández García -->
        <div class="p-5 rounded-2xl bg-editorial-warm border border-editorial-border flex items-start gap-4">
          <div class="w-16 h-16 rounded-2xl overflow-hidden bg-white shrink-0 border border-editorial-border">
            <img 
              src={`${basePath}/assets/directiva/pragedis_hernandez_garcia.png`} 
              alt="Mtra. Pragedis Hernández García" 
              class="w-full h-full object-cover object-center grayscale contrast-110"
              loading="lazy"
            />
          </div>
          <div class="space-y-1">
            <span class="px-2 py-0.5 rounded-full bg-white text-terracota text-[9px] font-title font-bold uppercase tracking-wider inline-block">
              Integrante · Expresidenta LVT
            </span>
            <h4 class="font-serif font-bold text-base text-carbon">Mtra. Pragedis Hernández García</h4>
            <p class="text-xs text-gray-600 font-light leading-relaxed">
              Expresidenta de LVT, compiladora oficial de «Tardes Tabasqueñas de Ópalos y Topacios» e integrante de la Comisión de Honor y Justicia.
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- 3. Socios Activos Acreditados de la Asociación -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-editorial-border shadow-subtle space-y-5">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-4 border-b border-editorial-border">
        <div>
          <span class="text-[10px] font-title font-bold text-terracota uppercase tracking-widest block mb-0.5">Membresía & Registro Colegiado</span>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-carbon">Socios y Colaboradores Destacados</h3>
        </div>
        <span class="text-xs font-serif italic text-gray-500">Muestra representativa de miembros y colaboradores</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs">
        
        <div class="p-4 rounded-2xl bg-editorial-warm border border-editorial-border flex gap-3.5 items-start">
          <div class="w-12 h-12 rounded-xl overflow-hidden bg-white shrink-0 border border-editorial-border">
            <img 
              src={`${basePath}/assets/autores/juan_manuel_canepa.png`} 
              alt="Mtro. Juan Manuel Cánepa Bertolini"
              class="w-full h-full object-cover object-center grayscale contrast-110"
              loading="lazy"
            />
          </div>
          <div class="space-y-1 flex-1">
            <span class="px-2 py-0.5 rounded-md bg-white text-terracota text-[9px] font-title font-bold uppercase block w-max">Socio Activo</span>
            <h4 class="font-serif font-bold text-sm text-carbon">Mtro. Juan Manuel Cánepa Bertolini</h4>
            <p class="text-gray-600 font-light">Escritor, compositor musical y conferencista. Participante en antologías institucionales de LVT.</p>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-editorial-warm border border-editorial-border flex gap-3.5 items-start">
          <div class="w-12 h-12 rounded-xl overflow-hidden bg-white shrink-0 border border-editorial-border">
            <img 
              src={`${basePath}/assets/autores/maria_cervantes.png`} 
              alt="Dra. María de los Ángeles Cervantes Rosas"
              class="w-full h-full object-cover object-center grayscale contrast-110"
              loading="lazy"
            />
          </div>
          <div class="space-y-1 flex-1">
            <span class="px-2 py-0.5 rounded-md bg-white text-terracota text-[9px] font-title font-bold uppercase block w-max">Socia Activa</span>
            <h4 class="font-serif font-bold text-sm text-carbon">Dra. María de los Ángeles Cervantes Rosas</h4>
            <p class="text-gray-600 font-light">Doctora en Ciencias Administrativas (SNI I), poeta y pintora plástica. Autora de «A corazón abierto».</p>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-editorial-warm border border-editorial-border flex gap-3.5 items-start">
          <div class="w-12 h-12 rounded-xl overflow-hidden bg-white shrink-0 border border-editorial-border flex items-center justify-center text-sm bg-editorial text-terracota font-serif font-bold">
            PP
          </div>
          <div class="space-y-1 flex-1">
            <span class="px-2 py-0.5 rounded-md bg-white text-terracota text-[9px] font-title font-bold uppercase block w-max">Socia Activa</span>
            <h4 class="font-serif font-bold text-sm text-carbon">Paulina Pineda</h4>
            <p class="text-gray-600 font-light">Escritora y promotora cultural tabasqueña, participante en lecturas líricas y actividades colegiadas.</p>
          </div>
        </div>

      </div>

      <!-- Nota de Transparencia Histórica -->
      <div class="p-4 rounded-2xl bg-editorial-warm/70 border border-editorial-border text-center mt-4">
        <p class="text-xs text-gray-600 font-serif italic leading-relaxed max-w-2xl mx-auto">
          * A lo largo de casi cuatro décadas de trayectoria gremial, más de 100 escritoras y escritores han formado parte de Letras y Voces de Tabasco, A.C. Los perfiles mostrados en esta sección corresponden a la Mesa Directiva constitucional en funciones y a una muestra representativa de socios y autores participantes.
        </p>
      </div>
    </div>

  </div>
</section>
