---
// MesaDirectiva.astro - Gobernanza y Representación Legal Institucional
---

<section id="directiva" class="py-24 bg-editorial border-b border-editorial-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[11px] font-title font-bold text-terracota uppercase tracking-widest block mb-2">Estructura y Representación Legal</span>
      <h2 class="font-serif text-4xl sm:text-5xl font-bold text-carbon">Mesa Directiva Institucional</h2>
      <p class="text-sm text-gray-600 mt-2 font-light">Gobernanza y representación de la Sociedad de Escritores Letras y Voces de Tabasco, A.C.</p>
      <div class="w-16 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Presidente -->
      <div class="bg-white p-8 sm:p-10 rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 text-center group">
        <div class="w-16 h-16 bg-carbon text-white rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:bg-terracota transition shadow-subtle">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
        <h3 class="font-serif text-2xl font-bold text-carbon mb-1">Lic. Juan David Pérez Cabrera</h3>
        <p class="text-terracota font-title text-xs font-bold uppercase tracking-wider mb-4">Presidencia y Representación Legal</p>
        <p class="text-xs text-gray-600 font-light leading-relaxed">
          Dirección general, representación legal y vinculación estratégica de la asociación con instituciones culturales nacionales e internacionales.
        </p>
      </div>

      <!-- Secretaria -->
      <div class="bg-white p-8 sm:p-10 rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 text-center group">
        <div class="w-16 h-16 bg-carbon text-white rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:bg-terracota transition shadow-subtle">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <h3 class="font-serif text-2xl font-bold text-carbon mb-1">Mtra. Eva Guadalupe Pineda Cruz</h3>
        <p class="text-terracota font-title text-xs font-bold uppercase tracking-wider mb-4">Secretaría General</p>
        <p class="text-xs text-gray-600 font-light leading-relaxed">
          Atención institucional, actas de asambleas, acuerdos directivos y gestión de correspondencia oficial con los miembros.
        </p>
      </div>

      <!-- Tesorera -->
      <div class="bg-white p-8 sm:p-10 rounded-3xl border border-editorial-border shadow-subtle hover:shadow-elevated hover:-translate-y-1 transition duration-300 text-center group">
        <div class="w-16 h-16 bg-carbon text-white rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:bg-terracota transition shadow-subtle">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="font-serif text-2xl font-bold text-carbon mb-1">Ana Laura Hernández Jiménez</h3>
        <p class="text-terracota font-title text-xs font-bold uppercase tracking-wider mb-4">Tesorería Institucional</p>
        <p class="text-xs text-gray-600 font-light leading-relaxed">
          Administración financiera, control y transparencia de fondos editoriales y regularización de aportaciones pro-fondos.
        </p>
      </div>

    </div>

  </div>
</section>
