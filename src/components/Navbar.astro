---
// Navbar.astro - Barra de Navegación Institucional con Menús Desplegables de Escritorio y Lanzador Táctil Móvil
const basePath = "/letrasyvocesdetabasco";
---

<header class="fixed top-0 left-0 right-0 z-40 bg-[#FDFBF7]/95 backdrop-blur-md border-b border-[#E6DCCE] transition-all duration-300 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 sm:h-18">
      
      <!-- Logotipo Oficial Vectorial -->
      <a href={`${basePath}/`} class="flex items-center space-x-2.5 group py-1" aria-label="Ir al inicio de Letras y Voces de Tabasco">
        <img 
          src={`${basePath}/assets/logos/LVT Logo Hor 1 Original.svg`} 
          alt="Sociedad de Escritores Letras y Voces de Tabasco, A.C." 
          class="h-9 sm:h-11 w-auto object-contain group-hover:scale-102 transition duration-200"
          onerror="this.src='/letrasyvocesdetabasco/assets/logos/LVT Logo Hor 1 Original.png'" 
        />
      </a>

      <!-- Navegación de Escritorio con Menús Desplegables -->
      <nav class="hidden lg:flex items-center space-x-1.5 xl:space-x-3 font-title text-[11px] font-bold tracking-wider uppercase text-[#222222]">
        
        <!-- Inicio -->
        <a href={`${basePath}/`} class="px-2.5 py-1.5 rounded-lg hover:text-[#EF7B38] hover:bg-[#F5EFE6] transition-colors">
          Inicio
        </a>

        <!-- 1. Menú Desplegable: Institución -->
        <div class="relative group">
          <button type="button" class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg hover:text-[#EF7B38] hover:bg-[#F5EFE6] transition-colors cursor-pointer">
            <span>Institución</span>
            <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-[#EF7B38] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full pt-1.5 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl p-2 border border-[#E6DCCE] shadow-2xl text-left normal-case space-y-1">
              <a href={`${basePath}/historia`} class="block px-3 py-2 rounded-xl bg-[#F5EFE6] text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider transition">
                📜 Historia & Fundadores 1987-2026
              </a>
              <a href={`${basePath}/historia#directiva`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                👥 Mesa Directiva (2026–2029)
              </a>
              <a href={`${basePath}/historia#solvencia`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                ⚖️ Solvencia Jurídica & Estatutos
              </a>
            </div>
          </div>
        </div>

        <!-- 2. Menú Desplegable: Escuela Gorostiza -->
        <div class="relative group">
          <a href={`${basePath}/escuela`} class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-[#EF7B38] font-bold hover:bg-[#F5EFE6] transition-colors">
            <span>Escuela Gorostiza</span>
            <svg class="w-3.5 h-3.5 text-[#EF7B38] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="absolute left-0 top-full pt-1.5 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl p-2 border border-[#E6DCCE] shadow-2xl text-left normal-case space-y-1">
              <a href={`${basePath}/escuela`} class="block px-3 py-2 rounded-xl bg-[#F5EFE6] text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider transition">
                🎓 Portal Académico 2026
              </a>
              <a href={`${basePath}/escuela#diplomados`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                📋 10 Diplomados Actualizados
              </a>
              <a href={`${basePath}/escuela#cursos`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                ✍️ 7 Cursos Continuos & Talleres
              </a>
              <a href={`${basePath}/escuela#claustro`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                🧑‍🏫 Claustro & Mtra. Liliana y Rebeca
              </a>
            </div>
          </div>
        </div>

        <!-- 3. Menú Desplegable: Acervo & Creación -->
        <div class="relative group">
          <button type="button" class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg hover:text-[#EF7B38] hover:bg-[#F5EFE6] transition-colors cursor-pointer">
            <span>Acervo & Autores</span>
            <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-[#EF7B38] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full pt-1.5 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl p-2 border border-[#E6DCCE] shadow-2xl text-left normal-case space-y-1">
              <a href={`${basePath}/publicaciones`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                📚 Catálogo de Antologías Oficiales
              </a>
              <a href={`${basePath}/audioteca`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#B8860B] text-xs font-title font-bold uppercase tracking-wider text-[#B8860B] transition flex items-center justify-between">
                <span>🎙️ Audioteca Lírica MP3</span>
                <span class="px-1.5 py-0.5 rounded bg-[#B8860B]/10 text-[9px]">14 Obras</span>
              </a>
              <a href={`${basePath}/autores`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                ✍️ Padrón Oficial de Escritores
              </a>
            </div>
          </div>
        </div>

        <!-- 4. Menú Desplegable: Convocatorias & Descargas -->
        <div class="relative group">
          <button type="button" class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg hover:text-[#EF7B38] hover:bg-[#F5EFE6] transition-colors cursor-pointer">
            <span>Comunidad</span>
            <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-[#EF7B38] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute right-0 top-full pt-1.5 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl p-2 border border-[#E6DCCE] shadow-2xl text-left normal-case space-y-1">
              <a href={`${basePath}/descargas#convocatorias`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                📢 Convocatorias & Concursos
              </a>
              <a href={`${basePath}/descargas`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                📥 Centro de Descargas PDF
              </a>
              <a href={`${basePath}/#contacto`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#EF7B38] transition">
                🎟️ Rifa Pro-Fondos ($100 MXN)
              </a>
            </div>
          </div>
        </div>

      </nav>

      <!-- Acciones Rápidas de Escritorio -->
      <div class="hidden sm:flex items-center space-x-2.5">
        <a 
          href="https://wa.me/522205889391?text=Hola%20Sociedad%20de%20Escritores%20LVT,%20deseo%20información%20institucional." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2 rounded-full bg-[#F5EFE6] border border-[#E6DCCE] text-green-700 hover:bg-green-50 hover:border-green-300 transition shadow-xs hover:scale-105" 
          title="Atención Directa por WhatsApp Oficial LVT (2205889391)"
          aria-label="Atención Directa por WhatsApp Oficial LVT"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </a>
        <a 
          href={`${basePath}/#contacto`} 
          class="px-4 py-2 rounded-xl bg-[#EF7B38] text-white font-title text-[11px] font-bold uppercase tracking-wider hover:bg-[#D96620] shadow-xs hover:scale-102 transition"
        >
          Contacto
        </a>
      </div>

      <!-- Botón Menú Móvil Táctil de 48px -->
      <div class="lg:hidden flex items-center">
        <button 
          id="navbar-mobile-toggle-btn" 
          type="button" 
          class="inline-flex items-center justify-center p-3 rounded-2xl bg-[#F5EFE6] border border-[#E6DCCE] text-[#222222] hover:text-[#EF7B38] hover:bg-white active:scale-95 transition shadow-xs cursor-pointer" 
          aria-label="Abrir menú de navegación móvil"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function initNavbarToggle() {
    function setup() {
      var btn = document.getElementById('navbar-mobile-toggle-btn');
      if (btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          if (typeof window.openGlobalMobileNav === 'function') {
            window.openGlobalMobileNav();
          }
        });
        btn.addEventListener('touchstart', function(e) {
          e.preventDefault();
          if (typeof window.openGlobalMobileNav === 'function') {
            window.openGlobalMobileNav();
          }
        }, { passive: false });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
