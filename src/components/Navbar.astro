---
// Navbar.astro - Barra de Navegación Institucional con Menús Desplegables y Menú Móvil Táctil Blindado (Drawer)
const basePath = "/letrasyvocesdetabasco";
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#FDFBF7]/95 backdrop-blur-md border-b border-[#E6DCCE] transition-all duration-300 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 sm:h-18">
      
      <!-- Logotipo Oficial Vectorial -->
      <a href={`${basePath}/`} class="flex items-center space-x-2.5 group py-1" aria-label="Ir al inicio de Letras y Voces de Tabasco">
        <img 
          src={`${basePath}/assets/logos/LVT Logo Hor 1 Original.svg`} 
          alt="Sociedad de Escritores Letras y Voces de Tabasco, A.C." 
          class="h-9 sm:h-11 w-auto object-contain group-hover:scale-102 transition duration-200"
          onerror="this.src='/letrasyvocesdetabasco/assets/logos/LVT Logo Hor 1 Original.png'" 
        />
      </a>

      <!-- Navegación de Escritorio con Menús Desplegables -->
      <nav class="hidden lg:flex items-center space-x-1.5 xl:space-x-3 font-title text-[11px] font-bold tracking-wider uppercase text-[#222222]">
        
        <!-- Inicio -->
        <a href={`${basePath}/`} class="px-2.5 py-1.5 rounded-lg hover:text-[#EF7B38] hover:bg-[#F5EFE6] transition-colors">
          Inicio
        </a>

        <!-- 1. Menú Desplegable: Institución -->
        <div class="relative group">
          <button type="button" class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg hover:text-[#EF7B38] hover:bg-[#F5EFE6] transition-colors cursor-pointer">
            <span>Institución</span>
            <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-[#EF7B38] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full pt-1.5 w-60 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl p-2 border border-[#E6DCCE] shadow-xl text-left normal-case space-y-1">
              <a href={`${basePath}/historia`} class="block px-3 py-2 rounded-xl bg-[#F5EFE6] text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider transition">
                📜 Historia & Fundadores 1987-2026
              </a>
              <a href={`${basePath}/historia#directiva`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                👥 Mesa Directiva (2026–2029)
              </a>
              <a href={`${basePath}/historia#solvencia`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                ⚖️ Solvencia Jurídica & Estatutos
              </a>
            </div>
          </div>
        </div>

        <!-- 2. Menú Desplegable: Escuela Gorostiza -->
        <div class="relative group">
          <a href={`${basePath}/escuela`} class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-[#EF7B38] font-bold hover:bg-[#F5EFE6] transition-colors">
            <span>Escuela Gorostiza</span>
            <svg class="w-3.5 h-3.5 text-[#EF7B38] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="absolute left-0 top-full pt-1.5 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl p-2 border border-[#E6DCCE] shadow-xl text-left normal-case space-y-1">
              <a href={`${basePath}/escuela`} class="block px-3 py-2 rounded-xl bg-[#F5EFE6] text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider transition">
                🎓 Portal Académico 2026
              </a>
              <a href={`${basePath}/escuela#diplomados`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                📋 10 Diplomados Actualizados
              </a>
              <a href={`${basePath}/escuela#cursos`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                ✍️ 7 Cursos Continuos & Talleres
              </a>
              <a href={`${basePath}/escuela#claustro`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                🧑‍🏫 Claustro & Mtra. Liliana y Rebeca
              </a>
            </div>
          </div>
        </div>

        <!-- 3. Menú Desplegable: Acervo & Creación -->
        <div class="relative group">
          <button type="button" class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg hover:text-[#EF7B38] hover:bg-[#F5EFE6] transition-colors cursor-pointer">
            <span>Acervo & Autores</span>
            <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-[#EF7B38] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full pt-1.5 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl p-2 border border-[#E6DCCE] shadow-xl text-left normal-case space-y-1">
              <a href={`${basePath}/publicaciones`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                📚 Catálogo de Antologías Oficiales
              </a>
              <a href={`${basePath}/audioteca`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#B8860B] text-xs font-title font-bold uppercase tracking-wider text-[#B8860B] transition flex items-center justify-between">
                <span>🎙️ Audioteca Lírica MP3</span>
                <span class="px-1.5 py-0.5 rounded bg-[#B8860B]/10 text-[9px]">14 Obras</span>
              </a>
              <a href={`${basePath}/autores`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                ✍️ Padrón Oficial de Escritores
              </a>
            </div>
          </div>
        </div>

        <!-- 4. Menú Desplegable: Convocatorias & Descargas -->
        <div class="relative group">
          <button type="button" class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg hover:text-[#EF7B38] hover:bg-[#F5EFE6] transition-colors cursor-pointer">
            <span>Comunidad</span>
            <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-[#EF7B38] group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute right-0 top-full pt-1.5 w-60 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl p-2 border border-[#E6DCCE] shadow-xl text-left normal-case space-y-1">
              <a href={`${basePath}/descargas`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#222222] transition">
                📥 Centro de Descargas PDF
              </a>
              <a href={`${basePath}/#contacto`} class="block px-3 py-2 rounded-xl hover:bg-[#FDFBF7] hover:text-[#EF7B38] text-xs font-title font-bold uppercase tracking-wider text-[#EF7B38] transition">
                🎟️ Rifa Pro-Fondos & Contacto
              </a>
            </div>
          </div>
        </div>

      </nav>

      <!-- Acciones Rápidas -->
      <div class="hidden sm:flex items-center space-x-2.5">
        <a 
          href="https://wa.me/529932647502?text=Hola%20Sociedad%20de%20Escritores%20LVT,%20deseo%20información%20institucional%20o%20académica." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2 rounded-full bg-[#F5EFE6] border border-[#E6DCCE] text-green-700 hover:bg-green-50 hover:border-green-300 transition shadow-xs hover:scale-105" 
          title="Atención Directa por WhatsApp Oficial (9932647502)"
          aria-label="Atención Directa por WhatsApp Oficial"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </a>
        <a 
          href={`${basePath}/#contacto`} 
          class="px-4 py-2 rounded-xl bg-[#EF7B38] text-white font-title text-[11px] font-bold uppercase tracking-wider hover:bg-[#D96620] shadow-xs hover:scale-102 transition"
        >
          Contacto
        </a>
      </div>

      <!-- Botón Menú Móvil (Botón Táctil Amplio de 48px) -->
      <div class="lg:hidden flex items-center">
        <button 
          id="mobile-open-btn" 
          type="button" 
          class="inline-flex items-center justify-center p-3 rounded-2xl bg-[#F5EFE6] border border-[#E6DCCE] text-[#222222] hover:text-[#EF7B38] hover:bg-white active:scale-95 transition shadow-xs cursor-pointer" 
          aria-label="Abrir menú de navegación"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- MENÚ MÓVIL OFF-CANVAS / DRAWER LATERAL DESLIZABLE BLINDADO        -->
  <!-- ================================================================= -->
  <div id="mobile-drawer-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"></div>

  <div 
    id="mobile-drawer" 
    class="fixed top-0 right-0 bottom-0 w-[85vw] max-w-sm bg-[#FDFBF7] z-50 shadow-2xl border-l border-[#E6DCCE] flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden"
    role="dialog" 
    aria-modal="true"
  >
    <!-- Encabezado del Menú Móvil -->
    <div class="p-5 border-b border-[#E6DCCE] flex items-center justify-between bg-white">
      <div class="flex items-center gap-2">
        <img 
          src={`${basePath}/assets/logos/LVT Logo Iso 6 Blanco Relleno.svg`} 
          alt="LVT" 
          class="h-7 w-auto object-contain bg-[#1C1814] p-1 rounded-lg"
        />
        <span class="font-title font-bold text-xs uppercase tracking-wider text-[#222222]">
          Letras y Voces
        </span>
      </div>
      
      <!-- Botón de Cerrar -->
      <button 
        id="mobile-close-btn" 
        type="button" 
        class="p-2.5 rounded-xl bg-[#F5EFE6] text-gray-700 hover:text-red-600 hover:bg-red-50 active:scale-95 transition cursor-pointer"
        aria-label="Cerrar menú"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Lista de Enlaces Táctiles de Alta Frecuencia -->
    <div class="p-5 overflow-y-auto flex-1 space-y-4 font-title text-xs font-bold uppercase tracking-wider">
      
      <!-- 🏠 Inicio -->
      <a href={`${basePath}/`} class="mobile-nav-link flex items-center gap-3 p-3 rounded-2xl bg-white border border-[#E6DCCE] hover:border-[#EF7B38] hover:text-[#EF7B38] text-[#222222] shadow-xs active:scale-98 transition">
        <span class="text-lg">🏠</span>
        <span>Página de Inicio</span>
      </a>

      <!-- 🎓 Escuela Gorostiza (Destacada) -->
      <a href={`${basePath}/escuela`} class="mobile-nav-link flex items-center justify-between p-3.5 rounded-2xl bg-gradient-to-r from-[#EF7B38]/15 to-[#F5EFE6] border border-[#EF7B38]/40 text-[#EF7B38] shadow-xs active:scale-98 transition">
        <div class="flex items-center gap-3">
          <span class="text-lg">🎓</span>
          <span>Escuela Gorostiza</span>
        </div>
        <span class="px-2 py-0.5 rounded-full bg-[#EF7B38] text-white text-[9px]">10 Diplomados</span>
      </a>

      <!-- 📚 Catálogo Editorial -->
      <a href={`${basePath}/publicaciones`} class="mobile-nav-link flex items-center justify-between p-3 rounded-2xl bg-white border border-[#E6DCCE] hover:border-[#EF7B38] hover:text-[#EF7B38] text-[#222222] shadow-xs active:scale-98 transition">
        <div class="flex items-center gap-3">
          <span class="text-lg">📚</span>
          <span>Catálogo Editorial</span>
        </div>
        <span class="text-[10px] text-gray-400">5 Antologías</span>
      </a>

      <!-- 🎙️ Audioteca Lírica -->
      <a href={`${basePath}/audioteca`} class="mobile-nav-link flex items-center justify-between p-3 rounded-2xl bg-white border border-[#E6DCCE] hover:border-[#B8860B] hover:text-[#B8860B] text-[#B8860B] shadow-xs active:scale-98 transition">
        <div class="flex items-center gap-3">
          <span class="text-lg">🎙️</span>
          <span>Audioteca Lírica</span>
        </div>
        <span class="px-2 py-0.5 rounded-full bg-[#B8860B]/10 text-[9px]">14 Obras MP3</span>
      </a>

      <!-- ✍️ Padrón de Escritores -->
      <a href={`${basePath}/autores`} class="mobile-nav-link flex items-center justify-between p-3 rounded-2xl bg-white border border-[#E6DCCE] hover:border-[#EF7B38] hover:text-[#EF7B38] text-[#222222] shadow-xs active:scale-98 transition">
        <div class="flex items-center gap-3">
          <span class="text-lg">✍️</span>
          <span>Padrón de Escritores</span>
        </div>
        <span class="text-[10px] text-gray-400">28 Autores</span>
      </a>

      <!-- 📜 Historia & Gobernanza -->
      <a href={`${basePath}/historia`} class="mobile-nav-link flex items-center gap-3 p-3 rounded-2xl bg-white border border-[#E6DCCE] hover:border-[#EF7B38] hover:text-[#EF7B38] text-[#222222] shadow-xs active:scale-98 transition">
        <span class="text-lg">📜</span>
        <span>Historia & Fundadores (1987-2026)</span>
      </a>

      <!-- 📥 Centro de Descargas -->
      <a href={`${basePath}/descargas`} class="mobile-nav-link flex items-center gap-3 p-3 rounded-2xl bg-white border border-[#E6DCCE] hover:border-[#EF7B38] hover:text-[#EF7B38] text-[#222222] shadow-xs active:scale-98 transition">
        <span class="text-lg">📥</span>
        <span>Centro de Descargas PDF</span>
      </a>

    </div>

    <!-- Pie del Menú con Accesos Rápidos de Contacto -->
    <div class="p-5 border-t border-[#E6DCCE] bg-white space-y-2.5">
      <a 
        href="https://wa.me/529932647502?text=Hola%20Sociedad%20de%20Escritores%20LVT,%20deseo%20informes." 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-green-600 hover:bg-green-700 text-white font-title text-xs font-bold uppercase tracking-wider shadow-md active:scale-98 transition"
      >
        <span>📲 WhatsApp Oficial (9932647502)</span>
      </a>
      <a 
        href={`${basePath}/#contacto`} 
        class="mobile-nav-link flex items-center justify-center w-full py-2.5 rounded-xl bg-[#222222] text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-[#EF7B38] active:scale-98 transition"
      >
        Formulario de Contacto
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Script Táctil Blindado para Menú Móvil
  (function initMobileDrawer() {
    function setup() {
      var openBtn = document.getElementById('mobile-open-btn');
      var closeBtn = document.getElementById('mobile-close-btn');
      var drawer = document.getElementById('mobile-drawer');
      var backdrop = document.getElementById('mobile-drawer-backdrop');
      var links = document.querySelectorAll('.mobile-nav-link');

      if (!openBtn || !drawer || !backdrop) return;

      function openDrawer(e) {
        if (e) e.preventDefault();
        drawer.classList.remove('translate-x-full');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer(e) {
        if (e) e.preventDefault();
        drawer.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      }

      openBtn.addEventListener('click', openDrawer);
      openBtn.addEventListener('touchstart', openDrawer, { passive: false });

      if (closeBtn) {
        closeBtn.addEventListener('click', closeDrawer);
        closeBtn.addEventListener('touchstart', closeDrawer, { passive: false });
      }

      backdrop.addEventListener('click', closeDrawer);
      backdrop.addEventListener('touchstart', closeDrawer, { passive: false });

      links.forEach(function(link) {
        link.addEventListener('click', function() {
          setTimeout(closeDrawer, 100);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
