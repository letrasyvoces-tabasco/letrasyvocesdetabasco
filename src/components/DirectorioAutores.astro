---
// DirectorioAutores.astro - Directorio Oficial de Autores, Fundadores y Socios de LVT
import { PADRON_AUTORES } from '../data/autores';
const basePath = "";

const FOTOS_AUTORES: Record<string, string> = {
  'juan-david-perez-cabrera': '/assets/directiva/juan_david_perez_cabrera.jpg',
  'eva-guadalupe-pineda-cruz': '/assets/directiva/eva_guadalupe_pineda_cruz.jpg',
  'ana-laura-hernandez-jimenez': '/assets/directiva/ana_laura_hernandez_jimenez.jpg',
  'liliana-chuzeville-cordoba': '/assets/directiva/liliana_chuzeville_cordoba.png',
  'pragedis-hernandez-garcia': '/assets/directiva/pragedis_hernandez_garcia.png',
  'juan-manuel-canepa-bertolini': '/assets/autores/juan_manuel_canepa.png',
  'maria-de-los-angeles-cervantes': '/assets/autores/maria_cervantes.png',
  'rebeca-diaz-suarez': '/assets/directiva/rebeca_diaz_suarez.png',
};
---

<section id="autores" class="py-14 sm:py-16 bg-[#FDFBF7] border-b border-[#E6DCCE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Cabecera -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#EF7B38]/10 text-[#EF7B38] text-[10px] sm:text-xs font-title font-bold tracking-widest uppercase rounded-full mb-3">
        Padrón Autoral & Membresía Histórica
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-title font-black tracking-tight text-[#222222]">
        Plumas y Creadores de <span class="text-[#EF7B38]">Tabasco</span>
      </h2>
      <p class="mt-3 text-xs sm:text-sm md:text-base font-serif italic text-[#555555]">
        Fundadores, directivos, maestras y autores contemporáneos que han forjado el patrimonio literario de nuestra asociación a lo largo de casi cuatro décadas.
      </p>
      <div class="w-20 h-0.5 bg-[#EF7B38] mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Buscador y Filtros -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-10">
      
      <!-- Filtro por Categoría / Género -->
      <div class="flex flex-wrap justify-center gap-2">
        <button type="button" class="author-filter active px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-[#EF7B38] text-white shadow-sm transition" data-filter="all">
          Todos ({PADRON_AUTORES.length})
        </button>
        <button type="button" class="author-filter px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-white text-[#222222] border border-[#E6DCCE] hover:text-[#EF7B38] shadow-subtle transition" data-filter="fundador">
          Fundadores & Honoríficos
        </button>
        <button type="button" class="author-filter px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-white text-[#222222] border border-[#E6DCCE] hover:text-[#EF7B38] shadow-subtle transition" data-filter="directiva">
          Mesa Directiva & Socios Activos
        </button>
        <button type="button" class="author-filter px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-white text-[#222222] border border-[#E6DCCE] hover:text-[#EF7B38] shadow-subtle transition" data-filter="poesia">
          Poesía
        </button>
        <button type="button" class="author-filter px-4 py-2 rounded-xl text-xs font-title font-bold uppercase tracking-wider bg-white text-[#222222] border border-[#E6DCCE] hover:text-[#EF7B38] shadow-subtle transition" data-filter="narrativa">
          Narrativa
        </button>
      </div>

      <!-- Buscador en tiempo real -->
      <div class="relative w-full md:w-72">
        <input 
          type="text" 
          id="author-search-input" 
          placeholder="Buscar por nombre u obra..." 
          class="w-full pl-9 pr-4 py-2 text-xs rounded-xl bg-white border border-[#E6DCCE] text-[#222222] placeholder-gray-400 focus:outline-none focus:border-[#EF7B38] shadow-subtle"
        />
        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

    </div>

    <!-- Cuadrícula Dinámica de Fichas de Autores -->
    <div id="authors-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {PADRON_AUTORES.map((autor) => {
        let filterCat = "contemporaneo";
        if (autor.categoria.includes("Fundadores")) filterCat = "fundador";
        else if (autor.categoria.includes("Mesa Directiva")) filterCat = "directiva";

        const genreLower = autor.generoPrincipal.toLowerCase();
        const fotoAutor = FOTOS_AUTORES[autor.id];

        return (
          <div 
            class="author-card bg-white p-6 sm:p-7 rounded-2xl border border-[#E6DCCE] shadow-subtle hover:shadow-elevated hover:border-[#EF7B38] hover:-translate-y-1 transition duration-300 flex flex-col justify-between"
            data-category={filterCat}
            data-genre={genreLower}
            data-name={autor.nombre.toLowerCase()}
            data-work={autor.obraRepresentativa.toLowerCase()}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded-full bg-[#F5EFE6] text-[#EF7B38] text-[10px] font-title font-bold uppercase tracking-wider border border-[#E6DCCE]">
                  {autor.generoPrincipal}
                </span>
                <span class="text-[11px] font-serif italic text-gray-400 text-right truncate">
                  {autor.categoria.split('&')[0].trim()}
                </span>
              </div>

              <div class="flex items-start gap-3.5 mb-2">
                {fotoAutor ? (
                  <div class="w-14 h-14 min-w-[56px] min-h-[56px] max-w-[56px] max-h-[56px] rounded-xl overflow-hidden bg-[#F5EFE6] shrink-0 border border-[#E6DCCE] shadow-xs" style="width: 56px; height: 56px; min-width: 56px; min-height: 56px;">
                    <img 
                      src={`${basePath}${fotoAutor}`} 
                      alt={autor.nombre} 
                      width="56"
                      height="56"
                      class="w-full h-full object-cover object-center grayscale contrast-110 block rounded-xl"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="w-14 h-14 min-w-[56px] min-h-[56px] max-w-[56px] max-h-[56px] rounded-xl bg-[#F5EFE6] border border-[#E6DCCE] shrink-0 flex items-center justify-center font-title font-bold text-sm text-[#EF7B38] shadow-xs" style="width: 56px; height: 56px; min-width: 56px; min-height: 56px;">
                    {autor.nombre.split(' ').map(n => n[0]).slice(0, 2).join('')}
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-title text-base sm:text-lg font-black text-[#222222] leading-tight">
                    {autor.tratamiento && <span class="text-[#EF7B38] font-normal text-sm mr-1">{autor.tratamiento}</span>}
                    {autor.nombre}
                  </h3>
                  <span class="text-[11px] text-[#B8860B] font-title font-semibold block mt-0.5 leading-tight">
                    {autor.rolGremial}
                  </span>
                </div>
              </div>

              <p class="text-xs text-gray-600 font-sans leading-relaxed">
                {autor.semblanza}
              </p>
            </div>

            <div class="mt-5 pt-4 border-t border-[#E6DCCE] space-y-2">
              <div class="flex items-center justify-between text-[11px]">
                <span class="text-gray-400 uppercase font-title font-bold text-[9px] tracking-wider">Obra Representativa</span>
                <span class="font-serif font-bold text-[#222222] text-right truncate max-w-[60%]">{autor.obraRepresentativa}</span>
              </div>
              
              {autor.antologiasParticipadas && autor.antologiasParticipadas.length > 0 && (
                <div class="flex flex-wrap gap-1 pt-1">
                  {autor.antologiasParticipadas.slice(0, 3).map((ant) => (
                    <span class="px-2 py-0.5 bg-[#F5EFE6] text-gray-600 text-[9px] rounded-md font-sans">
                      {ant}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Mensaje si no hay resultados en búsqueda -->
    <div id="no-authors-msg" class="hidden text-center py-12">
      <p class="text-gray-500 font-serif italic text-base">No se encontraron autores que coincidan con la búsqueda.</p>
    </div>

    <!-- Invitación Institucional -->
    <div class="mt-16 text-center bg-white p-8 rounded-2xl border border-[#E6DCCE] shadow-subtle max-w-2xl mx-auto">
      <h4 class="font-title text-lg font-black text-[#222222] mb-2">¿Deseas integrarte a nuestro Padrón Oficial?</h4>
      <p class="text-xs text-gray-500 font-sans mb-6 leading-relaxed">
        La Sociedad de Escritores Letras y Voces de Tabasco, A.C. abre sus puertas a escritoras, escritores, poetas y ensayistas con obra inédita o publicada en el sureste de México.
      </p>
      <a 
        href={`${basePath}/#contacto`} 
        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#222222] text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-[#EF7B38] transition shadow-sm"
      >
        <span>Solicitar Información de Afiliación</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  // Filtros y Búsqueda Dinámica de Autores
  const filterBtns = document.querySelectorAll('.author-filter');
  const authorCards = document.querySelectorAll('.author-card');
  const searchInput = document.getElementById('author-search-input') as HTMLInputElement | null;
  const noMsg = document.getElementById('no-authors-msg');

  let currentFilter = 'all';
  let currentSearch = '';

  function applyFilterAndSearch() {
    let visibleCount = 0;

    authorCards.forEach(card => {
      const category = card.getAttribute('data-category') || '';
      const genre = card.getAttribute('data-genre') || '';
      const name = card.getAttribute('data-name') || '';
      const work = card.getAttribute('data-work') || '';

      const matchesFilter = 
        currentFilter === 'all' || 
        category === currentFilter || 
        genre === currentFilter ||
        (currentFilter === 'poesia' && genre.includes('poesía')) ||
        (currentFilter === 'narrativa' && genre.includes('narrativa'));

      const matchesSearch = 
        currentSearch === '' || 
        name.includes(currentSearch) || 
        work.includes(currentSearch);

      if (matchesFilter && matchesSearch) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (noMsg) {
      noMsg.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-[#EF7B38]', 'text-white', 'shadow-sm');
        b.classList.add('bg-white', 'text-[#222222]', 'border', 'border-[#E6DCCE]');
      });
      btn.classList.remove('bg-white', 'text-[#222222]', 'border', 'border-[#E6DCCE]');
      btn.classList.add('bg-[#EF7B38]', 'text-white', 'shadow-sm');

      currentFilter = btn.getAttribute('data-filter') || 'all';
      applyFilterAndSearch();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilterAndSearch();
    });
  }
</script>
