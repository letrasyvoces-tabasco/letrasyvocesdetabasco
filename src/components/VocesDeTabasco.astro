---
// VocesDeTabasco.astro - Gran Audioteca Institucional LVT: 14 Obras con Reproductor Nativo HTML5 Idéntico
import { CATALOGO_VOCES_HISTORICAS } from '../data/voces';
const basePath = "/letrasyvocesdetabasco";
---

<section id="voces" class="py-20 sm:py-28 bg-[#181818] text-white relative overflow-hidden border-b border-gray-800">
  
  <!-- Resplandores ambientales de fondo -->
  <div class="absolute -top-40 -left-40 w-72 sm:w-96 h-72 sm:h-96 bg-[#EF7B38]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-72 sm:w-96 h-72 sm:h-96 bg-[#B8860B]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#B8860B]/15 border border-[#B8860B]/30 text-[#F5DEB3] font-title text-[10px] sm:text-[11px] font-bold uppercase tracking-widest mb-3 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-ping"></span>
        <span>Audioteca Patrimonial LVT · 14 Obras en Audio Nativo</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-title font-black text-white">
        Voces y Poesía de Nuestra Historia
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-gray-300 mt-3 font-serif italic leading-relaxed">
        Todas las 14 obras cuentan con reproductor sonoro nativo en alta fidelidad. Selecciona cualquier pista para escuchar la voz auténtica y seguir la lectura del poema.
      </p>
      <div class="w-20 h-0.5 bg-[#EF7B38] mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- ================================================================= -->
    <!-- 🌟 REPRODUCTOR MAESTRO NATIVO IDÉNTICO (DECK DE AUDIO & LECTURA)  -->
    <!-- ================================================================= -->
    <div id="master-deck-container" class="bg-gradient-to-br from-[#2D1B13] via-[#222222] to-[#1A1A1A] border-2 border-[#EF7B38]/70 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden mb-14 transition-all duration-300">
      <div class="absolute -right-20 -top-20 w-64 h-64 bg-[#EF7B38]/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Panel Izquierdo: Ficha Técnica y Controles de Audio -->
        <div class="lg:col-span-6 space-y-5">
          
          <div class="flex flex-wrap items-center gap-2">
            <span id="deck-badge-tipo" class="px-3 py-1 rounded-full bg-[#EF7B38] text-white text-[10px] font-title font-bold uppercase tracking-widest shadow-sm">
              🎙️ Grabación Oficial de Estudio LVT
            </span>
            <span id="deck-track-num" class="px-2.5 py-0.5 rounded-full bg-black/60 border border-gray-700 text-[#F5DEB3] text-[10px] font-mono font-bold">
              Pista #01 de 14
            </span>
            <span id="deck-pais" class="text-xs text-gray-400 font-mono">
              Buenos Aires, Argentina / Tabasco
            </span>
          </div>

          <div>
            <h3 id="deck-titulo" class="font-title font-black text-2xl sm:text-3xl lg:text-4xl text-white leading-tight">
              Oliverio Girondo — «Espantapájaros (1)»
            </h3>
            <p id="deck-declamador" class="text-sm font-title font-bold text-[#EF7B38] mt-1">
              Declamación: Lic. Juan David Pérez Cabrera (Letras y Voces de Tabasco, A.C.)
            </p>
            <p id="deck-desc" class="text-xs sm:text-sm text-gray-300 font-serif italic leading-relaxed mt-2">
              Grabación oficial en alta fidelidad preservada en el archivo de audio de la Sociedad de Escritores Letras y Voces de Tabasco, A.C.
            </p>
          </div>

          <!-- MÓDULO DE REPRODUCCIÓN SONORA NATIVA HTML5 (IDÉNTICO PARA TODAS LAS PISTAS) -->
          <div class="bg-black/80 p-5 rounded-2xl border border-[#EF7B38]/40 space-y-4 shadow-inner">
            
            <div class="flex justify-between items-center text-xs font-mono text-gray-400">
              <span id="deck-audio-status" class="text-[#EF7B38] font-bold flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-pulse"></span>
                <span>Audio Master Listo</span>
              </span>
              <span class="text-gray-400 font-mono">Calidad Estudio 48kHz Stereo</span>
            </div>

            <!-- Reproductor Nativo HTML5 -->
            <div class="block">
              <audio 
                id="master-audio-element" 
                controls 
                class="w-full rounded-xl" 
                preload="metadata"
                src={`${basePath}/assets/audios/espantapajaros_oliverio_girondo_david_cabrera.mp3`}
              >
                Tu navegador no soporta la reproducción de audio HTML5.
              </audio>
            </div>

            <!-- Botones de Navegación Entre Pistas -->
            <div class="flex justify-between items-center pt-2 border-t border-gray-800 text-xs">
              <button 
                id="deck-btn-prev" 
                type="button" 
                class="px-4 py-2 rounded-xl bg-gray-800 hover:bg-[#EF7B38] hover:text-white text-gray-200 font-title text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-sm"
              >
                ⏮ Pista Anterior
              </button>
              
              <span id="deck-nav-indicator" class="text-[11px] font-mono text-gray-400">
                1 / 14
              </span>

              <button 
                id="deck-btn-next" 
                type="button" 
                class="px-4 py-2 rounded-xl bg-gray-800 hover:bg-[#EF7B38] hover:text-white text-gray-200 font-title text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-sm"
              >
                Pista Siguiente ⏭
              </button>
            </div>

          </div>

        </div>

        <!-- Panel Derecho: Texto Lírico Completo del Poema Activo -->
        <div class="lg:col-span-6 space-y-3">
          <div class="flex justify-between items-center pb-2 border-b border-gray-800">
            <span class="font-title font-bold text-xs uppercase text-[#EF7B38] tracking-widest">
              📖 Texto Íntegro de la Obra
            </span>
            <span id="deck-text-author" class="text-xs text-[#F5DEB3] font-serif italic">
              Oliverio Girondo
            </span>
          </div>

          <div class="bg-black/60 p-6 rounded-2xl border border-gray-800 max-h-[380px] overflow-y-auto space-y-3 text-xs sm:text-sm font-serif leading-relaxed text-gray-200 scrollbar-thin shadow-inner">
            <p id="deck-texto-completo" class="italic whitespace-pre-line text-gray-300">
              {CATALOGO_VOCES_HISTORICAS[0].textoPoema}
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- ================================================================= -->
    <!-- 📋 CATÁLOGO COMPLETO DE LAS 14 PISTAS CON REPRODUCTOR NATIVO      -->
    <!-- ================================================================= -->
    <div class="space-y-6">
      
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 border-b border-gray-800">
        <div>
          <span class="text-xs font-title font-bold uppercase tracking-widest text-[#EF7B38]">Colección Completa de Audio Nativo</span>
          <h3 class="text-2xl sm:text-3xl font-title font-bold text-white mt-0.5">Catálogo de las 14 Grabaciones</h3>
        </div>
        <p class="text-xs text-gray-400 font-serif italic">
          Haz clic en cualquier obra para cargar y reproducir su pista de audio nativa inmediatamente.
        </p>
      </div>

      <!-- Cuadrícula de las 14 Pistas -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {CATALOGO_VOCES_HISTORICAS.map((item, index) => (
          <div 
            class={`track-card bg-[#242424] p-5 rounded-2xl border transition-all duration-300 cursor-pointer flex flex-col justify-between hover:border-[#EF7B38] hover:shadow-lg ${index === 0 ? 'border-[#EF7B38] ring-2 ring-[#EF7B38]/50 bg-[#2A1D17]' : 'border-gray-700/80'}`}
            data-index={index}
            id={`track-card-${index}`}
          >
            <div class="space-y-2">
              
              <!-- Cabecera de la Tarjeta -->
              <div class="flex justify-between items-start gap-2">
                <span class={`px-2.5 py-0.5 rounded-full text-[9px] font-title font-bold uppercase tracking-wider ${item.tipo === 'estudio_local' ? 'bg-[#EF7B38] text-white' : 'bg-black/60 text-[#EF7B38] border border-gray-800'}`}>
                  {item.tipo === 'estudio_local' ? '🎙️ Estudio LVT' : '📻 Registro Histórico'}
                </span>
                <span class="text-[10px] font-mono text-gray-400">Pista #{item.pista < 10 ? '0' + item.pista : item.pista}</span>
              </div>

              <!-- Título y Autor -->
              <div>
                <h4 class="font-title font-bold text-base text-white leading-snug">{item.titulo}</h4>
                <p class="text-xs text-[#F5DEB3] font-serif italic">{item.autor}</p>
              </div>

              <!-- Declamador y País -->
              <div class="text-[11px] text-gray-300 font-sans space-y-0.5 pt-1">
                <p class="font-medium text-gray-300 line-clamp-1">🎙️ {item.declamador}</p>
                <p class="text-gray-400 text-[10px] font-mono">📍 {item.pais}</p>
              </div>

            </div>

            <!-- Botón de Reproducción -->
            <div class="mt-4 pt-3 border-t border-gray-800 flex justify-between items-center">
              <span class="text-[11px] font-title font-bold text-[#EF7B38] uppercase flex items-center gap-1.5">
                <span class="play-icon text-xs">▶</span>
                <span class="play-text">Reproducir Audio</span>
              </span>
              <span class="text-[10px] font-mono text-gray-500">Audio Nativo MP3</span>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<script define:vars={{ catalogoJson: CATALOGO_VOCES_HISTORICAS, basePath }}>
  // Motor del Reproductor Maestro de Audioteca LVT (100% Audio Nativo HTML5)
  const catalogo = catalogoJson;
  let currentTrackIndex = 0;

  // Elementos del Deck Maestro
  const masterAudio = document.getElementById('master-audio-element');
  const badgeTipo = document.getElementById('deck-badge-tipo');
  const trackNum = document.getElementById('deck-track-num');
  const deckPais = document.getElementById('deck-pais');
  const deckTitulo = document.getElementById('deck-titulo');
  const deckDeclamador = document.getElementById('deck-declamador');
  const deckDesc = document.getElementById('deck-desc');
  const deckTexto = document.getElementById('deck-texto-completo');
  const deckAuthorText = document.getElementById('deck-text-author');
  const deckStatus = document.getElementById('deck-audio-status');
  const deckNavIndicator = document.getElementById('deck-nav-indicator');
  const deckContainer = document.getElementById('master-deck-container');

  function detenerTodosLosAudios() {
    if (masterAudio) {
      masterAudio.pause();
      masterAudio.currentTime = 0;
    }
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
  }

  function cargarPista(index, autoPlay = true) {
    if (index < 0 || index >= catalogo.length) return;
    
    detenerTodosLosAudios();
    currentTrackIndex = index;
    const track = catalogo[index];

    // Actualizar Textos del Deck
    if (badgeTipo) {
      badgeTipo.innerText = track.tipo === 'estudio_local' ? '🎙️ Grabación Oficial de Estudio LVT' : '📻 Registro Histórico de Archivo';
    }
    if (trackNum) {
      trackNum.innerText = `Pista #${track.pista < 10 ? '0' + track.pista : track.pista} de ${catalogo.length}`;
    }
    if (deckNavIndicator) {
      deckNavIndicator.innerText = `${track.pista} / ${catalogo.length}`;
    }
    if (deckPais) {
      deckPais.innerText = track.pais;
    }
    if (deckTitulo) {
      deckTitulo.innerText = `${track.autor} — «${track.titulo}»`;
    }
    if (deckDeclamador) {
      deckDeclamador.innerText = `Declamación: ${track.declamador}`;
    }
    if (deckDesc) {
      deckDesc.innerText = track.descripcion;
    }
    if (deckTexto) {
      deckTexto.innerText = track.textoPoema;
    }
    if (deckAuthorText) {
      deckAuthorText.innerText = track.autor;
    }

    // Cargar y reproducir pista en el elemento <audio> maestro idéntico
    if (masterAudio && track.audioUrl) {
      masterAudio.src = track.audioUrl;
      masterAudio.load();
      if (autoPlay) {
        masterAudio.play().catch(() => {
          // Autoplay prevenido por políticas del navegador
        });
      }
    }

    if (deckStatus) {
      deckStatus.innerHTML = `<span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-pulse"></span><span>Reproduciendo Pista #${track.pista}</span>`;
    }

    // Actualizar estilo visual de las tarjetas en la lista
    document.querySelectorAll('.track-card').forEach((card, idx) => {
      if (idx === index) {
        card.classList.add('border-[#EF7B38]', 'ring-2', 'ring-[#EF7B38]/50', 'bg-[#2A1D17]');
        card.classList.remove('border-gray-700/80', 'bg-[#242424]');
        const playIcon = card.querySelector('.play-icon');
        const playText = card.querySelector('.play-text');
        if (playIcon) playIcon.innerText = "🔊";
        if (playText) playText.innerText = "En Reproducción";
      } else {
        card.classList.remove('border-[#EF7B38]', 'ring-2', 'ring-[#EF7B38]/50', 'bg-[#2A1D17]');
        card.classList.add('border-gray-700/80', 'bg-[#242424]');
        const playIcon = card.querySelector('.play-icon');
        const playText = card.querySelector('.play-text');
        if (playIcon) playIcon.innerText = "▶";
        if (playText) playText.innerText = "Reproducir Audio";
      }
    });

    // Desplazar suavemente hacia el Deck si el usuario está abajo
    if (deckContainer && window.scrollY > deckContainer.offsetTop + 350) {
      deckContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  // Event Listeners de las 14 Tarjetas de la Lista
  document.querySelectorAll('.track-card').forEach(card => {
    card.addEventListener('click', () => {
      const idx = parseInt(card.getAttribute('data-index') || '0');
      cargarPista(idx, true);
    });
  });

  // Botones Anterior / Siguiente del Deck Maestro
  document.getElementById('deck-btn-prev')?.addEventListener('click', () => {
    const prev = currentTrackIndex === 0 ? catalogo.length - 1 : currentTrackIndex - 1;
    cargarPista(prev, true);
  });

  document.getElementById('deck-btn-next')?.addEventListener('click', () => {
    const next = currentTrackIndex === catalogo.length - 1 ? 0 : currentTrackIndex + 1;
    cargarPista(next, true);
  });
</script>
