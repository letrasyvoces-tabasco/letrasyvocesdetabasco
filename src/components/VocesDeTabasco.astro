---
// VocesDeTabasco.astro - Gran Audioteca Institucional LVT: Clasificación por Origen (LVT vs Externos) y Género (Lírica vs Narrativa)
import { CATALOGO_VOCES_HISTORICAS } from '../data/voces';
const basePath = "";
---

<section id="voces" class="py-14 sm:py-16 bg-[#181818] text-white relative overflow-hidden border-b border-gray-800">
  
  <!-- Resplandores ambientales de fondo -->
  <div class="absolute -top-40 -left-40 w-72 sm:w-96 h-72 sm:h-96 bg-[#EF7B38]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-72 sm:w-96 h-72 sm:h-96 bg-[#B8860B]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-10">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#B8860B]/15 border border-[#B8860B]/30 text-[#F5DEB3] font-title text-[10px] sm:text-[11px] font-bold uppercase tracking-widest mb-3 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-ping"></span>
        <span>Audioteca & Fonoteca · Grabaciones en Audio Nativo MP3</span>
      </div>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-title font-black text-white">
        Voces y Poesía de Nuestra Historia
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-gray-300 mt-2 font-serif italic leading-relaxed">
        Grabaciones oficiales de miembros de la Sociedad de Escritores LVT y acervo de grandes voces de la literatura hispanoamericana en alta fidelidad.
      </p>
      <div class="w-20 h-0.5 bg-[#EF7B38] mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- ================================================================= -->
    <!-- BARRA DE FILTROS INTERACTIVA: ORIGEN Y GÉNERO                     -->
    <!-- ================================================================= -->
    <div class="flex flex-wrap items-center justify-center gap-2 max-w-4xl mx-auto font-title text-xs font-bold uppercase tracking-wider">
      <button 
        type="button" 
        data-filter="all" 
        class="filter-audio-btn px-4 py-2 rounded-xl bg-[#EF7B38] text-white border border-[#EF7B38] shadow-md transition cursor-pointer"
      >
        🎛️ Todas las Pistas
      </button>
      <button 
        type="button" 
        data-filter="miembro_lvt" 
        class="filter-audio-btn px-4 py-2 rounded-xl bg-[#25201B] hover:bg-[#EF7B38]/20 text-[#F5DEB3] border border-gray-700 transition cursor-pointer"
      >
        🌟 Voces de Miembros LVT
      </button>
      <button 
        type="button" 
        data-filter="externo_universal" 
        class="filter-audio-btn px-4 py-2 rounded-xl bg-[#25201B] hover:bg-[#EF7B38]/20 text-gray-300 border border-gray-700 transition cursor-pointer"
      >
        🌍 Autores Universales (Acervo Externo)
      </button>
      <button 
        type="button" 
        data-filter="lirica" 
        class="filter-audio-btn px-4 py-2 rounded-xl bg-[#25201B] hover:bg-[#EF7B38]/20 text-gray-300 border border-gray-700 transition cursor-pointer"
      >
        📜 Lírica & Poesía
      </button>
      <button 
        type="button" 
        data-filter="narrativa" 
        class="filter-audio-btn px-4 py-2 rounded-xl bg-[#25201B] hover:bg-[#EF7B38]/20 text-gray-300 border border-gray-700 transition cursor-pointer"
      >
        📖 Narrativa & Relato
      </button>
    </div>

    <!-- ================================================================= -->
    <!-- REPRODUCTOR MAESTRO CENTRAL CON VISOR DE TEXTO                    -->
    <!-- ================================================================= -->
    <div class="bg-gradient-to-br from-[#1C1814] to-[#25201B] border border-[#3A2E26] rounded-3xl p-6 sm:p-10 shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Panel Izquierdo: Ficha Técnica y Controles -->
        <div class="lg:col-span-6 space-y-5">
          
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span id="deck-badge" class="px-3 py-1 rounded-full bg-[#EF7B38]/20 text-[#EF7B38] font-title text-[10px] font-bold uppercase tracking-wider">
                Pista #1 · Declamación en Estudio LVT
              </span>
              <span id="deck-origin-badge" class="px-2.5 py-0.5 rounded-full bg-[#C59B27]/20 text-[#F5DEB3] text-[9px] font-title font-bold uppercase">
                Miembro LVT
              </span>
            </div>

            <h3 id="deck-title" class="text-2xl sm:text-3xl font-title font-black text-white leading-tight">
              Oliverio Girondo: «Espantapájaros (1)»
            </h3>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs sm:text-sm text-gray-300 font-sans">
              <div>✍️ <strong>Autor:</strong> <span id="deck-author">Oliverio Girondo</span></div>
              <div>🎙️ <strong>Voz:</strong> <span id="deck-speaker" class="text-[#F5DEB3] font-semibold">Lic. Juan David Pérez Cabrera</span></div>
            </div>

            <p id="deck-desc" class="text-xs sm:text-sm text-gray-300 font-serif italic leading-relaxed mt-2">
              Grabación oficial de estudio en alta fidelidad preservada en el archivo de la Sociedad de Escritores Letras y Voces de Tabasco, A.C.
            </p>
          </div>

          <!-- MÓDULO DE REPRODUCCIÓN SONORA NATIVA HTML5 -->
          <div class="bg-black/80 p-5 rounded-2xl border border-[#EF7B38]/40 space-y-4 shadow-inner">
            
            <div class="flex justify-between items-center text-xs font-mono text-gray-400">
              <span id="deck-audio-status" class="text-[#EF7B38] font-bold flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-pulse"></span>
                <span>Audio Master Listo</span>
              </span>
              <span class="text-gray-400 font-mono">Calidad Estudio 48kHz Stereo</span>
            </div>

            <!-- Elemento de Audio Nativo -->
            <div class="block">
              <audio 
                id="master-audio-element" 
                controls 
                class="w-full rounded-xl" 
                preload="metadata"
                src={`${basePath}/assets/audios/espantapajaros_oliverio_girondo_david_cabrera.mp3`}
              >
                Tu navegador no soporta la reproducción de audio HTML5.
              </audio>
            </div>

            <!-- Controles de Velocidad y Navegación -->
            <div class="flex flex-wrap justify-between items-center gap-2 pt-2 border-t border-gray-800 text-xs">
              
              <!-- Velocidades -->
              <div class="flex items-center gap-1 text-[11px] font-title font-bold text-gray-400">
                <span>Velocidad:</span>
                <button type="button" class="speed-btn px-2 py-0.5 rounded bg-gray-800 text-gray-300 hover:bg-[#EF7B38] hover:text-white transition" data-speed="0.75">0.75x</button>
                <button type="button" class="speed-btn px-2 py-0.5 rounded bg-[#EF7B38] text-white font-bold transition" data-speed="1.0">1.0x</button>
                <button type="button" class="speed-btn px-2 py-0.5 rounded bg-gray-800 text-gray-300 hover:bg-[#EF7B38] hover:text-white transition" data-speed="1.25">1.25x</button>
                <button type="button" class="speed-btn px-2 py-0.5 rounded bg-gray-800 text-gray-300 hover:bg-[#EF7B38] hover:text-white transition" data-speed="1.5">1.5x</button>
              </div>

              <!-- Pistas Anterior / Siguiente -->
              <div class="flex items-center gap-2">
                <button 
                  id="deck-btn-prev" 
                  type="button" 
                  class="px-3 py-1.5 rounded-xl bg-gray-800 hover:bg-[#EF7B38] hover:text-white text-gray-200 font-title text-xs font-bold transition cursor-pointer"
                >
                  ⏮ Anterior
                </button>
                <span id="deck-nav-indicator" class="text-[11px] font-mono text-gray-400">
                  1 / 14
                </span>
                <button 
                  id="deck-btn-next" 
                  type="button" 
                  class="px-3 py-1.5 rounded-xl bg-gray-800 hover:bg-[#EF7B38] hover:text-white text-gray-200 font-title text-xs font-bold transition cursor-pointer"
                >
                  Siguiente ⏭
                </button>
              </div>

            </div>

          </div>

        </div>

        <!-- Panel Derecho: Texto Lírico Completo de la Obra Activa -->
        <div class="lg:col-span-6 space-y-3">
          <div class="flex justify-between items-center pb-2 border-b border-gray-800">
            <span class="font-title font-bold text-xs uppercase text-[#EF7B38] tracking-widest">
              📖 Texto Íntegro de la Obra
            </span>
            <span id="deck-genre-tag" class="text-[10px] font-mono text-gray-400">
              Lírica / Poesía
            </span>
          </div>

          <div class="bg-black/40 border border-[#3A2E26] rounded-2xl p-5 sm:p-6 max-h-[380px] overflow-y-auto">
            <pre id="deck-lyrics" class="font-serif text-sm sm:text-base text-gray-200 whitespace-pre-wrap leading-relaxed selection:bg-[#EF7B38] selection:text-white"></pre>
          </div>
        </div>

      </div>
    </div>

    <!-- ================================================================= -->
    <!-- LISTA Y REJILLA DE LAS 14 GRABACIONES CON FILTRADO EN TIEMPO REAL -->
    <!-- ================================================================= -->
    <div class="space-y-4">
      <div class="flex justify-between items-center">
        <h4 class="text-sm sm:text-base font-title font-bold text-gray-300 uppercase tracking-wider">
          Repertorio de Grabaciones Disponibles
        </h4>
        <span id="track-count-badge" class="text-xs font-mono text-[#EF7B38]">14 Obras Listadas</span>
      </div>

      <div id="tracks-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        {CATALOGO_VOCES_HISTORICAS.map((item, idx) => (
          <div 
            class="track-item bg-[#1C1814] p-4 rounded-2xl border border-[#3A2E26] hover:border-[#EF7B38] transition flex flex-col justify-between space-y-3 cursor-pointer group"
            data-index={idx}
            data-origen={item.origen}
            data-genero={item.genero.includes('Lírica') ? 'lirica' : 'narrativa'}
          >
            <div class="space-y-2">
              <div class="flex justify-between items-start">
                <span class="px-2 py-0.5 rounded-md bg-black/60 text-[#EF7B38] font-mono text-[10px] font-bold">
                  Pista #{item.pista}
                </span>
                <span class={`px-2 py-0.5 rounded text-[9px] font-title font-bold uppercase ${item.origen === 'miembro_lvt' ? 'bg-[#C59B27]/20 text-[#F5DEB3]' : 'bg-gray-800 text-gray-400'}`}>
                  {item.origen === 'miembro_lvt' ? 'Miembro LVT' : 'Universal'}
                </span>
              </div>

              <div>
                <h5 class="text-sm font-title font-bold text-white group-hover:text-[#EF7B38] transition leading-snug">
                  {item.titulo}
                </h5>
                <p class="text-xs font-serif italic text-gray-400 mt-0.5">{item.autor}</p>
              </div>

              <div class="text-[11px] text-gray-500 font-sans truncate">
                🎙️ Voz: <strong class="text-gray-300">{item.declamador}</strong>
              </div>
            </div>

            <div class="pt-2 border-t border-gray-800/80 flex items-center justify-between text-xs">
              <span class="text-[10px] text-gray-500 font-serif italic">{item.genero}</span>
              <button 
                type="button" 
                class="px-3 py-1 rounded-lg bg-[#EF7B38]/20 text-[#EF7B38] group-hover:bg-[#EF7B38] group-hover:text-white font-title text-[10px] font-bold uppercase tracking-wider transition"
              >
                Cargar & Escuchar ▶
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- DATOS JSON INLINE PARA SINCRONIZACIÓN INSTANTÁNEA -->
<script id="voces-data-json" type="application/json" set:html={JSON.stringify(CATALOGO_VOCES_HISTORICAS)}></script>

<script is:inline>
  (function initVocesPlayer() {
    var rawData = document.getElementById('voces-data-json');
    if (!rawData) return;
    var catalogo = JSON.parse(rawData.textContent || '[]');
    if (!catalogo.length) return;

    var currentIndex = 0;
    var audioElement = document.getElementById('master-audio-element');
    var badgeEl = document.getElementById('deck-badge');
    var originBadgeEl = document.getElementById('deck-origin-badge');
    var titleEl = document.getElementById('deck-title');
    var authorEl = document.getElementById('deck-author');
    var speakerEl = document.getElementById('deck-speaker');
    var descEl = document.getElementById('deck-desc');
    var lyricsEl = document.getElementById('deck-lyrics');
    var genreTagEl = document.getElementById('deck-genre-tag');
    var navIndicator = document.getElementById('deck-nav-indicator');
    var statusEl = document.getElementById('deck-audio-status');
    var prevBtn = document.getElementById('deck-btn-prev');
    var nextBtn = document.getElementById('deck-btn-next');
    var speedBtns = document.querySelectorAll('.speed-btn');
    var filterBtns = document.querySelectorAll('.filter-audio-btn');
    var trackItems = document.querySelectorAll('.track-item');
    var trackCountBadge = document.getElementById('track-count-badge');

    function loadTrack(index, autoplay) {
      if (index < 0) index = 0;
      if (index >= catalogo.length) index = catalogo.length - 1;
      currentIndex = index;
      var track = catalogo[currentIndex];

      if (badgeEl) badgeEl.innerText = 'Pista #' + track.pista + ' · ' + track.pais;
      if (originBadgeEl) {
        originBadgeEl.innerText = track.origen === 'miembro_lvt' ? '🌟 Miembro LVT' : '🌍 Universal';
      }
      if (titleEl) titleEl.innerText = track.autor + ': «' + track.titulo + '»';
      if (authorEl) authorEl.innerText = track.autor;
      if (speakerEl) speakerEl.innerText = track.declamador;
      if (descEl) descEl.innerText = track.descripcion;
      if (lyricsEl) lyricsEl.innerText = track.textoPoema;
      if (genreTagEl) genreTagEl.innerText = track.genero;
      if (navIndicator) navIndicator.innerText = (currentIndex + 1) + ' / ' + catalogo.length;

      if (audioElement) {
        audioElement.src = track.audioUrl;
        audioElement.load();
        if (autoplay) {
          audioElement.play().catch(function() {});
        }
      }

      // Highlight active card
      trackItems.forEach(function(el, i) {
        if (i === currentIndex) {
          el.classList.add('border-[#EF7B38]', 'bg-[#25201B]');
        } else {
          el.classList.remove('border-[#EF7B38]', 'bg-[#25201B]');
        }
      });
    }

    // Prev / Next
    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        var prevIdx = (currentIndex - 1 + catalogo.length) % catalogo.length;
        loadTrack(prevIdx, true);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        var nextIdx = (currentIndex + 1) % catalogo.length;
        loadTrack(nextIdx, true);
      });
    }

    // Speed controls
    speedBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var speed = parseFloat(btn.getAttribute('data-speed') || '1.0');
        if (audioElement) audioElement.playbackRate = speed;
        speedBtns.forEach(function(b) {
          b.classList.remove('bg-[#EF7B38]', 'text-white', 'font-bold');
          b.classList.add('bg-gray-800', 'text-gray-300');
        });
        btn.classList.remove('bg-gray-800', 'text-gray-300');
        btn.classList.add('bg-[#EF7B38]', 'text-white', 'font-bold');
      });
    });

    // Track click
    trackItems.forEach(function(card) {
      card.addEventListener('click', function() {
        var idx = parseInt(card.getAttribute('data-index') || '0', 10);
        loadTrack(idx, true);
      });
    });

    // Filters
    filterBtns.forEach(function(fBtn) {
      fBtn.addEventListener('click', function() {
        var filter = fBtn.getAttribute('data-filter');
        filterBtns.forEach(function(b) {
          b.classList.remove('bg-[#EF7B38]', 'text-white', 'border-[#EF7B38]');
          b.classList.add('bg-[#25201B]', 'text-gray-300', 'border-gray-700');
        });
        fBtn.classList.remove('bg-[#25201B]', 'text-gray-300', 'border-gray-700');
        fBtn.classList.add('bg-[#EF7B38]', 'text-white', 'border-[#EF7B38]');

        var visibleCount = 0;
        trackItems.forEach(function(item) {
          var itemOrigen = item.getAttribute('data-origen');
          var itemGenero = item.getAttribute('data-genero');

          var match = false;
          if (filter === 'all') match = true;
          else if (filter === 'miembro_lvt' && itemOrigen === 'miembro_lvt') match = true;
          else if (filter === 'externo_universal' && itemOrigen === 'externo_universal') match = true;
          else if (filter === 'lirica' && itemGenero === 'lirica') match = true;
          else if (filter === 'narrativa' && itemGenero === 'narrativa') match = true;

          if (match) {
            item.style.display = 'flex';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (trackCountBadge) {
          trackCountBadge.innerText = visibleCount + ' Obras Filtradas';
        }
      });
    });

    // Initial load
    loadTrack(0, false);
  })();
</script>
