      youtubeId: '6C1H-X8v7F0'
    },
    {
      author: 'Octavio Paz',
      title: 'Piedra de Sol (Fragmento en Voz Propia)',
      country: 'México',
      tag: 'Premio Nobel de Literatura',
      desc: 'Octavio Paz leyendo fragmentos de su poema monumental «Piedra de Sol».',
