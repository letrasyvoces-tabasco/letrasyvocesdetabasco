  // Elementos de UI
  let currentWork = catalog[0];
  let isPlaying = false;
  let currentRate = 0.86;
  let synthUtterance: SpeechSynthesisUtterance | null = null;

  const pTitle = document.getElementById('player-title');
  const pAuthor = document.getElementById('player-author');
  const pFullText = document.getElementById('player-full-text');
  const pTypeBadge = document.getElementById('player-type-text');
  const pCountryText = document.getElementById('player-country-text');
  const pDeclaimerInfo = document.getElementById('player-declaimer-info');
  const pYtLink = document.getElementById('player-yt-link') as HTMLAnchorElement;
  const playBtn = document.getElementById('btn-play-pause');
  const iconPlay = document.getElementById('icon-play');
  const iconPause = document.getElementById('icon-pause');
  const waveBars = document.querySelectorAll('.wave-bar');
  const poetsGrid = document.getElementById('poets-grid');
  const searchInput = document.getElementById('search-poet-input') as HTMLInputElement;
  const rateBtns = document.querySelectorAll('.rate-btn');

  // Renderizar Cuadrícula de Poetas
  function renderGrid(filterText = '') {
    if (!poetsGrid) return;
    const cleanFilter = filterText.toLowerCase().trim();

    const filtered = catalog.filter(p => 
      p.author.toLowerCase().includes(cleanFilter) ||
      p.title.toLowerCase().includes(cleanFilter) ||
      p.country.toLowerCase().includes(cleanFilter)
    );

    if (filtered.length === 0) {
      poetsGrid.innerHTML = `<div class="col-span-full py-8 text-center text-gray-400 text-xs font-light">No se encontraron poemas con el término «${filterText}».</div>`;
      return;
    }

    poetsGrid.innerHTML = filtered.map((item) => `
      <button 
        type="button" 
        class="poet-card p-4 rounded-2xl bg-gray-900/80 border ${item.id === currentWork.id ? 'border-terracota bg-gray-800' : 'border-gray-800'} text-left hover:border-dorado transition shadow-subtle flex flex-col justify-between group cursor-pointer"
        data-pid="${item.id}"
      >
        <div>
          <span class="text-[9px] font-title font-bold text-dorado uppercase block mb-1 truncate">${item.country}</span>
          <h5 class="font-serif text-base font-bold text-white leading-tight group-hover:text-dorado transition truncate">${item.author}</h5>
          <p class="text-xs text-gray-300 font-light truncate mt-1">«${item.title}»</p>
        </div>
        <div class="pt-3 mt-3 border-t border-gray-800/80 flex items-center justify-between">
          <span class="text-[9px] text-gray-400 font-mono">${item.category.substring(0, 24)}...</span>
          <span class="text-[9px] font-title font-bold text-terracota uppercase tracking-wider group-hover:underline">▶ Cargar Obra</span>
        </div>
      </button>
    `).join('');

    document.querySelectorAll('.poet-card').forEach(card => {
      card.addEventListener('click', () => {
        const pid = card.getAttribute('data-pid');
        const found = catalog.find(c => c.id === pid);
        if (found) {
          loadWork(found);
          startPlayback();
          renderGrid(searchInput?.value || '');
        }
      });
    });
  }

  function loadWork(w: PoeticWork) {
    currentWork = w;
    if (pTitle) pTitle.innerText = w.title;
    if (pAuthor) pAuthor.innerText = `Autor: ${w.author} · ${w.category}`;
    if (pFullText) pFullText.innerText = w.fullText;
    if (pTypeBadge) pTypeBadge.innerText = w.declaimerBadge;
    if (pCountryText) pCountryText.innerText = w.country;
    if (pDeclaimerInfo) {
      pDeclaimerInfo.innerHTML = `Intérprete: <strong class="text-gray-200">${w.declaimerName}</strong> · <em>Preparado para masterización en estudio LVT</em>`;
    }
    if (pYtLink) {
      pYtLink.href = `https://www.youtube.com/results?search_query=${encodeURIComponent(w.youtubeSearchQuery)}`;
    }
  }

  function setWave(active: boolean) {
    waveBars.forEach((bar, i) => {
      if (active) {
        (bar as HTMLElement).style.animation = `pulse 0.7s infinite alternate ${(i * 0.08).toFixed(2)}s`;
      } else {
        (bar as HTMLElement).style.animation = 'none';
      }
    });
  }

  function stopPlayback() {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    isPlaying = false;
    iconPlay?.classList.remove('hidden');
    iconPause?.classList.add('hidden');
    setWave(false);
  }

  function startPlayback() {
    stopPlayback();
    if ('speechSynthesis' in window) {
      synthUtterance = new SpeechSynthesisUtterance(currentWork.fullText);
      synthUtterance.lang = 'es-MX';
      synthUtterance.rate = currentRate;
      synthUtterance.pitch = 0.92;

      const voices = window.speechSynthesis.getVoices();
      const esVoice = voices.find(v => v.lang.startsWith('es-MX') || v.lang.startsWith('es-'));
      if (esVoice) synthUtterance.voice = esVoice;

      synthUtterance.onend = () => stopPlayback();
      synthUtterance.onerror = () => stopPlayback();

      window.speechSynthesis.speak(synthUtterance);
      isPlaying = true;
      iconPlay?.classList.add('hidden');
      iconPause?.classList.remove('hidden');
      setWave(true);
    }
  }

  playBtn?.addEventListener('click', () => {
    if (isPlaying) {
      stopPlayback();
    } else {
      startPlayback();
    }
  });

  // Selector de Velocidad
  rateBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      rateBtns.forEach(b => {
        b.className = "rate-btn px-3 py-1 rounded-full text-xs bg-gray-800 text-gray-400 hover:text-white";
      });
      btn.className = "rate-btn px-3 py-1 rounded-full text-xs bg-terracota text-white font-bold";
      currentRate = parseFloat(btn.getAttribute('data-rate') || '0.86');
      if (isPlaying) {
        startPlayback();
      }
    });
  });

  // Búsqueda en vivo
  searchInput?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value;
    renderGrid(val);
  });

  // Inicialización
  renderGrid();
</script>
