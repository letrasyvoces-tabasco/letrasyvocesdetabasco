---
// VocesDeTabasco.astro - Fonoteca Histórica (Voces Reales en YouTube) y Sala Lírica de Declamación
---

<section id="voces" class="py-28 hero-bg text-white relative overflow-hidden border-b border-gray-800">
  
  <!-- Resplandor sutil de fondo -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-terracota/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-dorado/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-dorado/15 border border-dorado/30 text-dorado-light font-title text-[11px] font-bold uppercase tracking-widest mb-3 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-terracota animate-ping"></span>
        <span>Fonoteca Histórica & Dimensión Sonora</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white">
        Voces y Poesía de Nuestra Historia
      </h2>
      <p class="text-sm sm:text-base text-gray-300 mt-3 font-light leading-relaxed">
        Escucha a los grandes maestros de la literatura universal declamando sus propias obras en grabaciones históricas reales, o explora la sala interactiva de textos poéticos.
      </p>
      <div class="w-20 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- CONMUTADOR MAESTRO DE MODOS (UNO U OTRO) -->
    <div class="flex justify-center mb-12">
      <div class="inline-flex flex-wrap justify-center p-1.5 rounded-full bg-black/60 border border-gray-700 backdrop-blur-xl shadow-2xl gap-2">
        <button 
          id="btn-mode-real" 
          type="button" 
          class="px-6 sm:px-8 py-3 rounded-full text-xs font-title font-bold uppercase tracking-wider bg-terracota text-white shadow-lg transition duration-300 flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>🎙️ Fonoteca de Voces Reales (Videos)</span>
        </button>

        <button 
          id="btn-mode-synth" 
          type="button" 
          class="px-6 sm:px-8 py-3 rounded-full text-xs font-title font-bold uppercase tracking-wider text-gray-300 hover:text-white transition duration-300 flex items-center gap-2"
        >
          <span>📖 Sala Lírica & Declamación (23 Autores)</span>
        </button>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- MODO 1: FONOTECA HISTÓRICA EN VIDEO (VOCES REALES DE AUTORES)      -->
    <!-- ================================================================= -->
    <div id="view-mode-real" class="tab-content-active max-w-5xl mx-auto">
      
      <!-- Reproductor Central de Videos de YouTube con Voces Reales -->
      <div class="bg-carbon-card/90 border border-gray-700/80 rounded-3xl p-6 sm:p-10 backdrop-blur-2xl shadow-2xl mb-8">
        
        <!-- Ficha Superior del Video -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-gray-800 mb-6">
          <div>
            <div class="flex items-center gap-2.5 mb-1.5">
              <span id="real-badge-tag" class="px-3 py-1 rounded-full bg-red-950/80 border border-red-700/60 text-red-300 text-[10px] font-title font-bold uppercase tracking-widest flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
                Voz Real del Autor
              </span>
              <span id="real-author-country" class="text-xs text-dorado-light font-mono">
                Tabasco, México · Archivo Histórico
              </span>
            </div>
            <h3 id="real-video-title" class="font-serif text-2xl sm:text-3xl font-bold text-white leading-tight">
              Carlos Pellicer — «Discurso por las Flores» (Voz Propia)
            </h3>
            <p id="real-video-desc" class="text-xs text-gray-400 font-light mt-1">
              Grabación histórica del poeta tabasqueño de América declamando sus versos emblemáticos.
            </p>
          </div>

          <!-- Controles Anterior / Siguiente -->
          <div class="flex items-center gap-2 shrink-0">
            <button 
              id="btn-prev-real" 
              type="button" 
              class="p-3 rounded-full bg-black/60 border border-gray-700 text-gray-300 hover:text-white hover:bg-gray-800 transition shadow-subtle flex items-center justify-center cursor-pointer"
              aria-label="Video anterior"
              title="Anterior"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
            </button>
            <button 
              id="btn-next-real" 
              type="button" 
              class="p-3 rounded-full bg-black/60 border border-gray-700 text-gray-300 hover:text-white hover:bg-gray-800 transition shadow-subtle flex items-center justify-center cursor-pointer"
              aria-label="Video siguiente"
              title="Siguiente"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Contenedor del Iframe de YouTube (Proporción 16:9) -->
        <div class="relative w-full aspect-video rounded-2xl overflow-hidden bg-black/90 border border-gray-800 shadow-2xl">
          <iframe 
            id="real-youtube-iframe"
            class="w-full h-full object-cover"
            src="https://www.youtube-nocookie.com/embed/gq3_bO6K3_Q?rel=0" 
            title="Grabación histórica de poesía"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen
          ></iframe>
        </div>

      </div>

      <!-- Carrusel / Tira Deslizable de Selección de Voces Reales -->
      <div class="space-y-3">
        <div class="flex justify-between items-center px-1">
          <span class="text-xs font-title font-bold uppercase tracking-wider text-dorado-light">
            Catálogo de Grabaciones Históricas Disponibles
          </span>
          <span class="text-[11px] text-gray-400 font-light">
            Desplaza para elegir autor
          </span>
        </div>

        <div id="real-voices-tracklist" class="flex gap-3 overflow-x-auto pb-4 pt-1 scrollbar-thin scrollbar-thumb-gray-700">
          <!-- Tarjetas dinámicas de videos reales -->
        </div>
      </div>

    </div>

    <!-- ================================================================= -->
    <!-- MODO 2: SALA LÍRICA & TEXTOS DE DECLAMACIÓN (23 AUTORES)           -->
    <!-- ================================================================= -->
    <div id="view-mode-synth" class="hidden max-w-5xl mx-auto">
      
      <!-- Reproductor de Texto y Onda de Audio -->
      <div class="bg-carbon-card/85 border border-gray-700/80 rounded-3xl p-6 sm:p-10 backdrop-blur-2xl shadow-2xl mb-10">
        <div class="grid lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-7 space-y-4">
            <div class="flex items-center gap-3">
              <span id="synth-cat-badge" class="px-3 py-1 rounded-full bg-terracota/20 border border-terracota/40 text-terracota text-[10px] font-title font-bold uppercase tracking-widest">
                Lírica Tabasqueña
              </span>
              <span id="synth-country-badge" class="text-xs text-dorado-light font-mono">Villahermosa, Tabasco</span>
            </div>

            <h3 id="synth-poem-title" class="font-serif text-2xl sm:text-3xl font-bold text-white leading-tight">
              Elegía al Río Grijalva y la Selva
            </h3>

            <p id="synth-poem-author" class="text-xs font-title text-gray-300 uppercase tracking-wider font-semibold">
              Autor: Mtra. Eva Guadalupe Pineda Cruz · Letras y Voces de Tabasco
            </p>

            <div class="p-6 rounded-2xl bg-black/50 border border-gray-800 text-gray-200 font-serif text-base sm:text-lg leading-relaxed max-h-60 overflow-y-auto space-y-3">
              <div id="synth-poem-text" class="whitespace-pre-line italic">
                «En el trópico húmedo la palabra no se escribe: brota como mangle y canta como agua viva.
                
                El agua no olvida el curso de los siglos; en cada remolino navega la palabra de los antiguos navegantes, tejiendo la luz del amanecer sobre el follaje esmeralda.
                
                Bajo la sombra del guayacán florecido,
                el ojo del reptil vigila el río:
                no hay tiempo en el pantano, solo canto.»
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 flex flex-col items-center justify-center space-y-6 bg-black/40 p-6 sm:p-8 rounded-2xl border border-gray-800">
            <!-- Onda Sonora -->
            <div class="flex items-center justify-center gap-1.5 h-16 w-full px-2">
              <span class="wave-bar w-1.5 bg-terracota rounded-full h-3"></span>
              <span class="wave-bar w-1.5 bg-dorado rounded-full h-8"></span>
              <span class="wave-bar w-1.5 bg-terracota rounded-full h-12"></span>
              <span class="wave-bar w-1.5 bg-dorado rounded-full h-6"></span>
              <span class="wave-bar w-1.5 bg-terracota rounded-full h-16"></span>
              <span class="wave-bar w-1.5 bg-dorado rounded-full h-10"></span>
              <span class="wave-bar w-1.5 bg-terracota rounded-full h-4"></span>
              <span class="wave-bar w-1.5 bg-dorado rounded-full h-14"></span>
              <span class="wave-bar w-1.5 bg-terracota rounded-full h-8"></span>
              <span class="wave-bar w-1.5 bg-dorado rounded-full h-12"></span>
              <span class="wave-bar w-1.5 bg-terracota rounded-full h-5"></span>
            </div>

            <!-- Botón Central de Reproducción -->
            <div class="flex items-center gap-4">
              <button 
                id="synth-play-btn" 
                type="button" 
                class="w-16 h-16 rounded-full bg-terracota hover:bg-terracota-hover text-white flex items-center justify-center shadow-xl hover:scale-105 transition transform cursor-pointer"
                aria-label="Declamar poema"
              >
                <svg id="s-play-icon" class="w-8 h-8 fill-current translate-x-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <svg id="s-pause-icon" class="w-8 h-8 fill-current hidden" viewBox="0 0 24 24">
                  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                </svg>
              </button>
            </div>

            <span class="text-[10px] text-gray-400 font-light text-center">
              Declamación asistida con modulación teatral
            </span>
          </div>

        </div>
      </div>

      <!-- Cuadrícula de Selección de los 23 Poetas -->
      <div class="space-y-4">
        <span class="text-xs font-title font-bold uppercase tracking-widest text-dorado-light block">
          Padrón de Obras & Poetas Disponibles (23 Obras)
        </span>
        <div id="synth-authors-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 max-h-96 overflow-y-auto pr-2 scrollbar-thin scrollbar-thumb-gray-700">
          <!-- Inyectado dinámicamente -->
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // ==========================================
  // DATOS DE LA FONOTECA HISTÓRICA (VIDEOS REALES)
  // ==========================================
  interface RealVoiceItem {
    author: string;
    title: string;
    country: string;
    tag: string;
    desc: string;
    youtubeId: string;
  }

  const realVoiceList: RealVoiceItem[] = [
    {
      author: 'Carlos Pellicer',
      title: 'Discurso por las Flores (Declamación)',
