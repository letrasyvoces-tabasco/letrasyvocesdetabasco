---
// VocesDeTabasco.astro - Gran Audioteca Institucional & Sala Lírica de Declamaciones
import { CATALOGO_VOCES_HISTORICAS } from '../data/voces';
const basePath = "/letrasyvocesdetabasco";
---

<section id="voces" class="py-20 sm:py-28 bg-[#181818] text-white relative overflow-hidden border-b border-gray-800">
  
  <!-- Resplandores ambientales de fondo -->
  <div class="absolute -top-40 -left-40 w-72 sm:w-96 h-72 sm:h-96 bg-[#EF7B38]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-72 sm:w-96 h-72 sm:h-96 bg-[#B8860B]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#B8860B]/15 border border-[#B8860B]/30 text-[#F5DEB3] font-title text-[10px] sm:text-[11px] font-bold uppercase tracking-widest mb-3 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-ping"></span>
        <span>Audioteca Patrimonial & Sala Lírica de Declamación</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-title font-black text-white">
        Voces y Poesía de Nuestra Historia
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-gray-300 mt-3 font-serif italic leading-relaxed">
        Grabaciones de estudio oficiales de LVT, registros sonoros históricos de los grandes autores iberoamericanos y sala interactiva con declamación sonora multivoz.
      </p>
      <div class="w-20 h-0.5 bg-[#EF7B38] mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- ================================================================= -->
    <!-- 1. GRABACIÓN DE ESTUDIO OFICIAL LVT: OLIVERIO GIRONDO             -->
    <!-- ================================================================= -->
    <div class="bg-gradient-to-br from-[#2D1B13] via-[#222222] to-[#1A1A1A] border-2 border-[#EF7B38]/60 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden mb-12">
      <div class="absolute -right-20 -top-20 w-64 h-64 bg-[#EF7B38]/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 rounded-full bg-[#EF7B38] text-white text-[10px] font-title font-bold uppercase tracking-widest shadow-sm">
              🎙️ Grabación Oficial de Estudio LVT
            </span>
            <span class="text-xs text-[#F5DEB3] font-mono">
              Voz: Lic. Juan David Pérez Cabrera
            </span>
          </div>

          <h3 class="font-title font-black text-2xl sm:text-4xl text-white leading-tight">
            «Espantapájaros (1)» — Oliverio Girondo
          </h3>
          
          <p class="text-xs sm:text-sm text-gray-300 font-serif italic leading-relaxed">
            Grabación oficial en alta fidelidad preservada en el archivo de audio de la Sociedad de Escritores Letras y Voces de Tabasco, A.C.
          </p>

          <!-- Reproductor de Audio HTML5 -->
          <div class="bg-black/70 p-4 rounded-2xl border border-[#EF7B38]/40 space-y-2">
            <div class="flex justify-between items-center text-xs font-mono text-gray-400">
              <span class="text-[#EF7B38] font-bold">Audio Master Oficial (03:28)</span>
              <span>Calidad Estudio 48kHz Stereo</span>
            </div>
            <audio controls class="w-full rounded-lg" preload="metadata">
              <source src={`${basePath}/assets/audios/espantapajaros_oliverio_girondo_david_cabrera.mp3`} type="audio/mpeg" />
              <source src={`${basePath}/assets/audios/espantapajaros_oliverio_girondo_david_cabrera.m4a`} type="audio/mp4" />
              Tu navegador no soporta la reproducción de audio HTML5.
            </audio>
          </div>
        </div>

        <!-- Muestra de Texto del Poema Espantapájaros -->
        <div class="lg:col-span-5 bg-black/50 p-6 rounded-2xl border border-gray-800 max-h-80 overflow-y-auto space-y-2 text-xs font-serif leading-relaxed text-gray-200 scrollbar-thin">
          <div class="font-title font-bold text-[10px] uppercase text-[#EF7B38] tracking-widest pb-1 border-b border-gray-800">
            Texto Íntegro · Oliverio Girondo (1932)
          </div>
          <p class="italic text-gray-300">
            No se me importa un pito que las mujeres<br/>
            tengan los senos como magnolias o como pasas de higo;<br/>
            un cutis de durazno o de papel de lija.<br/>
            Le doy una importancia igual a cero,<br/>
            al hecho de que amanezcan con un aliento afrodisíaco<br/>
            o con un aliento insecticida.<br/>
            Soy perfectamente capaz de soportarles<br/>
            una nariz que sacaría el primer premio<br/>
            en una exposición de zanahorias;<br/>
            ¡pero eso sí! -y en esto soy irreductible-<br/>
            no les perdono, bajo ningún pretexto, que no sepan volar.<br/>
            Si no saben volar ¡pierden el tiempo las que pretendan seducirme!<br/>
            Ésta fue -y no otra- la razón de que me enamorase,<br/>
            tan locamente, de María Luisa.<br/>
            ¿Qué me importaban sus labios por entregas y sus encelos sulfurosos?<br/>
            ¿Qué me importaban sus extremidades de palmípedo<br/>
            y sus miradas de pronóstico reservado?<br/>
            ¡María Luisa era una verdadera pluma!<br/>
            Desde el amanecer volaba del dormitorio a la cocina,<br/>
            volaba del comedor a la despensa.<br/>
            Volando me preparaba el baño, la camisa.<br/>
            Volando realizaba sus compras, sus quehaceres...<br/>
            ¡Con qué impaciencia yo esperaba que volviese, volando,<br/>
            de algún paseo por los alrededores!<br/>
            Allí lejos, perdido entre las nubes, un puntito rosado.<br/>
            "¡María Luisa! ¡María Luisa!"... y a los pocos segundos,<br/>
            ya me abrazaba con sus piernas de pluma,<br/>
            para llevarme, volando, a cualquier parte.<br/>
            Durante kilómetros de silencio planeábamos una caricia<br/>
            que nos aproximaba al paraíso;<br/>
            durante horas enteras nos anidábamos en una nube,<br/>
            como dos ángeles, y de repente,<br/>
            en tirabuzón, en hoja muerta,<br/>
            el aterrizaje forzoso de un espasmo.<br/>
            ¡Qué delicia la de tener una mujer tan ligera...,<br/>
            aunque nos haga ver, de vez en cuando, las estrellas!<br/>
            ¡Que voluptuosidad la de pasarse los días entre las nubes...<br/>
            la de pasarse las noches de un solo vuelo!<br/>
            Después de conocer una mujer etérea,<br/>
            ¿puede brindarnos alguna clase de atractivos una mujer terrestre?<br/>
            ¿Verdad que no hay diferencia sustancial<br/>
            entre vivir con una vaca o con una mujer<br/>
            que tenga las nalgas a setenta y ocho centímetros del suelo?<br/>
            Yo, por lo menos, soy incapaz de comprender<br/>
            la seducción de una mujer pedestre,<br/>
            y por más empeño que ponga en concebirlo,<br/>
            no me es posible ni tan siquiera imaginar<br/>
            que pueda hacerse el amor más que volando.
          </p>
        </div>

      </div>
    </div>

    <!-- ================================================================= -->
    <!-- 2. AUDIOTECA PATRIMONIAL: 13 REGISTROS SONOROS HISTÓRICOS         -->
    <!-- ================================================================= -->
    <div class="mb-14">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6 pb-3 border-b border-gray-800">
        <div>
          <span class="text-xs font-title font-bold uppercase tracking-widest text-[#EF7B38]">Registros Sonoros Auténticos</span>
          <h3 class="text-2xl sm:text-3xl font-title font-bold text-white mt-0.5">Audioteca de Autores y Grandes Voces</h3>
        </div>
        <span class="text-xs text-gray-400 font-mono">13 Grabaciones Seleccionadas</span>
      </div>

      <!-- Reproductor Activo de Audio Histórico -->
      <div id="active-audio-deck" class="bg-[#242424] p-6 sm:p-8 rounded-3xl border border-gray-700 shadow-2xl mb-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          
          <div class="lg:col-span-8 space-y-3">
            <div class="flex flex-wrap items-center gap-2">
              <span id="deck-badge" class="px-2.5 py-0.5 rounded-full bg-red-950 text-red-300 border border-red-800 text-[10px] font-title font-bold uppercase tracking-wider">
                Voz del Autor
              </span>
              <span id="deck-pais" class="text-xs text-[#F5DEB3] font-mono">Jalisco, México</span>
            </div>
            
            <h4 id="deck-titulo" class="text-2xl sm:text-3xl font-title font-black text-white">
              Juan Rulfo — «En el hidrante las gotas»
            </h4>
            
            <p id="deck-declamador" class="text-xs font-title font-bold text-[#EF7B38]">
              Declamación: Juan Rulfo (Voz del Autor)
            </p>
            
            <p id="deck-desc" class="text-xs sm:text-sm text-gray-400 font-serif italic leading-relaxed">
              Grabación histórica con la voz pausada, misteriosa y profunda del maestro Juan Rulfo.
            </p>

            <!-- Widget Embebido de Audio / YouTube en formato compacto -->
            <div class="pt-3">
              <iframe 
                id="audio-deck-iframe"
                class="w-full h-24 sm:h-28 rounded-2xl bg-black border border-gray-800"
                src="https://www.youtube-nocookie.com/embed/A8PMbJBfn60?rel=0&modestbranding=1&controls=1" 
                title="Reproductor de Audio Histórico"
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              ></iframe>
            </div>
          </div>

          <!-- Acceso Directo y Botón de Respaldo -->
          <div class="lg:col-span-4 bg-black/40 p-5 rounded-2xl border border-gray-800 flex flex-col justify-between space-y-4">
            <div class="space-y-1">
              <span class="text-[10px] font-title font-bold text-gray-400 uppercase tracking-wider block">Fuente Oficial</span>
              <p class="text-xs text-gray-300 font-serif italic">
                Grabación preservada en colecciones sonoras de poesía iberoamericana.
              </p>
            </div>
            
            <a 
              id="deck-direct-link"
              href="https://youtu.be/A8PMbJBfn60?list=PLkBildazp7OBfnh4eahKj91MQXiaumTer"
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-title text-xs font-bold uppercase tracking-wider transition flex items-center justify-center gap-1.5 shadow-sm"
            >
              <span>Escuchar en YouTube ↗</span>
            </a>
          </div>

        </div>
      </div>

      <!-- Cuadrícula de las 13 Grabaciones Históricas -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {CATALOGO_VOCES_HISTORICAS.slice(1).map((item, index) => (
          <div 
            class={`audio-card bg-[#242424] p-5 rounded-2xl border border-gray-700/80 hover:border-[#EF7B38] transition-all cursor-pointer flex flex-col justify-between ${index === 0 ? 'ring-1 ring-[#EF7B38]' : ''}`}
            data-index={index + 1}
            data-id={item.youtubeId}
            data-titulo={`${item.autor} — «${item.titulo}»`}
            data-declamador={`Declamación: ${item.declamador}`}
            data-pais={item.pais}
            data-desc={item.descripcion}
          >
            <div class="space-y-2">
              <div class="flex justify-between items-start">
                <span class="px-2 py-0.5 rounded-md bg-black/60 text-[#EF7B38] text-[9px] font-title font-bold uppercase tracking-wider">
                  Audio #{index + 1}
                </span>
                <span class="text-[10px] font-mono text-gray-400 truncate max-w-[120px]">{item.pais.split('/')[0]}</span>
              </div>
              <h5 class="font-title font-bold text-sm text-white leading-snug">{item.titulo}</h5>
              <p class="text-xs text-[#F5DEB3] font-serif italic">{item.autor}</p>
              <p class="text-[11px] text-gray-400 font-sans line-clamp-2">{item.declamador}</p>
            </div>

            <div class="mt-4 pt-2 border-t border-gray-800 flex justify-between items-center">
              <span class="text-[10px] font-title font-bold text-[#EF7B38] uppercase">Cargar Audio</span>
              <span class="text-xs text-gray-400">▶</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- 3. SALA LÍRICA: DECLAMACIÓN ASISTIDA MULTIVOZ & VELOCIDADES        -->
    <!-- ================================================================= -->
    <div class="bg-[#242424] p-6 sm:p-8 rounded-3xl border border-gray-700/80 shadow-2xl space-y-6">
      
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pb-4 border-b border-gray-800">
        <div>
          <span class="text-xs font-title font-bold uppercase tracking-widest text-[#B8860B]">Sala de Lectura Asistida</span>
          <h3 class="text-xl sm:text-2xl font-title font-bold text-white mt-0.5">Exploración de Textos con Modulación de Voz</h3>
        </div>

        <!-- Controles de Voz y Velocidad -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-2">
            <span class="text-xs font-title font-bold text-gray-400 uppercase">Voz:</span>
            <select 
              id="voice-select" 
              class="px-3 py-1.5 rounded-xl bg-black/60 border border-gray-700 text-xs font-title text-white focus:outline-none focus:border-[#EF7B38]"
            >
              <option value="default">Voz Predeterminada (Español)</option>
            </select>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-xs font-title font-bold text-gray-400 uppercase">Velocidad:</span>
            <div class="inline-flex rounded-xl bg-black/60 border border-gray-700 p-1 gap-1">
              <button type="button" class="speed-btn active px-2.5 py-0.5 rounded-lg text-xs font-title font-bold bg-[#EF7B38] text-white" data-speed="0.85">0.85x</button>
              <button type="button" class="speed-btn px-2.5 py-0.5 rounded-lg text-xs font-title font-bold text-gray-300 hover:text-white" data-speed="1.0">1.0x</button>
              <button type="button" class="speed-btn px-2.5 py-0.5 rounded-lg text-xs font-title font-bold text-gray-300 hover:text-white" data-speed="1.15">1.15x</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Cuadrícula de Poemas de Lectura -->
      <div id="reading-poemas-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Inyectado dinámicamente -->
      </div>

    </div>

  </div>
</section>

<script>
  // Gestor del Reproductor Activo de Audio Histórico
  const deckIframe = document.getElementById('audio-deck-iframe') as HTMLIFrameElement;
  const deckTitulo = document.getElementById('deck-titulo');
  const deckDeclamador = document.getElementById('deck-declamador');
  const deckPais = document.getElementById('deck-pais');
  const deckDesc = document.getElementById('deck-desc');
  const deckLink = document.getElementById('deck-direct-link') as HTMLAnchorElement;
  const cards = document.querySelectorAll('.audio-card');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      cards.forEach(c => c.classList.remove('ring-1', 'ring-[#EF7B38]'));
      card.classList.add('ring-1', 'ring-[#EF7B38]');

      const yId = card.getAttribute('data-id');
      const titulo = card.getAttribute('data-titulo');
      const declamador = card.getAttribute('data-declamador');
      const pais = card.getAttribute('data-pais');
      const desc = card.getAttribute('data-desc');

      if (deckIframe && yId) {
        deckIframe.src = `https://www.youtube-nocookie.com/embed/${yId}?rel=0&modestbranding=1&controls=1&autoplay=1`;
      }
      if (deckTitulo && titulo) deckTitulo.innerText = titulo;
      if (deckDeclamador && declamador) deckDeclamador.innerText = declamador;
      if (deckPais && pais) deckPais.innerText = pais;
      if (deckDesc && desc) deckDesc.innerText = desc;
      if (deckLink && yId) deckLink.href = `https://www.youtube.com/watch?v=${yId}`;
    });
  });

  // Motor de Declamación Asistida con Múltiples Voces
  let currentSpeed = 0.85;
  let synthVoices: SpeechSynthesisVoice[] = [];
  const voiceSelect = document.getElementById('voice-select') as HTMLSelectElement;

  function loadVoices() {
    if ('speechSynthesis' in window) {
      synthVoices = window.speechSynthesis.getVoices().filter(v => v.lang.startsWith('es'));
      if (voiceSelect && synthVoices.length > 0) {
        voiceSelect.innerHTML = synthVoices.map((v, i) => `<option value="${i}">${v.name} (${v.lang})</option>`).join('');
      }
    }
  }

  if ('speechSynthesis' in window) {
    speechSynthesis.onvoiceschanged = loadVoices;
    loadVoices();
  }

  const speedBtns = document.querySelectorAll('.speed-btn');
  speedBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      speedBtns.forEach(b => {
        b.classList.remove('bg-[#EF7B38]', 'text-white');
        b.classList.add('text-gray-300');
      });
      btn.classList.remove('text-gray-300');
      btn.classList.add('bg-[#EF7B38]', 'text-white');
      currentSpeed = parseFloat(btn.getAttribute('data-speed') || '0.85');
    });
  });

  // Poemas de la Sala de Lectura
  const POEMAS_LECTURA = [
    { autor: "Carlos Pellicer", obra: "Discurso por las flores", texto: "El pueblo de las flores es un pueblo de santos y de poetas. La orquídea es el pensamiento de la selva y el loto es la plegaria del agua. En Tabasco el agua y la lumbre inventaron el color verde." },
    { autor: "José Gorostiza", obra: "Muerte sin fin (Fragmento)", texto: "Lleno de mí, sitiado en mi epidermis por un dios inaprensible que me ahoga, mentido rumor de nubes en la tarde de agua, agua de cauce y vaso contenida." },
    { autor: "José Carlos Becerra", obra: "El otoño recorre las islas", texto: "El otoño recorre las islas con pasos de animal taciturno. Sobre el agua del río cae la tarde como una túnica de ceniza tibia. Todo lo que amamos se despide sin hacer ruido." },
    { autor: "Arq. Mario de Lille Fuentes", obra: "Nuestro mundo con Clau-dia", texto: "Claudia descubrió que las ceibas no son árboles comunes: son escaleras secretas que los pájaros usan para pintar las nubes al amanecer sobre el río de la memoria." },
    { autor: "Teodosio García Ruiz", obra: "Sin lugar a dudas", texto: "Sin lugar a dudas la lluvia sobre el cinc tiene la consistencia de un tambor antiguo. La noche en la provincia es un lienzo donde la memoria escribe con tinta de jaguar." },
    { autor: "Octavio Paz", obra: "Hermandad", texto: "Soy hombre: duro poco y es enorme la noche. Pero miro hacia arriba: las estrellas escriben. Sin entender comprendo: también soy escritura y en este mismo instante alguien me deletrea." }
  ];

  const readingGrid = document.getElementById('reading-poemas-grid');
  if (readingGrid) {
    POEMAS_LECTURA.forEach(p => {
      const card = document.createElement('div');
      card.className = "bg-black/40 p-5 rounded-2xl border border-gray-800 flex flex-col justify-between space-y-3";
      card.innerHTML = `
        <div>
          <h5 class="text-sm font-title font-bold text-white">${p.obra}</h5>
          <div class="text-xs text-[#EF7B38] font-serif italic">${p.autor}</div>
          <p class="text-xs text-gray-300 font-serif italic leading-relaxed mt-2 line-clamp-3">«${p.texto}»</p>
        </div>
        <div class="pt-2 border-t border-gray-800 flex justify-between items-center">
          <button type="button" class="read-btn px-3 py-1 rounded-lg bg-[#EF7B38] hover:bg-[#D96620] text-white text-[11px] font-title font-bold uppercase tracking-wider transition cursor-pointer">
            ▶ Declamar
          </button>
          <span class="text-[10px] font-mono text-gray-500">${currentSpeed}x</span>
        </div>
      `;

      card.querySelector('.read-btn')?.addEventListener('click', () => {
        if ('speechSynthesis' in window) {
          window.speechSynthesis.cancel();
          const utterance = new SpeechSynthesisUtterance(`${p.obra}, de ${p.autor}. ${p.texto}`);
          utterance.rate = currentSpeed;
          const selectedIdx = parseInt(voiceSelect?.value || '0');
          if (synthVoices[selectedIdx]) {
            utterance.voice = synthVoices[selectedIdx];
          }
          window.speechSynthesis.speak(utterance);
        }
      });

      readingGrid.appendChild(card);
    });
  }
</script>
