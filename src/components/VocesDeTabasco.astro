      country: 'México',
      category: 'Los Contemporáneos',
      text: `En medio de un silencio desierto como la calle antes del crimen\nsin más pulso ni voz sino el latido del miedo,\nescucho mi propia sangre fluir en la noche\ncomo un río subterráneo que busca el mar.`,
      speechText: `En medio de un silencio desierto como la calle antes del crimen sin más pulso ni voz sino el latido del miedo, escucho mi propia sangre fluir en la noche como un río subterráneo que busca el mar.`
    },
    {
      title: 'Muerte sin fin (Fragmento)',
      author: 'José Gorostiza',
      country: 'Tabasco, México',
      category: 'Obra Cumbre Mexicana',
      text: `Lleno de mí, sitiado en mi epidermis\npor un dios inaprensible que me ahoga,\nmentida fresca en los nublados linderos\nde una creación que se desmorona...`,
      speechText: `Lleno de mí, sitiado en mi epidermis por un dios inaprensible que me ahoga, mentida fresca en los nublados linderos de una creación que se desmorona...`
    },
    {
      title: 'Alta Traición',
      author: 'José Emilio Pacheco',
      country: 'México',
      category: 'Generación de Medio Siglo',
      text: `No amo mi patria. Su fulgor abstracto\nes inasible.\nPero (aunque suene mal) daría la vida\npor diez lugares suyos, cierta gente,\npuertos, bosques de pinos, fortalezas,\nuna ciudad deshecha, gris, monstruosa,\nvarias figuras de su historia,\ntres o cuatro ríos.`,
      speechText: `No amo mi patria. Su fulgor abstracto es inasible. Pero (aunque suene mal) daría la vida por diez lugares suyos, cierta gente, puertos, bosques de pinos, fortalezas, una ciudad deshecha, gris, monstruosa, varias figuras de su historia, tres o cuatro ríos.`
    },
    {
      title: 'Murmullos de Pedro Páramo',
      author: 'Juan Rulfo',
      country: 'México',
      category: 'Realismo Trágico',
      text: `Vine a Comala porque me dijeron que acá vivía mi padre, un tal Pedro Páramo.\n\nEl calor era tan grande que parecía que la tierra misma respiraba ceniza. En este pueblo lleno de ecos, las voces flotan en el viento como recuerdos que no se resignan a morir.`,
      speechText: `Vine a Comala porque me dijeron que acá vivía mi padre, un tal Pedro Páramo. El calor era tan grande que parecía que la tierra misma respiraba ceniza. En este pueblo lleno de ecos, las voces flotan en el viento como recuerdos que no se resignan a morir.`
    }
  ];

  // Elementos de UI
  const tabLvt = document.getElementById('mode-tab-lvt');
  const tabUniversal = document.getElementById('mode-tab-universal');
  const secLvt = document.getElementById('section-mode-lvt');
  const secUniversal = document.getElementById('section-mode-universal');
  const universalGrid = document.getElementById('universal-authors-grid');

  const pTitle = document.getElementById('player-poem-title');
  const pAuthor = document.getElementById('player-poem-author');
  const pText = document.getElementById('player-poem-text');
  const pCatBadge = document.getElementById('player-category-badge');
  const pCountryBadge = document.getElementById('player-country-badge');
  const playBtn = document.getElementById('player-play-btn');
  const playIcon = document.getElementById('p-play-icon');
  const pauseIcon = document.getElementById('p-pause-icon');
  const waveBars = document.querySelectorAll('.wave-bar');

  let currentPoem: Poem = lvtPoems[0];
  let isPlaying = false;
  let synthUtterance: SpeechSynthesisUtterance | null = null;

  // Renderizar los 20 Autores Universales
  if (universalGrid) {
    universalGrid.innerHTML = universalPoems.map((p, idx) => `
      <button 
        type="button" 
        class="univ-btn p-3 rounded-2xl bg-gray-900/70 border border-gray-800 text-left hover:border-dorado hover:bg-gray-800/90 transition shadow-subtle group flex flex-col justify-between"
        data-uidx="${idx}"
      >
        <div>
          <span class="text-[9px] font-title font-bold text-dorado uppercase block mb-1 truncate">${p.country}</span>
          <h5 class="font-serif text-sm font-bold text-white leading-tight group-hover:text-dorado transition truncate">${p.author}</h5>
        </div>
        <span class="text-[10px] text-gray-400 font-light block truncate mt-2">«${p.title}»</span>
      </button>
    `).join('');
  }

  // Alternancia Exclusiva de Pestañas (Uno u Otro)
  function switchMode(mode: 'lvt' | 'universal') {
    stopPlayback();
    if (mode === 'lvt') {
      tabLvt?.classList.remove('text-gray-300');
      tabLvt?.classList.add('bg-terracota', 'text-white', 'shadow-lg');
      tabUniversal?.classList.remove('bg-dorado', 'text-white', 'shadow-lg');
      tabUniversal?.classList.add('text-gray-300');

      secLvt?.classList.remove('hidden');
      secLvt?.classList.add('tab-content-active');
      secUniversal?.classList.add('hidden');
      secUniversal?.classList.remove('tab-content-active');

      loadPoem(lvtPoems[0]);
    } else {
      tabUniversal?.classList.remove('text-gray-300');
      tabUniversal?.classList.add('bg-dorado', 'text-white', 'shadow-lg');
      tabLvt?.classList.remove('bg-terracota', 'text-white', 'shadow-lg');
      tabLvt?.classList.add('text-gray-300');

      secUniversal?.classList.remove('hidden');
      secUniversal?.classList.add('tab-content-active');
      secLvt?.classList.add('hidden');
      secLvt?.classList.remove('tab-content-active');

      loadPoem(universalPoems[0]);
    }
  }

  tabLvt?.addEventListener('click', () => switchMode('lvt'));
  tabUniversal?.addEventListener('click', () => switchMode('universal'));

  // Cargar Poema en el Reproductor
  function loadPoem(poem: Poem) {
    currentPoem = poem;
    if (pTitle) pTitle.innerText = poem.title;
    if (pAuthor) pAuthor.innerText = `Autor: ${poem.author}`;
    if (pText) pText.innerText = poem.text;
    if (pCatBadge) pCatBadge.innerText = poem.category;
    if (pCountryBadge) pCountryBadge.innerText = poem.country;
  }

  // Animación de Onda de Audio
  function setWave(active: boolean) {
    waveBars.forEach((bar, i) => {
      if (active) {
        (bar as HTMLElement).style.animation = `pulse 0.7s infinite alternate ${(i * 0.08).toFixed(2)}s`;
      } else {
        (bar as HTMLElement).style.animation = 'none';
      }
    });
  }

  // Control de Síntesis Vocal
  function stopPlayback() {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    isPlaying = false;
    playIcon?.classList.remove('hidden');
    pauseIcon?.classList.add('hidden');
    setWave(false);
  }

  function startPlayback() {
    stopPlayback();
    if ('speechSynthesis' in window) {
      synthUtterance = new SpeechSynthesisUtterance(currentPoem.speechText);
      synthUtterance.lang = 'es-MX';
      synthUtterance.rate = 0.86; // Cadencia pausada, solemne y teatral
      synthUtterance.pitch = 0.92; // Tono profundo y lírico

      // Asignar voz natural si está disponible en el navegador
      const voices = window.speechSynthesis.getVoices();
      const esVoice = voices.find(v => v.lang.startsWith('es-MX') || v.lang.startsWith('es-'));
      if (esVoice) synthUtterance.voice = esVoice;

      synthUtterance.onend = () => stopPlayback();
      synthUtterance.onerror = () => stopPlayback();

      window.speechSynthesis.speak(synthUtterance);
      isPlaying = true;
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');
      setWave(true);
    }
  }

  playBtn?.addEventListener('click', () => {
    if (isPlaying) {
      stopPlayback();
    } else {
      startPlayback();
    }
  });

  // Listeners para Pistas LVT
  document.querySelectorAll('.lvt-track-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.lvt-track-btn').forEach(b => {
        b.classList.remove('border-terracota', 'bg-gray-800/90');
        b.classList.add('border-gray-800', 'bg-gray-900/70');
      });
      btn.classList.remove('border-gray-800', 'bg-gray-900/70');
      btn.classList.add('border-terracota', 'bg-gray-800/90');

      const idx = parseInt(btn.getAttribute('data-idx') || '0');
      loadPoem(lvtPoems[idx]);
      startPlayback();
    });
  });

  // Listeners para 20 Maestros Universales
  document.querySelectorAll('.univ-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.univ-btn').forEach(b => {
        b.classList.remove('border-dorado', 'bg-gray-800/90');
        b.classList.add('border-gray-800', 'bg-gray-900/70');
      });
      btn.classList.remove('border-gray-800', 'bg-gray-900/70');
      btn.classList.add('border-dorado', 'bg-gray-800/90');

      const uidx = parseInt(btn.getAttribute('data-uidx') || '0');
      loadPoem(universalPoems[uidx]);
      startPlayback();
    });
  });
</script>
