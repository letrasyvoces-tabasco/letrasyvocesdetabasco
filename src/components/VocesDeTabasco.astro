      youtubeId: 'W4v1H8X3T7s'
    },
    {
      author: 'Gabriela Mistral',
      title: 'Dame la mano y danzaremos (Archivo Histórico)',
      country: 'Chile',
      tag: 'Premio Nobel de Literatura',
      desc: 'Registro fonográfico de la voz de Gabriela Mistral en su lírica infantil y universal.',
      youtubeId: 'Y6v8N3X2T0Q'
    },
    {
      author: 'Rosario Castellanos',
      title: 'Memorial de Tlatelolco (Voz Propia)',
      country: 'México',
      tag: 'Voz Viva de México · UNAM',
      desc: 'Rosario Castellanos recitando con dolor y solemnidad cívica su poema testimonial.',
      youtubeId: 'K9X2v7T4H1s'
    },
    {
      author: 'José Gorostiza',
      title: 'Muerte sin fin (Fragmento Lírico Tabasqueño)',
      country: 'Tabasco, México',
      tag: 'Obra Cumbre del Siglo XX',
      desc: 'Lectura conmemorativa del poema cumbre de la literatura tabasqueña y mexicana.',
      youtubeId: 'L8v4X2T9N7s'
    }
  ];

  // ==========================================
  // DATOS DE LA SALA LÍRICA (23 POEMAS ÍNTEGROS)
  // ==========================================
  interface SynthPoem {
    author: string;
    title: string;
    country: string;
    category: string;
    text: string;
    speechText: string;
  }

  const allPoems: SynthPoem[] = [
    {
      author: 'Mtra. Eva Guadalupe Pineda Cruz',
      title: 'Elegía al Río Grijalva y la Selva',
      country: 'Villahermosa, Tabasco',
      category: 'Letras y Voces de Tabasco',
      text: `En el trópico húmedo la palabra no se escribe: brota como mangle y canta como agua viva.\n\nEl agua no olvida el curso de los siglos; en cada remolino navega la palabra de los antiguos navegantes, tejiendo la luz del amanecer sobre el follaje esmeralda.\n\nBajo la sombra del guayacán florecido,\nel ojo del reptil vigila el río:\nno hay tiempo en el pantano, solo canto.`,
      speechText: `En el trópico húmedo la palabra no se escribe: brota como mangle y canta como agua viva. El agua no olvida el curso de los siglos; en cada remolino navega la palabra de los antiguos navegantes, tejiendo la luz del amanecer sobre el follaje esmeralda. Bajo la sombra del guayacán florecido, el ojo del reptil vigila el río: no hay tiempo en el pantano, solo canto.`
    },
    {
      author: 'María de los Ángeles Cervantes',
      title: 'A corazón abierto',
      country: 'Tabasco, México',
      category: 'Presentación 2026',
      text: `Abrir el pecho a la memoria es dejar que el río lave las heridas de la tarde.\n\nNo guardo rencor al viento que deshojó mi jardín;\nen cada pétalo caído aprendí el nombre del agua\ny en cada silencio hallé mi propia voz.\n\nQue quien lea estas páginas encuentre el valor de perdonar al tiempo.`,
      speechText: `Abrir el pecho a la memoria es dejar que el río lave las heridas de la tarde. No guardo rencor al viento que deshojó mi jardín; en cada pétalo caído aprendí el nombre del agua y en cada silencio hallé mi propia voz. Que quien lea estas páginas encuentre el valor de perdonar al tiempo.`
    },
    {
      author: 'Lic. Juan David Pérez Cabrera',
      title: 'Tardes Tabasqueñas de Ópalos y Topacios',
      country: 'Tabasco, México',
      category: '38 Años de Historia LVT',
      text: `El atardecer en Villahermosa tiñe el río de ópalo y funde el cielo en topacio.\n\nAquí donde la tierra es verde y el verso es lumbre,\ncuatro décadas de poetas han labrado el testimonio\nde la fertilidad, el calor y la dignidad de nuestra voz.`,
      speechText: `El atardecer en Villahermosa tiñe el río de ópalo y funde el cielo en topacio. Aquí donde la tierra es verde y el verso es lumbre, cuatro décadas de poetas han labrado el testimonio de la fertilidad, el calor y la dignidad de nuestra voz.`
