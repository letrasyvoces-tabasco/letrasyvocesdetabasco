  // =========================================================================
  // CONTROLADOR DE LA FONOTECA DE VIDEOS REALES
  // =========================================================================
  let curVidIdx = 0;
  const vidIframe = document.getElementById('video-player-iframe') as HTMLIFrameElement;
  const vidTitle = document.getElementById('video-display-title');
  const vidDesc = document.getElementById('video-display-desc');
  const vidCountry = document.getElementById('video-country-tag');
  const vidBadge = document.getElementById('video-badge-tag');
  const vidDirectYt = document.getElementById('video-direct-yt-btn') as HTMLAnchorElement;
  const vidTracklist = document.getElementById('video-tracklist-container');
  const btnVidPrev = document.getElementById('vid-prev-btn');
  const btnVidNext = document.getElementById('vid-next-btn');

  function renderVideoTracklist() {
    if (!vidTracklist) return;
    vidTracklist.innerHTML = realVideos.map((item, idx) => `
      <button 
        type="button" 
        class="vid-card shrink-0 w-64 p-3.5 rounded-2xl bg-gray-900/80 border ${idx === curVidIdx ? 'border-terracota bg-gray-800' : 'border-gray-800'} text-left hover:border-dorado transition shadow-subtle flex flex-col justify-between cursor-pointer"
        data-vidx="${idx}"
      >
        <div>
          <span class="text-[9px] font-title font-bold text-dorado uppercase block mb-1 truncate">${item.country}</span>
          <h5 class="font-serif text-sm font-bold text-white leading-tight truncate">${item.author}</h5>
          <p class="text-[10px] text-gray-300 font-light truncate mt-1">«${item.title}»</p>
        </div>
        <span class="text-[9px] font-title font-bold text-terracota uppercase tracking-wider block mt-2">▶ Ver Grabación</span>
      </button>
    `).join('');

    document.querySelectorAll('.vid-card').forEach(card => {
      card.addEventListener('click', () => {
        const vidx = parseInt(card.getAttribute('data-vidx') || '0');
        loadVideo(vidx);
      });
    });
  }

  function loadVideo(idx: number) {
    curVidIdx = idx;
    const item = realVideos[idx];
    if (!item) return;

    if (vidIframe) {
      vidIframe.src = `https://www.youtube-nocookie.com/embed/${item.youtubeId}?autoplay=1&rel=0`;
    }
    if (vidTitle) vidTitle.innerText = `${item.author} — «${item.title}»`;
    if (vidDesc) vidDesc.innerText = item.desc;
    if (vidCountry) vidCountry.innerText = item.country;
    if (vidBadge) vidBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span> ${item.tag}`;
    if (vidDirectYt) vidDirectYt.href = `https://www.youtube.com/watch?v=${item.youtubeId}`;

    document.querySelectorAll('.vid-card').forEach((card, i) => {
      if (i === idx) {
        card.classList.add('border-terracota', 'bg-gray-800');
        card.classList.remove('border-gray-800', 'bg-gray-900/80');
      } else {
        card.classList.remove('border-terracota', 'bg-gray-800');
        card.classList.add('border-gray-800', 'bg-gray-900/80');
      }
    });
  }

  btnVidPrev?.addEventListener('click', () => {
    const nextIdx = (curVidIdx - 1 + realVideos.length) % realVideos.length;
    loadVideo(nextIdx);
  });

  btnVidNext?.addEventListener('click', () => {
    const nextIdx = (curVidIdx + 1) % realVideos.length;
    loadVideo(nextIdx);
  });

  renderVideoTracklist();

  // =========================================================================
  // CONTROLADOR DE LA SALA LÍRICA DE DECLAMACIÓN (23 POETAS)
  // =========================================================================
  let curSynthWork = synthWorks[0];
  let isSynthRunning = false;
  let synthCadenceRate = 0.86;
  let speechUtterance: SpeechSynthesisUtterance | null = null;

  const sTitle = document.getElementById('synth-display-title');
  const sAuthor = document.getElementById('synth-display-author');
  const sFullText = document.getElementById('synth-full-text-display');
  const sBadgeText = document.getElementById('synth-badge-text');
  const sCountryText = document.getElementById('synth-country-text');
  const sDeclaimerDesc = document.getElementById('synth-declaimer-desc');
  const sPlayPauseBtn = document.getElementById('synth-play-pause-btn');
  const sIconPlay = document.getElementById('synth-icon-play');
  const sIconPause = document.getElementById('synth-icon-pause');
  const sWaveBars = document.querySelectorAll('.wave-bar');
  const sPoetsGrid = document.getElementById('synth-poets-grid');
  const sSearchInput = document.getElementById('search-synth-input') as HTMLInputElement;
  const cadenceBtns = document.querySelectorAll('.cadence-btn');

  function renderSynthGrid(filterText = '') {
    if (!sPoetsGrid) return;
    const q = filterText.toLowerCase().trim();

    const filtered = synthWorks.filter(w => 
      w.author.toLowerCase().includes(q) ||
      w.title.toLowerCase().includes(q) ||
      w.country.toLowerCase().includes(q)
    );

    if (filtered.length === 0) {
      sPoetsGrid.innerHTML = `<div class="col-span-full py-8 text-center text-gray-400 text-xs font-light">No se encontraron obras con el término «${filterText}».</div>`;
      return;
    }

    sPoetsGrid.innerHTML = filtered.map(w => `
      <button 
        type="button" 
        class="synth-card p-4 rounded-2xl bg-gray-900/80 border ${w.id === curSynthWork.id ? 'border-terracota bg-gray-800' : 'border-gray-800'} text-left hover:border-dorado transition shadow-subtle flex flex-col justify-between group cursor-pointer"
        data-swid="${w.id}"
      >
        <div>
          <span class="text-[9px] font-title font-bold text-dorado uppercase block mb-1 truncate">${w.country}</span>
          <h5 class="font-serif text-base font-bold text-white leading-tight group-hover:text-dorado transition truncate">${w.author}</h5>
          <p class="text-xs text-gray-300 font-light truncate mt-1">«${w.title}»</p>
        </div>
        <div class="pt-3 mt-3 border-t border-gray-800/80 flex items-center justify-between">
          <span class="text-[9px] text-gray-400 font-mono">${w.category.substring(0, 22)}...</span>
          <span class="text-[9px] font-title font-bold text-terracota uppercase tracking-wider group-hover:underline">▶ Cargar Obra</span>
        </div>
      </button>
    `).join('');

    document.querySelectorAll('.synth-card').forEach(card => {
      card.addEventListener('click', () => {
        const swid = card.getAttribute('data-swid');
        const match = synthWorks.find(w => w.id === swid);
        if (match) {
          loadSynthWork(match);
          startSynthDeclamation();
          renderSynthGrid(sSearchInput?.value || '');
        }
      });
    });
  }

  function loadSynthWork(w: SynthWork) {
    curSynthWork = w;
    if (sTitle) sTitle.innerText = w.title;
    if (sAuthor) sAuthor.innerText = `Autor: ${w.author} · ${w.category}`;
    if (sFullText) sFullText.innerText = w.fullText;
    if (sBadgeText) sBadgeText.innerText = w.declaimerBadge;
    if (sCountryText) sCountryText.innerText = w.country;
    if (sDeclaimerDesc) {
      sDeclaimerDesc.innerHTML = `Intérprete: <strong class="text-gray-200">${w.declaimerName}</strong> · <em>Preparado para masterización en estudio LVT</em>`;
    }
  }

  function setWaveform(active: boolean) {
    sWaveBars.forEach((bar, i) => {
      if (active) {
        (bar as HTMLElement).style.animation = `pulse 0.7s infinite alternate ${(i * 0.08).toFixed(2)}s`;
      } else {
        (bar as HTMLElement).style.animation = 'none';
      }
    });
  }

  function stopSynthDeclamation() {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    isSynthRunning = false;
    sIconPlay?.classList.remove('hidden');
    sIconPause?.classList.add('hidden');
    setWaveform(false);
  }

  function startSynthDeclamation() {
    stopSynthDeclamation();
    if ('speechSynthesis' in window) {
      speechUtterance = new SpeechSynthesisUtterance(curSynthWork.fullText);
      speechUtterance.lang = 'es-MX';
      speechUtterance.rate = synthCadenceRate;
      speechUtterance.pitch = 0.92;

      const voices = window.speechSynthesis.getVoices();
      const esVoice = voices.find(v => v.lang.startsWith('es-MX') || v.lang.startsWith('es-'));
      if (esVoice) speechUtterance.voice = esVoice;

      speechUtterance.onend = () => stopSynthDeclamation();
      speechUtterance.onerror = () => stopSynthDeclamation();

      window.speechSynthesis.speak(speechUtterance);
      isSynthRunning = true;
      sIconPlay?.classList.add('hidden');
      sIconPause?.classList.remove('hidden');
      setWaveform(true);
    }
  }

  sPlayPauseBtn?.addEventListener('click', () => {
    if (isSynthRunning) {
      stopSynthDeclamation();
    } else {
      startSynthDeclamation();
    }
  });

  cadenceBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      cadenceBtns.forEach(b => {
        b.className = "cadence-btn px-3 py-1 rounded-full text-xs bg-gray-800 text-gray-400 hover:text-white";
      });
      btn.className = "cadence-btn px-3 py-1 rounded-full text-xs bg-terracota text-white font-bold";
      synthCadenceRate = parseFloat(btn.getAttribute('data-cadence') || '0.86');
      if (isSynthRunning) {
        startSynthDeclamation();
      }
    });
  });

  sSearchInput?.addEventListener('input', (e) => {
    renderSynthGrid((e.target as HTMLInputElement).value);
  });

  renderSynthGrid();

  // =========================================================================
  // 3. CONMUTADOR MAESTRO DE MODOS (VIDEOS VS TEXTOS)
  // =========================================================================
  const tabBtnVideos = document.getElementById('tab-btn-videos');
  const tabBtnTextos = document.getElementById('tab-btn-textos');
  const panelModeVideos = document.getElementById('panel-mode-videos');
  const panelModeTextos = document.getElementById('panel-mode-textos');

  tabBtnVideos?.addEventListener('click', () => {
    stopSynthDeclamation();
    tabBtnVideos.className = "px-5 sm:px-8 py-3 rounded-full text-xs font-title font-bold uppercase tracking-wider bg-terracota text-white shadow-lg transition duration-300 flex items-center gap-2 cursor-pointer";
    tabBtnTextos!.className = "px-5 sm:px-8 py-3 rounded-full text-xs font-title font-bold uppercase tracking-wider text-gray-300 hover:text-white transition duration-300 flex items-center gap-2 cursor-pointer";

    panelModeVideos?.classList.remove('hidden');
    panelModeVideos?.classList.add('tab-content-active');
    panelModeTextos?.classList.add('hidden');
    panelModeTextos?.classList.remove('tab-content-active');
  });

  tabBtnTextos?.addEventListener('click', () => {
    // Pausar video de YouTube si estaba en reproducción
    if (vidIframe) {
      const curSrc = vidIframe.src;
      vidIframe.src = curSrc.replace('autoplay=1', 'autoplay=0');
    }
    tabBtnTextos.className = "px-5 sm:px-8 py-3 rounded-full text-xs font-title font-bold uppercase tracking-wider bg-dorado text-white shadow-lg transition duration-300 flex items-center gap-2 cursor-pointer";
    tabBtnVideos!.className = "px-5 sm:px-8 py-3 rounded-full text-xs font-title font-bold uppercase tracking-wider text-gray-300 hover:text-white transition duration-300 flex items-center gap-2 cursor-pointer";

    panelModeTextos?.classList.remove('hidden');
    panelModeTextos?.classList.add('tab-content-active');
    panelModeVideos?.classList.add('hidden');
    panelModeVideos?.classList.remove('tab-content-active');
  });
</script>
