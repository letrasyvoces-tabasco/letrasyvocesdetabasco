---
// MobileDrawer.astro - Command Center Táctil Móvil en Liquid Glassmorphism Oscuro (48px Touch Targets)
const basePath = "";
---

<!-- Fondo Oscuro de Bloqueo (Backdrop) -->
<div 
  id="global-mobile-backdrop" 
  class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[99998] opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
></div>

<!-- Panel Lateral Deslizable Táctil de Pantalla Completa (Drawer) -->
<aside 
  id="global-mobile-drawer" 
  class="fixed top-0 right-0 bottom-0 w-[88vw] max-w-sm bg-[#12100E]/98 backdrop-blur-2xl z-[99999] shadow-2xl border-l border-white/10 text-white flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out lg:hidden h-[100dvh] overscroll-contain"
  role="dialog" 
  aria-modal="true" 
  aria-label="Menú de Navegación Móvil"
>
  
  <!-- 1. Encabezado Fijo del Menú -->
  <div class="p-4 border-b border-white/10 flex items-center justify-between bg-[#191614] shrink-0">
    <div class="flex items-center gap-2.5">
      <img 
        src={`${basePath}/assets/logos/LVT Logo Iso 6 Blanco Relleno.svg`} 
        alt="LVT" 
        class="h-8 w-auto object-contain bg-black/60 p-1.5 rounded-xl border border-white/10"
        onerror="this.src='/assets/logos/LVT Logo Iso 1 Original.png'"
      />
      <div>
        <span class="font-swiss font-bold text-xs uppercase tracking-wider text-white block leading-tight">
          Letras y Voces
        </span>
        <span class="text-[10px] font-serif italic text-oro-bright block">
          Sociedad de Escritores A.C.
        </span>
      </div>
    </div>
    
    <!-- Botón de Cierre Ergonómico (48x48px) -->
    <button 
      id="global-mobile-close-btn" 
      type="button" 
      class="touch-target-48 rounded-2xl bg-white/10 border border-white/15 text-gray-200 hover:text-red-400 hover:bg-white/20 active:scale-95 transition cursor-pointer"
      aria-label="Cerrar menú de navegación"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- 2. Cuerpo Desplazable con Todas las Secciones -->
  <div class="p-4 overflow-y-auto flex-1 space-y-2.5 font-swiss text-xs font-semibold uppercase tracking-wider">
    
    <!-- 1. INICIO -->
    <a 
      href={`${basePath}/`} 
      class="drawer-nav-item flex items-center justify-between p-3.5 rounded-2xl bg-white/[0.04] border border-white/10 hover:border-cacao hover:bg-white/[0.08] text-white active:scale-98 transition"
    >
      <span class="font-bold tracking-wide">Inicio</span>
      <span class="text-[10px] text-gray-400 font-mono">01</span>
    </a>

    <!-- 2. ESCUELA GOROSTIZA (EEJG) -->
    <div class="rounded-2xl bg-white/[0.04] border border-white/10 overflow-hidden">
      <div class="flex items-center justify-between p-3.5 bg-gradient-to-r from-cacao/20 to-transparent text-white">
        <a href={`${basePath}/escuela`} class="drawer-nav-item flex-1">
          <span class="font-bold text-sm tracking-wide block text-cacao-light">Escuela Gorostiza (EEJG)</span>
          <span class="text-[10px] text-gray-400 font-serif italic normal-case block">Filial Académica Oficial LVT</span>
        </a>
        <button type="button" class="drawer-toggle-sub touch-target-48 p-2 rounded-xl bg-white/10 hover:bg-white/20 text-cacao-light transition cursor-pointer" data-target="sub-escuela" aria-label="Desplegar submenú Escuela">
          <svg class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>
      
      <div id="sub-escuela" class="p-3 bg-[#0B0A09]/60 border-t border-white/10 space-y-1.5 text-[11px] normal-case hidden">
        <a href={`${basePath}/escuela#diplomados`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider text-cacao-light">10 Diplomados (120 Horas)</strong>
          <span class="text-[10px] text-gray-400">Creación, Redacción, Periodismo, Guion, Oratoria...</span>
        </a>
        <a href={`${basePath}/escuela#cursos`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider text-cacao-light">7 Cursos Continuos & Talleres</strong>
          <span class="text-[10px] text-gray-400">Cuento, Poesía, Novela, Teatro, Ortografía...</span>
        </a>
        <a href={`${basePath}/escuela#pioneros`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider text-cacao-light">Dirección & Claustro</strong>
          <span class="text-[10px] text-gray-400">Mtra. Liliana Chuzeville & Mtra. Rebeca Díaz</span>
        </a>
      </div>
    </div>

    <!-- 3. CATÁLOGO EDITORIAL & ANTOLOGÍAS -->
    <div class="rounded-2xl bg-white/[0.04] border border-white/10 overflow-hidden">
      <div class="flex items-center justify-between p-3.5 text-white">
        <a href={`${basePath}/publicaciones`} class="drawer-nav-item flex-1">
          <span class="font-bold text-sm tracking-wide block">Fondo Editorial</span>
          <span class="text-[10px] text-oro-bright font-serif italic normal-case block">5 Antologías Oficiales</span>
        </a>
        <button type="button" class="drawer-toggle-sub touch-target-48 p-2 rounded-xl bg-white/10 hover:bg-white/20 text-gray-200 transition cursor-pointer" data-target="sub-editorial" aria-label="Desplegar submenú Editorial">
          <svg class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>

      <div id="sub-editorial" class="p-3 bg-[#0B0A09]/60 border-t border-white/10 space-y-1.5 text-[11px] normal-case hidden">
        <a href={`${basePath}/publicaciones`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <span class="font-bold text-white block">Animalia Literaria (2026)</span>
          <span class="text-[9px] text-cacao-light font-bold">[En Imprenta]</span>
        </a>
        <a href={`${basePath}/publicaciones`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <span class="font-bold text-white block">A Corazón Abierto (2026)</span>
          <span class="text-[9px] text-gray-400">Poemario & Pintura</span>
        </a>
        <a href={`${basePath}/publicaciones`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <span class="font-bold text-white block">Tardes Tabasqueñas de Ópalos y Topacios (2025)</span>
        </a>
        <a href={`${basePath}/publicaciones`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <span class="font-bold text-white block">La Mujer en el Siglo XXI & Amarellus</span>
        </a>
      </div>
    </div>

    <!-- 4. AUDIOTECA LÍRICA -->
    <a 
      href={`${basePath}/audioteca`} 
      class="drawer-nav-item flex items-center justify-between p-3.5 rounded-2xl bg-gradient-to-r from-white/[0.06] to-cacao/20 border border-white/10 text-white active:scale-98 transition group"
    >
      <div>
        <span class="font-bold text-sm tracking-wide block group-hover:text-cacao-light transition">Audioteca Lírica</span>
        <span class="text-[10px] text-oro-bright font-serif italic normal-case block">14 Reproducciones Sonoras Nativas</span>
      </div>
      <span class="px-2 py-0.5 rounded-full bg-cacao text-white text-[9px] font-bold">14 MP3</span>
    </a>

    <!-- 5. PADRÓN DE ESCRITORES -->
    <a 
      href={`${basePath}/autores`} 
      class="drawer-nav-item flex items-center justify-between p-3.5 rounded-2xl bg-white/[0.04] border border-white/10 hover:border-cacao hover:text-cacao-light text-white active:scale-98 transition"
    >
      <div>
        <span class="font-bold text-sm tracking-wide block">Padrón de Escritores</span>
        <span class="text-[10px] text-gray-400 font-serif italic normal-case block">Membresía Oficial & Fundadores</span>
      </div>
      <span class="text-[10px] text-gray-400 font-mono">2026</span>
    </a>

    <!-- 6. HISTORIA & GOBERNANZA -->
    <div class="rounded-2xl bg-white/[0.04] border border-white/10 overflow-hidden">
      <div class="flex items-center justify-between p-3.5 text-white">
        <a href={`${basePath}/historia`} class="drawer-nav-item flex-1">
          <span class="font-bold text-sm tracking-wide block">Historia & Gobernanza</span>
          <span class="text-[10px] text-gray-400 font-serif italic normal-case block">39 Años de Trayectoria (1987–2026)</span>
        </a>
        <button type="button" class="drawer-toggle-sub touch-target-48 p-2 rounded-xl bg-white/10 hover:bg-white/20 text-gray-200 transition cursor-pointer" data-target="sub-historia" aria-label="Desplegar submenú Historia">
          <svg class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>

      <div id="sub-historia" class="p-3 bg-[#0B0A09]/60 border-t border-white/10 space-y-1.5 text-[11px] normal-case hidden">
        <a href={`${basePath}/historia`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider">Cronología Fundacional 1987-2026</strong>
        </a>
        <a href={`${basePath}/historia#directiva`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider">Mesa Directiva (2026–2029)</strong>
        </a>
        <a href={`${basePath}/historia#solvencia`} class="drawer-nav-item block p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-gray-200 border border-white/5 transition">
          <strong class="text-white block font-swiss uppercase text-[10px] tracking-wider">Solvencia Jurídica & Estatutos</strong>
        </a>
      </div>
    </div>

    <!-- 7. DESCARGAS & CONVOCATORIAS -->
    <a 
      href={`${basePath}/descargas`} 
      class="drawer-nav-item flex items-center justify-between p-3.5 rounded-2xl bg-white/[0.04] border border-white/10 hover:border-cacao text-white active:scale-98 transition"
    >
      <div>
        <span class="font-bold text-sm tracking-wide block">Centro de Descargas & Convocatorias</span>
        <span class="text-[10px] text-gray-400 font-serif italic normal-case block">Formatos PDF, Nuevos Socios & Eventos</span>
      </div>
      <span class="text-[10px] text-gray-400 font-mono">PDF</span>
    </a>

  </div>

  <!-- 3. Pie del Menú con Botones de Contacto Directo de 48px -->
  <div class="p-4 border-t border-white/10 bg-[#191614] space-y-2 shrink-0 pb-[max(1rem,env(safe-area-inset-bottom))]">
    <a 
      href="https://wa.me/522205889391?text=Hola%20Sociedad%20de%20Escritores%20LVT,%20deseo%20información%20institucional." 
      target="_blank" 
      rel="noopener noreferrer" 
      class="touch-target-48 flex items-center justify-center gap-2 w-full py-3 rounded-2xl bg-cacao hover:bg-cacao-dark text-white font-swiss text-xs font-bold uppercase tracking-wider shadow-lg active:scale-95 transition"
    >
      <span>WhatsApp Oficial LVT (+52 220 588 9391)</span>
    </a>
    <a 
      href="mailto:contacto@letrasyvocesdetabasco.org" 
      class="touch-target-48 flex items-center justify-center w-full py-2.5 rounded-2xl bg-white/10 hover:bg-white/15 text-gray-200 font-swiss text-xs font-bold uppercase tracking-wider active:scale-95 transition border border-white/10"
    >
      contacto@letrasyvocesdetabasco.org
    </a>
  </div>

</aside>

<script is:inline>
  // Control Maestro Global del Menú Móvil Táctil
  (function setupGlobalMobileDrawer() {
    function init() {
      var backdrop = document.getElementById('global-mobile-backdrop');
      var drawer = document.getElementById('global-mobile-drawer');
      var closeBtn = document.getElementById('global-mobile-close-btn');
      var navItems = document.querySelectorAll('.drawer-nav-item');
      var subToggles = document.querySelectorAll('.drawer-toggle-sub');

      if (!backdrop || !drawer) return;

      window.openGlobalMobileNav = function() {
        drawer.classList.remove('translate-x-full');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
      };

      window.closeGlobalMobileNav = function() {
        drawer.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      };

      if (closeBtn) {
        closeBtn.addEventListener('click', window.closeGlobalMobileNav);
        closeBtn.addEventListener('touchstart', function(e) {
          e.preventDefault();
          window.closeGlobalMobileNav();
        }, { passive: false });
      }

      backdrop.addEventListener('click', window.closeGlobalMobileNav);
      backdrop.addEventListener('touchstart', function(e) {
        e.preventDefault();
        window.closeGlobalMobileNav();
      }, { passive: false });

      navItems.forEach(function(item) {
        item.addEventListener('click', function() {
          setTimeout(window.closeGlobalMobileNav, 120);
        });
      });

      // Acordeones de Subsecciones con animación fluida
      subToggles.forEach(function(toggle) {
        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          var targetId = toggle.getAttribute('data-target');
          var targetEl = document.getElementById(targetId);
          var svg = toggle.querySelector('svg');
          if (targetEl) {
            var isHidden = targetEl.classList.contains('hidden');
            if (isHidden) {
              targetEl.classList.remove('hidden');
              if (svg) svg.classList.add('rotate-180');
            } else {
              targetEl.classList.add('hidden');
              if (svg) svg.classList.remove('rotate-180');
            }
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
