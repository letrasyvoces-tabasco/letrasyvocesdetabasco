---
import { DIPLOMADOS_GOROSTIZA, CUERPO_DOCENTE_HISTORICO } from '../data/escuela';
---

<section id="escuela-gorostiza" class="py-24 bg-[#FDFBF7] text-[#222222] border-b border-[#E6DCCE]">
  <div class="max-w-7xl mx-auto px-6 sm:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#EF7B38]/10 text-[#EF7B38] text-xs font-title font-bold tracking-widest uppercase rounded-full mb-4">
        Filial Académica Oficial · Fundada en Septiembre de 2001
      </div>
      <h2 class="text-3xl sm:text-5xl font-title font-black tracking-tight text-[#222222]">
        Escuela de Escritores <span class="text-[#EF7B38]">«José Gorostiza»</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg font-serif italic text-[#555555]">
        Brazo formativo de la Sociedad de Escritores Letras y Voces de Tabasco, A.C., con el aval académico formal de la Universidad Juárez Autónoma de Tabasco (UJAT).
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 bg-white p-8 sm:p-10 rounded-2xl border border-[#E6DCCE] shadow-subtle">
      <div class="lg:col-span-7 space-y-4">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-[#F5EFE6] text-[#EF7B38] text-[11px] font-title font-bold uppercase tracking-wider rounded-md">
          Dirección Fundacional: Arq. Mario de Lille Fuentes
        </div>
        <h3 class="text-2xl font-title font-bold text-[#222222]">Modelo Pedagógico y Sede Histórica</h3>
        <p class="font-sans text-sm sm:text-base text-[#555555] leading-relaxed">
          Inaugurada en septiembre de 2001, la Escuela de Escritores nació para dotar al estado de Tabasco de un centro de formación técnica, teórica y práctica en el oficio de las letras. Concebida y dirigida por el distinguido <strong class="text-[#222222]">Arquitecto Mario de Lille Fuentes</strong> —novelista, dramaturgo, poeta y pilar fundador de LVT—, la institución cimentó un programa que ha graduado a múltiples generaciones de creadores literarios y periodistas culturales.
        </p>
        <p class="font-sans text-sm sm:text-base text-[#555555] leading-relaxed">
          Su sede opera históricamente en la calle Centenario del Instituto Juárez s/n, Colonia Reforma, al interior de la antigua División Académica de Ciencias Sociales y Humanidades (<strong class="text-[#222222]">DACSyH - UJAT</strong>), detrás del edificio de la Fundación UJAT en Villahermosa.
        </p>
      </div>

      <div class="lg:col-span-5 bg-[#F5EFE6] p-6 rounded-xl border border-[#E6DCCE] flex flex-col justify-between">
        <div>
          <span class="text-xs font-title font-bold uppercase tracking-wider text-[#EF7B38]">Cuerpo Docente Histórico</span>
          <div class="mt-4 space-y-3">
            {CUERPO_DOCENTE_HISTORICO.map((docente) => (
              <div class="border-b border-[#E6DCCE] pb-2 last:border-0">
                <div class="font-title font-bold text-sm text-[#222222]">{docente.nombre}</div>
                <div class="text-xs text-[#EF7B38] font-medium">{docente.cargo}</div>
                <div class="text-xs text-[#555555] font-serif italic mt-0.5">{docente.semblanza}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mb-12">
      <h3 class="text-xl sm:text-2xl font-title font-bold text-[#222222] mb-6 flex items-center gap-3">
        <span class="w-2.5 h-6 bg-[#EF7B38] rounded-full inline-block"></span>
        Oferta Curricular con Validez Institucional
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {DIPLOMADOS_GOROSTIZA.map((diplomado) => (
          <div class="bg-white p-6 sm:p-8 rounded-xl border border-[#E6DCCE] shadow-subtle hover:border-[#EF7B38] transition-all flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-3">
                <span class="text-xs font-title font-bold tracking-wider uppercase px-2.5 py-1 bg-[#F5EFE6] text-[#222222] rounded-md">
                  {diplomado.duracion}
                </span>
                <span class="text-xs text-[#EF7B38] font-bold font-title">
                  {diplomado.modulos} Módulos
                </span>
              </div>
              <h4 class="text-xl font-title font-bold text-[#222222] mb-2">{diplomado.nombre}</h4>
              <p class="text-xs font-sans text-[#555555] mb-4 leading-relaxed">{diplomado.objetivo}</p>
              
              <div class="mb-4">
                <div class="text-xs font-title font-semibold text-[#222222] uppercase tracking-wider mb-2">Materias y Módulos:</div>
                <ul class="text-xs text-[#555555] space-y-1 list-disc list-inside font-sans">
                  {diplomado.materiasClave.map((materia) => (
                    <li>{materia}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-[#E6DCCE] flex items-center justify-between">
              <span class="text-xs text-[#777777] font-serif italic">Aval: UJAT / LVT</span>
              <a 
                href={`https://wa.me/522205889391?text=Deseo%20informes%20e%20inscripción%20para%20el%20${encodeURIComponent(diplomado.nombre)}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center text-xs font-title font-bold text-[#EF7B38] hover:text-[#D96620] transition-colors"
              >
                Solicitar Ficha &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="bg-[#222222] text-[#FDFBF7] p-8 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2">
        <span class="text-xs font-title font-bold uppercase tracking-widest text-[#EF7B38]">Publicación de Egresados 2024</span>
        <h4 class="text-2xl font-title font-black">"Escuela con sus plumas de ceiba"</h4>
        <p class="text-sm text-stone-300 font-serif italic max-w-2xl">
          Generación Guadalupe Azuara. Compendio cuatridimensional con las obras de titulación en Poesía, Cuento, Ensayo e Investigación avalado por la Escuela Gorostiza y UJAT.
        </p>
      </div>
      <a 
        href="#publicaciones" 
        class="whitespace-nowrap px-6 py-3 bg-[#EF7B38] hover:bg-[#D96620] text-white text-xs font-title font-bold tracking-wider uppercase rounded-xl transition-all shadow-md"
      >
        Ver en Librería
      </a>
    </div>

  </div>
</section>
