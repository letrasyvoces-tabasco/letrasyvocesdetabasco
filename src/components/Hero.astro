---
// Hero.astro - Pórtico Editorial y Rotador Dinámico con Sello Institucional de Marca
const basePath = "/letrasyvocesdetabasco";
---

<section id="inicio" class="relative pt-36 pb-24 lg:pt-48 lg:pb-36 hero-bg text-white overflow-hidden">
  
  <!-- Marca de Agua y Sello Institucional Vectorial de Fondo -->
  <div class="absolute inset-0 flex items-center justify-center opacity-5 pointer-events-none overflow-hidden">
    <img 
      src={`${basePath}/assets/logos/LVT Logo Iso 6 Blanco Relleno.svg`} 
      alt="Sello de Fondo LVT" 
      class="w-[700px] sm:w-[900px] h-auto object-contain select-none" 
    />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center flex flex-col items-center">
    
    <!-- Distintivo Superior de Prestigio -->
    <div class="inline-flex items-center gap-3 px-5 py-2 rounded-full border border-dorado/40 bg-dorado/15 text-dorado-light text-xs font-title font-bold tracking-widest uppercase mb-8 shadow-elevated backdrop-blur-md">
      <span class="w-2.5 h-2.5 rounded-full bg-terracota animate-pulse"></span>
      <span>Sociedad de Escritores • Villahermosa, Tabasco, México</span>
    </div>

    <!-- Título Principal con Rotador Dinámico -->
    <div class="min-h-[150px] sm:min-h-[190px] md:min-h-[240px] flex items-center justify-center">
      <h1 id="hero-phrase" class="font-serif text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-normal text-white max-w-5xl leading-[1.08] tracking-tight phrase-fade drop-shadow-md">
        Preservamos la palabra,<br />
        <span class="italic font-light text-gray-200">impulsamos la lírica del Sureste.</span>
      </h1>
    </div>

    <!-- Subtítulo de Rigor Institucional -->
    <p class="text-base sm:text-lg md:text-xl font-light text-gray-300 max-w-3xl leading-relaxed mt-6 mb-12">
      Institución civil legalmente constituida para cultivar la creación literaria, coordinar ediciones colectivas rigurosas y difundir el patrimonio cultural de Tabasco.
    </p>

    <!-- Botones de Acción de Alta Gama -->
    <div class="flex flex-col sm:flex-row gap-5 justify-center w-full max-w-md sm:max-w-none">
      <a 
        href="#antologias" 
        class="inline-flex justify-center items-center px-9 py-4 rounded-full bg-terracota text-white font-title text-xs font-bold uppercase tracking-wider hover:bg-terracota-hover shadow-elevated hover:shadow-terracota-glow hover:-translate-y-1 transition duration-300"
      >
        Ver «Animalia Literaria» (En Imprenta)
        <svg class="ml-3 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
      <a 
        href="#rifa" 
        class="inline-flex justify-center items-center px-9 py-4 rounded-full border border-gray-400/60 text-white font-title text-xs font-bold uppercase tracking-wider hover:border-white hover:bg-white/10 hover:-translate-y-1 transition duration-300 backdrop-blur-sm"
      >
        Iniciativa Pro-Fondos ($100 MXN)
      </a>
    </div>

    <!-- Franja de Hitos Institucionales Históricos -->
    <div class="mt-20 pt-12 border-t border-gray-800/90 grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-10 w-full max-w-4xl text-center">
      <div class="bg-carbon-card/60 p-5 rounded-3xl border border-gray-800/80 backdrop-blur-md shadow-subtle hover:border-terracota/50 transition">
        <span class="block font-serif text-3xl sm:text-4xl font-bold text-terracota">+38</span>
        <span class="text-[11px] font-title font-semibold tracking-wider text-gray-300 uppercase">Años de Historia</span>
      </div>
      <div class="bg-carbon-card/60 p-5 rounded-3xl border border-gray-800/80 backdrop-blur-md shadow-subtle hover:border-dorado/50 transition">
        <span class="block font-serif text-3xl sm:text-4xl font-bold text-white">+100</span>
        <span class="text-[11px] font-title font-semibold tracking-wider text-gray-300 uppercase">Escritores en su Historia</span>
      </div>
      <div class="bg-carbon-card/60 p-5 rounded-3xl border border-gray-800/80 backdrop-blur-md shadow-subtle hover:border-dorado/50 transition">
        <span class="block font-serif text-3xl sm:text-4xl font-bold text-dorado">+25</span>
        <span class="text-[11px] font-title font-semibold tracking-wider text-gray-300 uppercase">Ediciones Impresas</span>
      </div>
      <div class="bg-carbon-card/60 p-5 rounded-3xl border border-gray-800/80 backdrop-blur-md shadow-subtle hover:border-terracota/50 transition">
        <span class="block font-serif text-3xl sm:text-4xl font-bold text-white">100%</span>
        <span class="text-[11px] font-title font-semibold tracking-wider text-gray-300 uppercase">Autonomía Cultural</span>
      </div>
    </div>

  </div>
</section>

<script>
  // Rotador Dinámico de Citas en el Hero
  const phrases = [
    'Preservamos la palabra,<br><span class="italic font-light text-gray-200">impulsamos la lírica del Sureste.</span>',
    'Más de 38 años de memoria literaria<br><span class="italic font-light text-gray-200">e historia colectiva en Tabasco.</span>',
    'Voces que trascienden el trópico:<br><span class="italic font-light text-gray-200">poesía, narrativa y rigor editorial.</span>',
    'Un espacio independiente de encuentro,<br><span class="italic font-light text-gray-200">diálogo y divulgación cultural.</span>'
  ];
  let currentPhraseIdx = 0;
  const phraseEl = document.getElementById('hero-phrase');

  if (phraseEl) {
    setInterval(() => {
      phraseEl.style.opacity = '0';
      phraseEl.style.transform = 'translateY(8px)';
      setTimeout(() => {
        currentPhraseIdx = (currentPhraseIdx + 1) % phrases.length;
        phraseEl.innerHTML = phrases[currentPhraseIdx];
        phraseEl.style.opacity = '1';
        phraseEl.style.transform = 'translateY(0)';
      }, 600);
    }, 4800);
  }
</script>
