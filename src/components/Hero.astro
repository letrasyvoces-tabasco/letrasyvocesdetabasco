---
// Hero.astro - Pórtico Editorial Proporcionado, Tipografía Legible y Navegación Ejecutiva LVT
const basePath = "/letrasyvocesdetabasco";
---

<section id="inicio" class="relative pt-24 pb-12 sm:pt-28 sm:pb-14 lg:pt-28 lg:pb-14 bg-[#141210] text-white overflow-hidden border-b border-[#2D241E]">
  
  <!-- ================================================================= -->
  <!-- 1. CAPAS ATMOSFÉRICAS Y CARRUSEL DE FONDOS CON TRANSICIÓN SUAVE    -->
  <!-- ================================================================= -->
  <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
    
    <!-- Escena 1: Encuentros y Eventos Culturales LVT -->
    <div 
      id="hero-bg-1" 
      class="hero-bg-slide absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-20 scale-102 transform"
      style={`background-image: url('${basePath}/assets/galeria/evento_cacao_01.jpg');`}
    ></div>

    <!-- Escena 2: Acervo y Colecciones Editoriales -->
    <div 
      id="hero-bg-2" 
      class="hero-bg-slide absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 scale-102 transform"
      style={`background-image: url('${basePath}/assets/galeria/evento_cacao_03.jpg');`}
    ></div>

    <!-- Escena 3: Escuela de Escritores «José Gorostiza» y Claustro -->
    <div 
      id="hero-bg-3" 
      class="hero-bg-slide absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 scale-102 transform"
      style={`background-image: url('${basePath}/assets/galeria/evento_cacao_05.jpg');`}
    ></div>

    <!-- Gradientes de Contraste Óptimo -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#141210]/95 via-[#141210]/85 to-[#141210]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#EF7B38]/15 via-transparent to-transparent"></div>
    
    <!-- Resplandor dinámico -->
    <div id="hero-mouse-glow" class="absolute w-96 h-96 bg-[#EF7B38]/10 rounded-full blur-3xl transition-all duration-300 pointer-events-none -top-20 -left-20"></div>

    <!-- Marca de Agua Vectorial Institucional -->
    <div class="absolute inset-0 flex items-center justify-center opacity-[0.025] pointer-events-none">
      <img 
        src={`${basePath}/assets/logos/LVT Logo Iso 6 Blanco Relleno.svg`} 
        alt="Sello de Fondo LVT" 
        class="w-[500px] sm:w-[650px] h-auto object-contain select-none" 
      />
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center flex flex-col items-center">
    
    <!-- Cintillo de Novedades -->
    <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full border border-[#C59B27]/40 bg-[#1C1814]/90 text-[#F5DEB3] text-xs sm:text-sm font-title font-bold tracking-wider uppercase mb-3 shadow-md backdrop-blur-md">
      <span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-pulse"></span>
      <span id="hero-live-announcement" class="transition-opacity duration-300">
        XXXIX Aniversario (1987 – 2026) · Sociedad de Escritores LVT
      </span>
    </div>

    <!-- Título Principal Proporcionado y Altamente Legible -->
    <div class="min-h-[75px] sm:min-h-[95px] md:min-h-[120px] flex items-center justify-center">
      <h1 id="hero-phrase" class="font-serif text-3xl sm:text-5xl md:text-6xl font-normal text-white max-w-4xl leading-tight tracking-tight drop-shadow-lg transition-all duration-500">
        Preservamos la palabra,<br />
        <span class="italic font-light text-[#EF7B38]">impulsamos la lírica del Sureste.</span>
      </h1>
    </div>

    <!-- Subtítulo -->
    <p class="text-sm sm:text-base md:text-lg font-light text-gray-200 max-w-2xl leading-relaxed mt-2 mb-5 drop-shadow-sm">
      Institución civil fundada en 1987 para cultivar la creación literaria, coordinar ediciones colectivas de excelencia y difundir el patrimonio cultural de Tabasco.
    </p>

    <!-- Botones de Acción -->
    <div class="flex flex-wrap gap-3 justify-center w-full max-w-2xl mb-6">
      <a 
        href={`${basePath}/publicaciones`} 
        class="inline-flex justify-center items-center px-6 py-3 rounded-full bg-[#EF7B38] hover:bg-[#D96620] text-white font-title text-xs sm:text-sm font-bold uppercase tracking-wider shadow-lg hover:scale-102 transition duration-200 gap-2 cursor-pointer"
      >
        <span>Explorar Catálogo Editorial</span>
        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>

      <a 
        href={`${basePath}/escuela`} 
        class="inline-flex justify-center items-center px-6 py-3 rounded-full border border-[#EF7B38]/60 bg-[#1C1814]/90 hover:bg-[#EF7B38]/20 text-[#EF7B38] font-title text-xs sm:text-sm font-bold uppercase tracking-wider backdrop-blur-md shadow-md hover:scale-102 transition duration-200 gap-1.5 cursor-pointer"
      >
        <span>🎓 Escuela Gorostiza (10 Diplomados)</span>
      </a>

      <a 
        href={`${basePath}/audioteca`} 
        class="inline-flex justify-center items-center px-6 py-3 rounded-full border border-[#C59B27]/60 bg-[#1C1814]/90 hover:bg-[#C59B27]/20 text-[#F5DEB3] font-title text-xs sm:text-sm font-bold uppercase tracking-wider backdrop-blur-md shadow-md hover:scale-102 transition duration-200 gap-1.5 cursor-pointer"
      >
        <span>🎙️ Audioteca (14 Obras Nativas)</span>
      </a>
    </div>

    <!-- Showcase Interactivo: 4 Ejes Fundamentales (Compacto y en Pantalla) -->
    <div class="w-full max-w-5xl mb-6 text-left">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        
        <!-- Eje 1: Nueva Antología 2026 -->
        <a 
          href={`${basePath}/publicaciones`} 
          class="hero-pillar-card p-4 rounded-2xl bg-[#1C1814]/90 border border-[#3A2E26] hover:border-[#EF7B38] transition-all duration-200 shadow-md flex flex-col justify-between group hover:-translate-y-0.5 backdrop-blur-md"
        >
          <div class="space-y-1.5">
            <div class="flex justify-between items-center">
              <span class="px-2.5 py-0.5 rounded-full bg-[#EF7B38]/20 text-[#EF7B38] text-[10px] font-title font-bold uppercase">
                En Prensa 2026
              </span>
              <span class="text-sm text-gray-400 group-hover:text-white transition">↗</span>
            </div>
            <h4 class="font-title font-bold text-sm sm:text-base text-white group-hover:text-[#EF7B38] transition">
              «Animalia Literaria»
            </h4>
            <p class="text-xs text-gray-300 font-serif italic line-clamp-2">
              16 plumas tabasqueñas en diálogo con la fauna y la selva del Sureste.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-gray-800/80 text-[10px] sm:text-xs font-title font-bold text-[#F5DEB3] uppercase">
            Ver 5 Antologías Oficiales
          </div>
        </a>

        <!-- Eje 2: Escuela Gorostiza -->
        <a 
          href={`${basePath}/escuela`} 
          class="hero-pillar-card p-4 rounded-2xl bg-[#1C1814]/90 border border-[#3A2E26] hover:border-[#EF7B38] transition-all duration-200 shadow-md flex flex-col justify-between group hover:-translate-y-0.5 backdrop-blur-md"
        >
          <div class="space-y-1.5">
            <div class="flex justify-between items-center">
              <span class="px-2.5 py-0.5 rounded-full bg-[#EF7B38]/20 text-[#EF7B38] text-[10px] font-title font-bold uppercase">
                Validez UJAT
              </span>
              <span class="text-sm text-gray-400 group-hover:text-white transition">↗</span>
            </div>
            <h4 class="font-title font-bold text-sm sm:text-base text-white group-hover:text-[#EF7B38] transition">
              Escuela Gorostiza
            </h4>
            <p class="text-xs text-gray-300 font-serif italic line-clamp-2">
              10 Diplomados, 7 Cursos y Talleres continuos presenciales y en línea.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-gray-800/80 text-[10px] sm:text-xs font-title font-bold text-[#F5DEB3] uppercase">
            Consultar Oferta 2026
          </div>
        </a>

        <!-- Eje 3: Audioteca Patrimonial -->
        <a 
          href={`${basePath}/audioteca`} 
          class="hero-pillar-card p-4 rounded-2xl bg-[#1C1814]/90 border border-[#3A2E26] hover:border-[#C59B27] transition-all duration-200 shadow-md flex flex-col justify-between group hover:-translate-y-0.5 backdrop-blur-md"
        >
          <div class="space-y-1.5">
            <div class="flex justify-between items-center">
              <span class="px-2.5 py-0.5 rounded-full bg-[#C59B27]/20 text-[#F5DEB3] text-[10px] font-title font-bold uppercase">
                14 Obras MP3
              </span>
              <span class="text-sm text-gray-400 group-hover:text-white transition">↗</span>
            </div>
            <h4 class="font-title font-bold text-sm sm:text-base text-white group-hover:text-[#C59B27] transition">
              Audioteca Lírica
            </h4>
            <p class="text-xs text-gray-300 font-serif italic line-clamp-2">
              Grabaciones de Girondo, Rulfo, García Lorca, Sabines y Cortázar.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-gray-800/80 text-[10px] sm:text-xs font-title font-bold text-[#F5DEB3] uppercase">
            Escuchar Reproductores
          </div>
        </a>

        <!-- Eje 4: Convocatorias & Nuevos Socios -->
        <a 
          href={`${basePath}/descargas#convocatorias`} 
          class="hero-pillar-card p-4 rounded-2xl bg-[#1C1814]/90 border border-[#3A2E26] hover:border-[#C59B27] transition-all duration-200 shadow-md flex flex-col justify-between group hover:-translate-y-0.5 backdrop-blur-md"
        >
          <div class="space-y-1.5">
            <div class="flex justify-between items-center">
              <span class="px-2.5 py-0.5 rounded-full bg-[#C59B27]/20 text-[#F5DEB3] text-[10px] font-title font-bold uppercase">
                Convocatoria
              </span>
              <span class="text-sm text-gray-400 group-hover:text-white transition">↗</span>
            </div>
            <h4 class="font-title font-bold text-sm sm:text-base text-white group-hover:text-[#C59B27] transition">
              Nuevos Socios LVT
            </h4>
            <p class="text-xs text-gray-300 font-serif italic line-clamp-2">
              Proceso abierto de afiliación gremial y directorio de concursos literarios.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-gray-800/80 text-[10px] sm:text-xs font-title font-bold text-[#F5DEB3] uppercase">
            Bases & Postulación
          </div>
        </a>

      </div>
    </div>

    <!-- Métricas Institucionales Compactas -->
    <div class="pt-4 border-t border-gray-800/80 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 w-full max-w-3xl text-center">
      <div class="bg-[#1C1814]/70 py-3 px-3 rounded-xl border border-gray-800/80 backdrop-blur-sm">
        <span class="block font-serif text-2xl sm:text-3xl font-bold text-[#EF7B38]">+38</span>
        <span class="text-[10px] sm:text-xs font-title font-semibold tracking-wider text-gray-200 uppercase">Años de Trayectoria</span>
      </div>
      <div class="bg-[#1C1814]/70 py-3 px-3 rounded-xl border border-gray-800/80 backdrop-blur-sm">
        <span class="block font-serif text-2xl sm:text-3xl font-bold text-white">+100</span>
        <span class="text-[10px] sm:text-xs font-title font-semibold tracking-wider text-gray-200 uppercase">Escritores Históricos</span>
      </div>
      <div class="bg-[#1C1814]/70 py-3 px-3 rounded-xl border border-gray-800/80 backdrop-blur-sm">
        <span class="block font-serif text-2xl sm:text-3xl font-bold text-[#F5DEB3]">+25</span>
        <span class="text-[10px] sm:text-xs font-title font-semibold tracking-wider text-gray-200 uppercase">Obras Editadas</span>
      </div>
      <div class="bg-[#1C1814]/70 py-3 px-3 rounded-xl border border-gray-800/80 backdrop-blur-sm">
        <span class="block font-serif text-2xl sm:text-3xl font-bold text-white">100%</span>
        <span class="text-[10px] sm:text-xs font-title font-semibold tracking-wider text-gray-200 uppercase">Autonomía Gremial</span>
      </div>
    </div>

  </div>
</section>

<script>
  // 1. Carrusel de Fondos con Transición Suave
  const bgSlides = [
    document.getElementById('hero-bg-1'),
    document.getElementById('hero-bg-2'),
    document.getElementById('hero-bg-3')
  ];
  let currentBgIdx = 0;

  if (bgSlides[0] && bgSlides[1] && bgSlides[2]) {
    setInterval(() => {
      bgSlides[currentBgIdx]?.classList.remove('opacity-20');
      bgSlides[currentBgIdx]?.classList.add('opacity-0');
      
      currentBgIdx = (currentBgIdx + 1) % bgSlides.length;
      
      bgSlides[currentBgIdx]?.classList.remove('opacity-0');
      bgSlides[currentBgIdx]?.classList.add('opacity-20');
    }, 6000);
  }

  // 2. Rotador Dinámico de Citas Líricas
  const phrases = [
    'Preservamos la palabra,<br><span class="italic font-light text-[#EF7B38]">impulsamos la lírica del Sureste.</span>',
    'Más de 38 años de memoria literaria<br><span class="italic font-light text-[#F5DEB3]">e historia colectiva en Tabasco.</span>',
    'Voces que trascienden el trópico:<br><span class="italic font-light text-[#EF7B38]">poesía, narrativa y rigor editorial.</span>',
    'Un espacio independiente de encuentro,<br><span class="italic font-light text-[#F5DEB3]">diálogo y creación cultural.</span>'
  ];
  let currentPhraseIdx = 0;
  const phraseEl = document.getElementById('hero-phrase');

  if (phraseEl) {
    setInterval(() => {
      phraseEl.style.opacity = '0';
      phraseEl.style.transform = 'translateY(4px)';
      setTimeout(() => {
        currentPhraseIdx = (currentPhraseIdx + 1) % phrases.length;
        phraseEl.innerHTML = phrases[currentPhraseIdx];
        phraseEl.style.opacity = '1';
        phraseEl.style.transform = 'translateY(0)';
      }, 400);
    }, 5000);
  }

  // 3. Rotador de Anuncios y Novedades
  const announcements = [
    'XXXIX Aniversario (1987 – 2026) · Sociedad de Escritores LVT',
    '📚 En Prensa: «Animalia Literaria» — Antología 2026',
    '🎓 Escuela Gorostiza: 10 Diplomados y 7 Cursos Actualizados 2026',
    '🎙️ Audioteca Activa: 14 Obras en Audio Nativo MP3',
    '✍️ Convocatoria Abierta: Proceso de Afiliación Nuevos Socios LVT'
  ];
  let currentAnnounceIdx = 0;
  const announceEl = document.getElementById('hero-live-announcement');

  if (announceEl) {
    setInterval(() => {
      announceEl.style.opacity = '0';
      setTimeout(() => {
        currentAnnounceIdx = (currentAnnounceIdx + 1) % announcements.length;
        announceEl.innerText = announcements[currentAnnounceIdx];
        announceEl.style.opacity = '1';
      }, 400);
    }, 4500);
  }

  // 4. Efecto de Resplandor con el Mouse
  const glow = document.getElementById('hero-mouse-glow');
  const heroSection = document.getElementById('inicio');

  if (glow && heroSection) {
    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      glow.style.transform = `translate(${x - 200}px, ${y - 200}px)`;
    });
  }
</script>
