// Cálculo de fotos totales
const totalFotosGlobal = ALBUMES_EVENTOS.reduce((acc, alb) => acc + alb.fotos.length, 0);
---

<section id="galeria" class="py-16 sm:py-20 bg-[#12100E] text-white border-b border-[#2C241D] relative overflow-hidden">
  
  <!-- Fondo ambiental suave -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-[#EF7B38]/10 rounded-full blur-[140px]"></div>
    <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-[#C59B27]/10 rounded-full blur-[140px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-10">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/20 text-[#F5DEB3] font-title text-[10px] sm:text-xs font-bold uppercase tracking-widest backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-pulse"></span>
        <span>Archivo Fotográfico Institucional por Eventos</span>
      </div>

      <h2 class="font-monograph text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        Memoria Gráfica <span class="italic bg-gradient-to-r from-[#EF7B38] via-[#F5DEB3] to-[#C59B27] bg-clip-text text-transparent">de Nuestros Eventos</span>
      </h2>

      <p class="text-xs sm:text-sm md:text-base text-gray-300 font-serif italic max-w-2xl mx-auto leading-relaxed">
        Colección gráfica organizada por eventos y presentaciones editoriales. Selecciona un álbum para explorar su galería fotográfica completa.
      </p>

      <div class="w-20 h-0.5 bg-[#EF7B38] mx-auto rounded-full"></div>
    </div>

    <!-- Cuadrícula de Portadas de Álbumes (Una sola tarjeta por evento) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {ALBUMES_EVENTOS.map((album, albumIndex) => (
        <div 
          class="album-card group relative overflow-hidden rounded-3xl bg-[#1C1814] border border-white/10 shadow-elevated cursor-pointer hover:border-[#EF7B38] transition-all duration-500 hover:shadow-2xl flex flex-col justify-between"
          data-album-id={album.id}
          data-album-index={albumIndex}
        >
          <!-- Portada del Álbum con Efecto Zoom y Overlay -->
          <div class="aspect-[4/3] w-full overflow-hidden bg-black/40 relative">
            <img 
              src={album.portada} 
              alt={album.titulo} 
              class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 opacity-90 group-hover:opacity-100"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1C1814] via-black/30 to-transparent opacity-85 group-hover:opacity-60 transition duration-300"></div>
            
            <!-- Badge de Categoría Superior -->
            <div class="absolute top-3.5 left-3.5 flex items-center gap-2">
              <span class="px-3 py-1 rounded-full bg-black/75 backdrop-blur-md text-[10px] font-title font-bold uppercase tracking-wider text-[#F5DEB3] border border-white/15 shadow-sm">
                {album.categoriaBadge}
              </span>
            </div>

            <!-- Contador de Fotos del Álbum -->
            <div class="absolute top-3.5 right-3.5">
              <span class="px-3 py-1 rounded-full bg-[#EF7B38]/90 backdrop-blur-md text-white text-[10px] font-title font-bold uppercase tracking-wider shadow-md flex items-center gap-1">
                <span>📷 {album.fotos.length} {album.fotos.length === 1 ? 'Foto' : 'Fotos'}</span>
              </span>
            </div>

            <!-- Botón Flotante de Apertura -->
            <div class="absolute bottom-3.5 right-3.5 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
              <span class="px-3.5 py-1.5 rounded-xl bg-white text-[#222222] text-xs font-title font-bold uppercase tracking-wider shadow-lg flex items-center gap-1">
                <span>Ver Álbum →</span>
              </span>
            </div>
          </div>

          <!-- Información del Álbum -->
          <div class="p-5 sm:p-6 space-y-2.5">
            <div class="flex items-center justify-between text-[11px] text-[#C59B27] font-serif italic">
              <span>{album.subtitulo}</span>
              <span>{album.fecha}</span>
            </div>

            <h3 class="font-serif text-lg sm:text-xl font-bold text-white group-hover:text-[#EF7B38] transition leading-snug">
              {album.titulo}
            </h3>

            <p class="text-xs text-gray-400 font-sans line-clamp-2 leading-relaxed">
              {album.resumen}
            </p>

            <div class="pt-3 border-t border-white/10 flex items-center justify-between text-[11px] text-gray-400 font-sans">
              <span class="truncate max-w-[200px]">📍 {album.lugar}</span>
              <span class="text-[#EF7B38] font-title font-bold group-hover:translate-x-1 transition duration-300 flex items-center gap-1">
                <span>Abrir galería</span>
                <span>↗</span>
              </span>
            </div>
          </div>
        </div>
      ))}

      <!-- Tarjeta Final: Ver Todas las Fotos del Archivo (Requerimiento de última opción) -->
      <div 
        id="btn-open-all-photos"
        class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#251D17] to-[#171310] border-2 border-dashed border-[#EF7B38]/40 hover:border-[#EF7B38] shadow-elevated cursor-pointer transition-all duration-500 hover:shadow-2xl flex flex-col items-center justify-center p-8 text-center"
      >
        <div class="w-16 h-16 rounded-2xl bg-[#EF7B38]/15 border border-[#EF7B38]/30 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-[#EF7B38] transition duration-300">
          <span class="text-3xl group-hover:text-white transition">📁</span>
        </div>

        <span class="px-3 py-1 rounded-full bg-[#EF7B38]/20 text-[#F5DEB3] text-[10px] font-title font-bold uppercase tracking-wider mb-2">
          Archivo Completo
        </span>

        <h3 class="font-serif text-lg font-bold text-white group-hover:text-[#EF7B38] transition mb-2">
          Ver Todas las Fotografías
        </h3>

        <p class="text-xs text-gray-400 font-sans max-w-xs leading-relaxed mb-4">
          Explora el visor continuo con las <strong>{totalFotosGlobal} imágenes</strong> de todos los eventos históricos.
        </p>

        <span class="px-4 py-2 rounded-xl bg-[#222222] group-hover:bg-[#EF7B38] text-white text-xs font-title font-bold uppercase tracking-wider transition shadow-sm">
          Ver Todo ({totalFotosGlobal} Fotos) →
        </span>
      </div>
    </div>

  </div>
</section>

<!-- Lightbox Modal de Álbum con Visor Interactivo y Navegación -->
<div 
  id="gallery-lightbox" 
  class="fixed inset-0 z-50 hidden bg-black/95 backdrop-blur-xl flex items-center justify-center p-4 sm:p-6 transition-all duration-300"
  role="dialog" 
  aria-modal="true" 
  aria-label="Visor ampliado del evento"
>
  <div class="relative w-full max-w-5xl max-h-[92vh] flex flex-col items-center justify-between">
    
    <!-- Barra Superior de Control -->
    <div class="w-full flex items-center justify-between pb-3 text-white border-b border-white/15 mb-3">
      <div class="flex items-center gap-2">
        <span id="lightbox-counter" class="px-3 py-1 rounded-full bg-[#EF7B38]/90 text-xs font-mono font-bold text-white shadow-sm">
          Foto 1 de 5
        </span>
        <span id="lightbox-album-name" class="text-xs font-title font-bold uppercase tracking-wider text-gray-300 truncate max-w-[200px] sm:max-w-md">
          Presentación de Obra
        </span>
      </div>

      <div class="flex items-center gap-3">
        <button 
          id="close-gallery-lightbox" 
          type="button" 
          class="px-3.5 py-1.5 rounded-xl bg-white/10 hover:bg-[#EF7B38] text-white font-title text-xs font-bold uppercase tracking-wider transition flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span>Cerrar (Esc)</span>
        </button>
      </div>
    </div>

    <!-- Contenedor Central de Imagen con Botones de Navegación -->
    <div class="relative w-full flex items-center justify-center overflow-hidden min-h-[320px] sm:min-h-[480px]">
      
      <!-- Botón Anterior -->
      <button 
        id="lightbox-prev" 
        type="button"
        class="absolute left-2 sm:left-4 z-20 p-3 rounded-full bg-black/70 hover:bg-[#EF7B38] text-white transition-all duration-200 border border-white/20 shadow-xl backdrop-blur-md cursor-pointer hover:scale-110"
        aria-label="Fotografía anterior"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Imagen Central con Transición Suave -->
      <img 
        id="lightbox-img" 
        src="" 
        alt="Fotografía ampliada del evento" 
        class="max-h-[58vh] sm:max-h-[66vh] max-w-full w-auto rounded-2xl shadow-2xl object-contain transition-all duration-300 transform scale-95" 
      />

      <!-- Botón Siguiente -->
      <button 
        id="lightbox-next" 
        type="button"
        class="absolute right-2 sm:right-4 z-20 p-3 rounded-full bg-black/70 hover:bg-[#EF7B38] text-white transition-all duration-200 border border-white/20 shadow-xl backdrop-blur-md cursor-pointer hover:scale-110"
        aria-label="Fotografía siguiente"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

    </div>

    <!-- Barra Inferior de Información y Pie de Foto -->
    <div class="w-full text-center mt-3 pt-3 border-t border-white/15 space-y-1">
      <h3 id="lightbox-title" class="font-serif text-base sm:text-lg font-bold text-white leading-tight"></h3>
      <p id="lightbox-desc" class="text-xs sm:text-sm text-gray-300 font-sans max-w-3xl mx-auto leading-relaxed"></p>
      <div id="lightbox-meta" class="text-[11px] text-[#C59B27] font-serif italic"></div>
    </div>

  </div>
</div>

<!-- Serialización de Datos para JavaScript -->
<script define:vars={{ ALBUMES_EVENTOS }}>
  // Manejo Dinámico de Álbumes por Evento y Lightbox
  const albumCards = document.querySelectorAll('.album-card');
  const btnOpenAll = document.getElementById('btn-open-all-photos');
  
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const lightboxMeta = document.getElementById('lightbox-meta');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const lightboxAlbumName = document.getElementById('lightbox-album-name');
  const closeBtn = document.getElementById('close-gallery-lightbox');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  let currentPhotosList = [];
  let currentPhotoIndex = 0;
  let currentAlbumTitle = '';

  // 1. Abrir Álbum Específico
  albumCards.forEach(card => {
    card.addEventListener('click', () => {
      const albumIdx = parseInt(card.getAttribute('data-album-index') || '0', 10);
      const album = ALBUMES_EVENTOS[albumIdx];
      if (album && album.fotos.length > 0) {
        currentPhotosList = album.fotos;
        currentPhotoIndex = 0;
        currentAlbumTitle = album.titulo;
        openLightboxAt(0);
      }
    });
  });

  // 2. Abrir Todas las Fotos del Archivo (Última Opción)
  if (btnOpenAll) {
    btnOpenAll.addEventListener('click', () => {
      // Unir todas las fotos en una sola lista continua
      currentPhotosList = ALBUMES_EVENTOS.flatMap(a => a.fotos.map(f => ({ ...f, albumName: a.titulo })));
      currentPhotoIndex = 0;
      currentAlbumTitle = 'Archivo Histórico Completo';
      openLightboxAt(0);
    });
  }

  // 3. Renderizar Foto en el Lightbox
  function openLightboxAt(index) {
    if (currentPhotosList.length === 0) return;
    currentPhotoIndex = (index + currentPhotosList.length) % currentPhotosList.length;
    const photo = currentPhotosList[currentPhotoIndex];

    if (lightboxImg) {
      lightboxImg.style.opacity = '0';
      lightboxImg.style.transform = 'scale(0.95)';
      setTimeout(() => {
        lightboxImg.src = photo.src;
        lightboxImg.style.opacity = '1';
        lightboxImg.style.transform = 'scale(1)';
      }, 120);
    }

    if (lightboxTitle) lightboxTitle.innerText = photo.titulo;
    if (lightboxDesc) lightboxDesc.innerText = photo.descripcion;
    if (lightboxMeta) lightboxMeta.innerText = `${photo.lugar} · ${photo.fecha}`;
    if (lightboxCounter) lightboxCounter.innerText = `Foto ${currentPhotoIndex + 1} de ${currentPhotosList.length}`;
    if (lightboxAlbumName) lightboxAlbumName.innerText = photo.albumName || currentAlbumTitle;

    if (lightbox) {
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  // 4. Navegación Anterior / Siguiente
  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openLightboxAt(currentPhotoIndex - 1);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openLightboxAt(currentPhotoIndex + 1);
    });
  }

  // 5. Cerrar Lightbox
  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  // 6. Teclado (Escape, Flechas)
  window.addEventListener('keydown', (e) => {
    if (lightbox && !lightbox.classList.contains('hidden')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') openLightboxAt(currentPhotoIndex - 1);
      if (e.key === 'ArrowRight') openLightboxAt(currentPhotoIndex + 1);
    }
  });
</script>
