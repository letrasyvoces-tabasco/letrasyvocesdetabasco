---

<section id="galeria" class="py-16 sm:py-20 bg-[#12100E] text-white border-b border-[#2C241D] relative overflow-hidden">
  
  <!-- Fondo con destellos ambientales -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-[#EF7B38]/10 rounded-full blur-[140px]"></div>
    <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-[#C59B27]/10 rounded-full blur-[140px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-10">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/20 text-[#F5DEB3] font-title text-[10px] sm:text-xs font-bold uppercase tracking-widest backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-[#EF7B38] animate-pulse"></span>
        <span>Memoria Gráfica & Archivo Fotográfico Institucional</span>
      </div>

      <h2 class="font-monograph text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        Crónica Visual de <span class="italic bg-gradient-to-r from-[#EF7B38] via-[#F5DEB3] to-[#C59B27] bg-clip-text text-transparent">Nuestros Eventos</span>
      </h2>

      <p class="text-xs sm:text-sm md:text-base text-gray-300 font-serif italic max-w-2xl mx-auto leading-relaxed">
        Testimonio fotográfico de presentaciones de libros, conversatorios de la Escuela de Escritores, sesiones solemnes y asambleas de la Sociedad.
      </p>

      <div class="w-20 h-0.5 bg-[#EF7B38] mx-auto rounded-full"></div>
    </div>

    <!-- Botones de Filtrado de Eventos -->
    <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-3 max-w-4xl mx-auto">
      <button 
        type="button" 
        data-filter="todos" 
        class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-title font-bold uppercase tracking-wider transition-all duration-300 bg-[#EF7B38] text-white shadow-lg cursor-pointer"
      >
        🌟 Todos ({FOTOS_EVENTOS.length})
      </button>
      <button 
        type="button" 
        data-filter="cacao" 
        class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-title font-bold uppercase tracking-wider transition-all duration-300 bg-white/5 hover:bg-white/15 text-gray-300 hover:text-white border border-white/10 cursor-pointer"
      >
        📖 «A corazón abierto»
      </button>
      <button 
        type="button" 
        data-filter="antologias" 
        class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-title font-bold uppercase tracking-wider transition-all duration-300 bg-white/5 hover:bg-white/15 text-gray-300 hover:text-white border border-white/10 cursor-pointer"
      >
        📚 Antologías Colectivas
      </button>
      <button 
        type="button" 
        data-filter="escuela" 
        class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-title font-bold uppercase tracking-wider transition-all duration-300 bg-white/5 hover:bg-white/15 text-gray-300 hover:text-white border border-white/10 cursor-pointer"
      >
        🎓 Escuela de Escritores
      </button>
      <button 
        type="button" 
        data-filter="aniversarios" 
        class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-title font-bold uppercase tracking-wider transition-all duration-300 bg-white/5 hover:bg-white/15 text-gray-300 hover:text-white border border-white/10 cursor-pointer"
      >
        🏛️ Aniversarios LVT
      </button>
    </div>

    <!-- Cuadrícula Fotográfica Dinámica con Animaciones de Apertura -->
    <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {FOTOS_EVENTOS.map((foto, index) => (
        <div 
          class="gallery-card group relative overflow-hidden rounded-3xl bg-[#1C1814] border border-white/10 shadow-elevated cursor-pointer hover:border-[#EF7B38] transition-all duration-500 hover:shadow-2xl flex flex-col justify-between"
          data-category={foto.categoria}
          data-index={index}
          data-src={foto.src}
          data-title={foto.titulo}
          data-evento={foto.evento}
          data-lugar={foto.lugar}
          data-fecha={foto.fecha}
          data-desc={foto.descripcion}
        >
          <!-- Contenedor de Imagen con Efecto Zoom & Apertura -->
          <div class="aspect-[4/3] w-full overflow-hidden bg-black/40 relative">
            <img 
              src={foto.src} 
              alt={foto.titulo} 
              class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 opacity-90 group-hover:opacity-100"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1C1814] via-transparent to-transparent opacity-80 group-hover:opacity-60 transition duration-300"></div>
            
            <!-- Badge de Categoría Flotante -->
            <div class="absolute top-3.5 left-3.5">
              <span class="px-3 py-1 rounded-full bg-black/70 backdrop-blur-md text-[10px] font-title font-bold uppercase tracking-wider text-[#F5DEB3] border border-white/15 shadow-sm">
                {foto.categoriaLabel}
              </span>
            </div>

            <!-- Botón flotante para ver en grande -->
            <div class="absolute bottom-3.5 right-3.5 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
              <span class="px-3 py-1.5 rounded-xl bg-[#EF7B38] text-white text-xs font-title font-bold uppercase tracking-wider shadow-md flex items-center gap-1">
                <span>🔍 Ampliar</span>
              </span>
            </div>
          </div>

          <!-- Información del Pie de Foto -->
          <div class="p-5 sm:p-6 space-y-2">
            <div class="flex items-center justify-between text-[11px] text-[#C59B27] font-serif italic">
              <span>{foto.evento}</span>
              <span>{foto.fecha}</span>
            </div>

            <h4 class="font-serif text-lg font-bold text-white group-hover:text-[#EF7B38] transition leading-snug">
              {foto.titulo}
            </h4>

            <p class="text-xs text-gray-400 font-sans line-clamp-2 leading-relaxed">
              {foto.descripcion}
            </p>

            <div class="pt-3 border-t border-white/10 flex items-center justify-between text-[11px] text-gray-500 font-sans">
              <span class="truncate max-w-[200px]">📍 {foto.lugar}</span>
              <span class="text-[#EF7B38] font-title font-bold group-hover:translate-x-1 transition duration-300">Ver foto →</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- Lightbox Multi-Evento con Controles Avanzados -->
<div 
  id="gallery-lightbox" 
  class="fixed inset-0 z-50 hidden bg-black/95 backdrop-blur-xl flex items-center justify-center p-4 sm:p-6 transition-all duration-300"
  role="dialog" 
  aria-modal="true"
  aria-label="Visor ampliado de fotografía"
>
  <div class="relative w-full max-w-5xl max-h-[92vh] flex flex-col items-center justify-between">
    
    <!-- Barra Superior de Control -->
    <div class="w-full flex items-center justify-between pb-3 text-white border-b border-white/15 mb-3">
      <div class="flex items-center gap-2">
        <span id="lightbox-counter" class="px-3 py-1 rounded-full bg-white/10 text-xs font-mono text-[#F5DEB3] border border-white/15">
          Foto 1 de 14
        </span>
        <span id="lightbox-badge" class="hidden sm:inline-block text-xs font-title font-bold uppercase tracking-wider text-gray-300">
          Memoria Gráfica LVT
        </span>
      </div>

      <div class="flex items-center gap-3">
        <button 
          id="close-gallery-lightbox" 
          type="button" 
          class="px-3.5 py-1.5 rounded-xl bg-white/10 hover:bg-[#EF7B38] text-white font-title text-xs font-bold uppercase tracking-wider transition flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span>Cerrar (Esc)</span>
        </button>
      </div>
    </div>

    <!-- Contenedor de Imagen Central con Botones Prev/Next -->
    <div class="relative w-full flex items-center justify-center overflow-hidden min-h-[300px] sm:min-h-[480px]">
      
      <!-- Botón Anterior -->
      <button 
        id="lightbox-prev" 
        type="button"
        class="absolute left-2 sm:left-4 z-20 p-3 rounded-full bg-black/60 hover:bg-[#EF7B38] text-white transition-all duration-200 border border-white/20 shadow-xl backdrop-blur-md cursor-pointer hover:scale-110"
        aria-label="Fotografía anterior"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Imagen Ampliada con Animación -->
      <img 
        id="lightbox-img" 
        src="" 
        alt="Fotografía ampliada" 
        class="max-h-[60vh] sm:max-h-[68vh] max-w-full w-auto rounded-2xl shadow-2xl object-contain transition-all duration-300 transform scale-95" 
      />

      <!-- Botón Siguiente -->
      <button 
        id="lightbox-next" 
        type="button"
        class="absolute right-2 sm:right-4 z-20 p-3 rounded-full bg-black/60 hover:bg-[#EF7B38] text-white transition-all duration-200 border border-white/20 shadow-xl backdrop-blur-md cursor-pointer hover:scale-110"
        aria-label="Fotografía siguiente"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

    </div>

    <!-- Pie de Foto Descriptivo -->
    <div class="w-full text-center mt-3 pt-3 border-t border-white/15 space-y-1">
      <h3 id="lightbox-title" class="font-serif text-base sm:text-xl font-bold text-white leading-tight"></h3>
      <p id="lightbox-desc" class="text-xs sm:text-sm text-gray-300 font-sans max-w-3xl mx-auto leading-relaxed"></p>
      <div id="lightbox-meta" class="text-[11px] text-[#C59B27] font-serif italic"></div>
    </div>

  </div>
</div>

<script>
  // Control Interactivo de Galería Multi-Evento y Lightbox
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const cards = Array.from(document.querySelectorAll('.gallery-card')) as HTMLElement[];
  
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const lightboxMeta = document.getElementById('lightbox-meta');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const closeBtn = document.getElementById('close-gallery-lightbox');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  let activeCards: HTMLElement[] = [...cards];
  let currentActiveIndex = 0;

  // 1. Filtrado de Eventos
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') || 'todos';

      // Actualizar estilos de botones
      filterBtns.forEach(b => {
        b.classList.remove('bg-[#EF7B38]', 'text-white', 'shadow-lg');
        b.classList.add('bg-white/5', 'text-gray-300', 'border', 'border-white/10');
      });
      btn.classList.remove('bg-white/5', 'text-gray-300', 'border', 'border-white/10');
      btn.classList.add('bg-[#EF7B38]', 'text-white', 'shadow-lg');

      // Filtrar tarjetas
      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (filter === 'todos' || cat === filter) {
          card.style.display = 'flex';
          card.style.opacity = '1';
          card.style.transform = 'scale(1)';
        } else {
          card.style.display = 'none';
          card.style.opacity = '0';
          card.style.transform = 'scale(0.95)';
        }
      });

      // Actualizar lista activa para el lightbox
      activeCards = cards.filter(c => filter === 'todos' || c.getAttribute('data-category') === filter);
    });
  });

  // 2. Apertura del Lightbox
  function updateLightboxData(index: number) {
    if (activeCards.length === 0) return;
    currentActiveIndex = (index + activeCards.length) % activeCards.length;
    const card = activeCards[currentActiveIndex];

    const src = card.getAttribute('data-src') || '';
    const title = card.getAttribute('data-title') || '';
    const desc = card.getAttribute('data-desc') || '';
    const lugar = card.getAttribute('data-lugar') || '';
    const fecha = card.getAttribute('data-fecha') || '';
    const evento = card.getAttribute('data-evento') || '';

    if (lightboxImg) {
      lightboxImg.style.opacity = '0';
      lightboxImg.style.transform = 'scale(0.95)';
      setTimeout(() => {
        lightboxImg.src = src;
        lightboxImg.style.opacity = '1';
        lightboxImg.style.transform = 'scale(1)';
      }, 150);
    }

    if (lightboxTitle) lightboxTitle.innerText = title;
    if (lightboxDesc) lightboxDesc.innerText = desc;
    if (lightboxMeta) lightboxMeta.innerText = `${evento} · ${lugar} (${fecha})`;
    if (lightboxCounter) lightboxCounter.innerText = `Foto ${currentActiveIndex + 1} de ${activeCards.length}`;
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const idx = activeCards.indexOf(card);
      if (idx !== -1) {
        updateLightboxData(idx);
        if (lightbox) {
          lightbox.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
      }
    });
  });

  // 3. Navegación Anterior / Siguiente
  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      updateLightboxData(currentActiveIndex - 1);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      updateLightboxData(currentActiveIndex + 1);
    });
  }

  // 4. Cerrar Lightbox
  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  // 5. Soporte para Teclado (Escape, Flechas Izquierda/Derecha)
  window.addEventListener('keydown', (e) => {
    if (lightbox && !lightbox.classList.contains('hidden')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') updateLightboxData(currentActiveIndex - 1);
      if (e.key === 'ArrowRight') updateLightboxData(currentActiveIndex + 1);
    }
  });
</script>
