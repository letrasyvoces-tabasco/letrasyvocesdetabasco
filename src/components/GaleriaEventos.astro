---
// GaleriaEventos.astro - Memoria Gráfica y Archivo Histórico de Eventos
const basePath = "";
---

<section id="galeria" class="py-14 sm:py-16 bg-carbon text-editorial border-b border-carbon-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-dorado/15 border border-dorado/30 text-dorado-light font-title text-[10px] sm:text-[11px] font-bold uppercase tracking-widest mb-3 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-terracota"></span>
        <span>Archivo Histórico & Encuentros Literarios</span>
      </div>
      <h2 class="font-title text-2xl sm:text-3xl lg:text-4xl font-black text-white">
        Memoria Gráfica Institucional
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-2 font-serif italic leading-relaxed">
        Testimonio visual de nuestros actos protocolarios, presentaciones de obras, asambleas y diálogos culturales en Tabasco.
      </p>
      <div class="w-20 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Cuadrícula Fotográfica Expandida -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Foto 1 -->
      <div class="overflow-hidden rounded-3xl border border-carbon-border bg-carbon-card group relative shadow-subtle cursor-pointer photo-item" data-full={`${basePath}/assets/galeria/evento_cacao_01.jpg`} data-caption="Presidium y Apertura Institucional · Presentación «A corazón abierto» (Casa Universitaria Cacao y Chocolate)">
        <img 
          src={`${basePath}/assets/galeria/evento_cacao_01.jpg`} 
          alt="Presidium Institucional LVT" 
          class="w-full h-80 object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition duration-500" 
          onerror="this.src='/assets/20260530_130817.jpg'"
          loading="lazy"
        />
        <div class="absolute bottom-0 w-full p-6 bg-gradient-to-t from-carbon via-carbon/80 to-transparent">
          <span class="text-[10px] font-title font-bold uppercase tracking-wider text-dorado-light block">Acto Protocolario</span>
          <h4 class="font-serif text-lg font-bold text-white">Presidium y Apertura</h4>
          <p class="text-xs text-gray-300 font-light">Casa Cacao y Chocolate · Villahermosa</p>
        </div>
      </div>

      <!-- Foto 2 -->
      <div class="overflow-hidden rounded-3xl border border-carbon-border bg-carbon-card group relative shadow-subtle cursor-pointer photo-item" data-full={`${basePath}/assets/galeria/evento_cacao_02.jpg`} data-caption="Mesa de Honor y Declamación · 30 de Mayo de 2026">
        <img 
          src={`${basePath}/assets/galeria/evento_cacao_02.jpg`} 
          alt="Mesa de Honor LVT" 
          class="w-full h-80 object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition duration-500" 
          onerror="this.src='/assets/20260530_130823.jpg'"
          loading="lazy"
        />
        <div class="absolute bottom-0 w-full p-6 bg-gradient-to-t from-carbon via-carbon/80 to-transparent">
          <span class="text-[10px] font-title font-bold uppercase tracking-wider text-dorado-light block">Voces Líricas</span>
          <h4 class="font-serif text-lg font-bold text-white">Lectura de Obra</h4>
          <p class="text-xs text-gray-300 font-light">María de los Ángeles Cervantes Rosas</p>
        </div>
      </div>

      <!-- Foto 3 -->
      <div class="overflow-hidden rounded-3xl border border-carbon-border bg-carbon-card group relative shadow-subtle cursor-pointer photo-item" data-full={`${basePath}/assets/galeria/evento_cacao_03.jpg`} data-caption="Intervención Crítica y Comentarios Editoriales">
        <img 
          src={`${basePath}/assets/galeria/evento_cacao_03.jpg`} 
          alt="Intervención Crítica" 
          class="w-full h-80 object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition duration-500" 
          onerror="this.src='/assets/IMG-20260530-WA0061.jpg'"
          loading="lazy"
        />
        <div class="absolute bottom-0 w-full p-6 bg-gradient-to-t from-carbon via-carbon/80 to-transparent">
          <span class="text-[10px] font-title font-bold uppercase tracking-wider text-dorado-light block">Crítica Literaria</span>
          <h4 class="font-serif text-lg font-bold text-white">Comentarios Editoriales</h4>
          <p class="text-xs text-gray-300 font-light">Análisis de la obra poética</p>
        </div>
      </div>

      <!-- Foto 4 -->
      <div class="overflow-hidden rounded-3xl border border-carbon-border bg-carbon-card group relative shadow-subtle cursor-pointer photo-item" data-full={`${basePath}/assets/galeria/evento_cacao_04.jpg`} data-caption="Auditorio y Asistentes al Evento Cultural">
        <img 
          src={`${basePath}/assets/galeria/evento_cacao_04.jpg`} 
          alt="Auditorio y Asistentes" 
          class="w-full h-80 object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition duration-500" 
          onerror="this.src='/assets/20260530_130817.jpg'"
          loading="lazy"
        />
        <div class="absolute bottom-0 w-full p-6 bg-gradient-to-t from-carbon via-carbon/80 to-transparent">
          <span class="text-[10px] font-title font-bold uppercase tracking-wider text-dorado-light block">Comunidad</span>
          <h4 class="font-serif text-lg font-bold text-white">Público y Colegiados</h4>
          <p class="text-xs text-gray-300 font-light">Encuentro de lectores y autores</p>
        </div>
      </div>

      <!-- Foto 5 -->
      <div class="overflow-hidden rounded-3xl border border-carbon-border bg-carbon-card group relative shadow-subtle cursor-pointer photo-item" data-full={`${basePath}/assets/galeria/evento_cacao_05.jpg`} data-caption="Firma de Ejemplares y Convivencia Institucional">
        <img 
          src={`${basePath}/assets/galeria/evento_cacao_05.jpg`} 
          alt="Firma de Ejemplares" 
          class="w-full h-80 object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition duration-500" 
          onerror="this.src='/assets/20260530_130823.jpg'"
          loading="lazy"
        />
        <div class="absolute bottom-0 w-full p-6 bg-gradient-to-t from-carbon via-carbon/80 to-transparent">
          <span class="text-[10px] font-title font-bold uppercase tracking-wider text-dorado-light block">Dedicatoria</span>
          <h4 class="font-serif text-lg font-bold text-white">Firma de Libros</h4>
          <p class="text-xs text-gray-300 font-light">Clausura del acto editorial</p>
        </div>
      </div>

      <!-- Foto 6 -->
      <div class="overflow-hidden rounded-3xl border border-carbon-border bg-carbon-card group relative shadow-subtle cursor-pointer photo-item" data-full={`${basePath}/assets/IMG-20260530-WA0061.jpg`} data-caption="Mesa Directiva y Escritores en Diálogo Cultural">
        <img 
          src={`${basePath}/assets/IMG-20260530-WA0061.jpg`} 
          alt="Mesa Directiva LVT" 
          class="w-full h-80 object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition duration-500" 
          onerror="this.src='/assets/logo.svg'"
          loading="lazy"
        />
        <div class="absolute bottom-0 w-full p-6 bg-gradient-to-t from-carbon via-carbon/80 to-transparent">
          <span class="text-[10px] font-title font-bold uppercase tracking-wider text-dorado-light block">Gremio</span>
          <h4 class="font-serif text-lg font-bold text-white">Fraternidad Literaria</h4>
          <p class="text-xs text-gray-300 font-light">Diálogo entre generaciones de escritores</p>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Lightbox de Galería Fotográfica -->
<div id="gallery-lightbox" class="fixed inset-0 z-50 hidden bg-carbon/95 backdrop-blur-md flex items-center justify-center p-4" role="dialog" aria-modal="true">
  <div class="relative max-w-4xl max-h-[90vh] flex flex-col items-center">
    <button id="close-gallery-lightbox" type="button" class="absolute -top-12 right-0 text-white hover:text-terracota p-2 text-sm font-title font-bold uppercase flex items-center gap-1 cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
      Cerrar
    </button>
    <img id="lightbox-img" src="" alt="Fotografía ampliada" class="max-h-[75vh] w-auto rounded-2xl shadow-2xl object-contain" />
    <p id="lightbox-caption" class="text-xs sm:text-sm text-gray-300 font-serif italic mt-4 text-center"></p>
  </div>
</div>

<script>
  // Control de Lightbox de Galería
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCap = document.getElementById('lightbox-caption');
  const closeGalleryBtn = document.getElementById('close-gallery-lightbox');

  document.querySelectorAll('.photo-item').forEach(item => {
    item.addEventListener('click', () => {
      const full = item.getAttribute('data-full');
      const caption = item.getAttribute('data-caption');
      if (full && lightbox && lightboxImg && lightboxCap) {
        lightboxImg.src = full;
        lightboxCap.innerText = caption || '';
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  if (closeGalleryBtn) closeGalleryBtn.addEventListener('click', closeLightbox);
  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }
</script>
