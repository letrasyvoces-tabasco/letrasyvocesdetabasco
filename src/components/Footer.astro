---
// Footer.astro - Pie de Página Oficial LVT
const basePath = "/letrasyvocesdetabasco";
---

<footer class="bg-carbon text-gray-400 py-14 border-t border-carbon-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center border-b border-carbon-border pb-10 mb-8 gap-8">
      
      <div class="flex items-center space-x-4">
        <img 
          src={`${basePath}/assets/LVT Logo Iso 1 Original.png`} 
          alt="Isotipo LVT" 
          class="h-12 w-auto object-contain filter invert brightness-200" 
          onerror="this.src='/letrasyvocesdetabasco/assets/logo.svg'" 
        />
        <div class="text-left">
          <span class="font-serif text-xl font-bold text-white block">Letras y Voces de Tabasco, A.C.</span>
          <span class="text-xs text-gray-400">Villahermosa, Tabasco, México</span>
        </div>
      </div>

      <div class="flex flex-wrap justify-center gap-6 text-xs font-title font-bold uppercase tracking-wider text-gray-300">
        <a href="#inicio" class="hover:text-terracota transition-colors">Inicio</a>
        <a href="#quienes-somos" class="hover:text-terracota transition-colors">Semblanza</a>
        <a href="#antologias" class="hover:text-terracota transition-colors">Publicaciones</a>
        <a href="#convocatorias" class="hover:text-terracota transition-colors">Convocatorias</a>
        <a href="#galeria" class="hover:text-terracota transition-colors">Eventos</a>
        <a href="#rifa" class="hover:text-terracota transition-colors">Rifa 2026</a>
        <a href="#directiva" class="hover:text-terracota transition-colors">Directiva</a>
        <a href="#contacto" class="hover:text-terracota transition-colors">Contacto</a>
      </div>
    </div>

    <div class="text-center md:text-left flex flex-col md:flex-row justify-between items-center text-xs text-gray-400 gap-4">
      <p>&copy; 2026 Sociedad de Escritores Letras y Voces de Tabasco, A.C. Todos los derechos reservados.</p>
      <p class="font-serif italic text-base text-gray-300">
        Cordialmente, Sociedad de Escritores Letras y Voces de Tabasco, A.C.
      </p>
    </div>
  </div>
</footer>

<script>
  // Script de Navegación Móvil y Transiciones Suaves
  const mobileToggle = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
    });
  }
</script>
