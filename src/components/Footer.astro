---
// Footer.astro - Pie de Página Oficial LVT con Enlaces Canónicos y Correos del Dominio Propio
const basePath = "";
---

<footer class="bg-ink text-gray-400 py-16 border-t border-paper-border/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <div class="flex flex-col lg:flex-row justify-between items-center border-b border-white/10 pb-10 gap-8">
      
      <!-- Identidad y Logotipo Oficial -->
      <a href={`${basePath}/`} class="flex items-center space-x-3.5 group">
        <img 
          src={`${basePath}/assets/logos/LVT Logo Iso 6 Blanco Relleno.svg`} 
          alt="Isotipo Oficial LVT" 
          class="h-11 sm:h-12 w-auto object-contain group-hover:scale-105 transition duration-200" 
          onerror="this.src='/assets/logos/LVT Logo Iso 1 Original.png'" 
        />
        <div class="text-left">
          <span class="font-monograph text-lg sm:text-xl font-bold text-white block leading-tight">
            Sociedad de Escritores Letras y Voces de Tabasco, A.C.
          </span>
          <span class="text-xs text-oro-bright font-serif italic block">
            Institución Cultural Autónoma • Fundada en 1987 • Villahermosa, Tabasco
          </span>
        </div>
      </a>

      <!-- Enlaces Canónicos Absolutos -->
      <div class="flex flex-wrap justify-center lg:justify-end gap-x-5 gap-y-2.5 text-xs font-swiss font-bold uppercase tracking-wider text-gray-300">
        <a href={`${basePath}/`} class="hover:text-cacao-light transition-colors py-1">Inicio</a>
        <a href={`${basePath}/EEJG`} class="hover:text-cacao-light transition-colors py-1 text-cacao-light">Escuela de Escritores (EEJG)</a>
        <a href={`${basePath}/publicaciones`} class="hover:text-cacao-light transition-colors py-1">Publicaciones</a>
        <a href={`${basePath}/audioteca`} class="hover:text-cacao-light transition-colors py-1">Audioteca</a>
        <a href={`${basePath}/autores`} class="hover:text-cacao-light transition-colors py-1">Autores</a>
        <a href={`${basePath}/historia`} class="hover:text-cacao-light transition-colors py-1">Historia</a>
        <a href={`${basePath}/historia#directiva`} class="hover:text-cacao-light transition-colors py-1">Directiva</a>
        <a href={`${basePath}/descargas#convocatorias`} class="hover:text-cacao-light transition-colors py-1">Convocatorias</a>
        <a href={`${basePath}/descargas`} class="hover:text-cacao-light transition-colors py-1">Descargas</a>
        <a href={`${basePath}/#contacto`} class="hover:text-cacao-light transition-colors py-1 text-oro-bright">Contacto</a>
      </div>

    </div>

    <!-- Directorio de Contacto Oficial y Redirecciones -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-gray-400 font-sans border-b border-white/10 pb-8">
      <div>
        <span class="font-swiss font-bold text-white uppercase tracking-wider block mb-1">Presidencia</span>
        <a href="mailto:presidencia@letrasyvocesdetabasco.org" class="hover:text-cacao-light transition">presidencia@letrasyvocesdetabasco.org</a>
      </div>
      <div>
        <span class="font-swiss font-bold text-white uppercase tracking-wider block mb-1">Secretaría General</span>
        <a href="mailto:secretaria@letrasyvocesdetabasco.org" class="hover:text-cacao-light transition">secretaria@letrasyvocesdetabasco.org</a>
      </div>
      <div>
        <span class="font-swiss font-bold text-white uppercase tracking-wider block mb-1">Buzón General & WhatsApp</span>
        <a href="mailto:contacto@letrasyvocesdetabasco.org" class="hover:text-cacao-light transition block">contacto@letrasyvocesdetabasco.org</a>
        <a href="https://wa.me/522205889391" target="_blank" rel="noopener noreferrer" class="text-oro-bright hover:underline font-mono">+52 220 588 9391</a>
      </div>
    </div>

    <!-- Créditos y Derechos -->
    <div class="flex flex-col sm:flex-row justify-between items-center text-xs text-gray-400 gap-4 text-center sm:text-left font-sans">
      <p>&copy; 2026 Sociedad de Escritores Letras y Voces de Tabasco, A.C. Dominio oficial: <strong class="text-white">letrasyvocesdetabasco.org</strong></p>
      <p class="font-serif italic text-sm text-oro-bright">
        «Preservamos la palabra, impulsamos la lírica del Sureste.»
      </p>
    </div>

  </div>
</footer>
