---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Letras y Voces de Tabasco, A.C. | Sociedad de Escritores",
  description = "Sociedad de Escritores Letras y Voces de Tabasco, A.C. Más de 38 años de memoria lírica, publicaciones colectivas y fomento de la creación literaria en el Sureste de México.",
  image = "/letrasyvocesdetabasco/assets/LVT Logo Hor 1 Original.png"
} = Astro.props;

const siteUrl = "https://letrasyvocesdetabasco.github.io/letrasyvocesdetabasco";
const fullImageUrl = `https://letrasyvocesdetabasco.github.io${image}`;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="ie=edge" />
  
  <!-- Primarios SEO -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content="Letras y Voces de Tabasco, Sociedad de Escritores, Literatura de Tabasco, Poetas de Tabasco, Villahermosa, Animalia Literaria, A corazón abierto, Convocatorias Literarias Tabasco 2026" />
  <meta name="author" content="Sociedad de Escritores Letras y Voces de Tabasco, A.C." />
  <meta name="theme-color" content="#FAF7F2" />
  <link rel="canonical" href={siteUrl} />
  
  <!-- Favicon e Iconografía -->
  <link rel="icon" type="image/svg+xml" href="/letrasyvocesdetabasco/assets/logo.svg" />
  <link rel="apple-touch-icon" href="/letrasyvocesdetabasco/assets/LVT Logo Iso 1 Original.png" />

  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullImageUrl} />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:site_name" content="Letras y Voces de Tabasco, A.C." />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={siteUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullImageUrl} />

  <!-- Tipografías Editoriales de Prestigio (Google Fonts) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Montserrat:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Schema.org Datos Estructurados JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": "Sociedad de Escritores Letras y Voces de Tabasco, A.C.",
    "alternateName": "Letras y Voces de Tabasco",
    "url": "https://letrasyvocesdetabasco.github.io/letrasyvocesdetabasco",
    "logo": "https://letrasyvocesdetabasco.github.io/letrasyvocesdetabasco/assets/LVT Logo Hor 1 Original.png",
    "description": "Sociedad de escritores legalmente constituida dedicada al fomento de la literatura, poesía, ensayo y cultura en Tabasco.",
    "foundingDate": "1988",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Villahermosa",
      "addressRegion": "Tabasco",
      "addressCountry": "MX"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "lvt.correo@gmail.com",
      "telephone": "+52-220-588-9391",
      "contactType": "Secretaría General"
    },
    "sameAs": [
      "https://www.facebook.com/letrayvoces.tabasco/",
      "https://www.instagram.com/letrasyvoces.tabasco/"
    ]
  })} />
</head>

<body class="bg-editorial text-carbon antialiased selection:bg-terracota selection:text-white flex flex-col min-h-screen">
  <slot />
</body>
</html>
