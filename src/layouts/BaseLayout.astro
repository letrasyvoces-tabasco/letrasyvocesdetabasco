---
import MobileDrawer from '../components/MobileDrawer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Sociedad de Escritores Letras y Voces de Tabasco, A.C.",
  description = "Portal oficial de la Sociedad de Escritores Letras y Voces de Tabasco, A.C. Difusión literaria, fondo editorial, fonoteca de poesía, Escuela de Escritores «José Gorostiza» (EEJG), convocatorias y gobernanza cultural en el sureste mexicano.",
  image = "/assets/galeria/evento_cacao_01.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://letrasyvocesdetabasco.org");
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="icon" type="image/svg+xml" href="/assets/logos/LVT Logo Iso 1 Original.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primarios SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Sociedad de Escritores Letras y Voces de Tabasco, A.C." />
    <link rel="canonical" href={canonicalURL} />

    <!-- Tarjetas Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Letras y Voces de Tabasco, A.C." />

    <!-- Tarjetas Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Tipografías Oficiales & Alta Gama Editorial con display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Newsreader:ital,opsz,wght@0,6..72,300..800;1,6..72,300..800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Datos Estructurados Schema.org (Organización Cultural & Educativa) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": ["NGO", "EducationalOrganization"],
        "name": "Sociedad de Escritores Letras y Voces de Tabasco, A.C.",
        "alternateName": "Letras y Voces de Tabasco",
        "url": "https://letrasyvocesdetabasco.org",
        "logo": "https://letrasyvocesdetabasco.org/assets/logos/LVT Logo Hor 1 Original.svg",
        "email": "contacto@letrasyvocesdetabasco.org",
        "telephone": "+522205889391",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Calle Centenario Instituto Juárez s/n, Colonia Reforma",
          "addressLocality": "Villahermosa",
          "addressRegion": "Tabasco",
          "postalCode": "86080",
          "addressCountry": "MX"
        },
        "sameAs": [
          "https://web.facebook.com/profile.php?id=100063472631282"
        ],
        "description": "Asociación civil fundada en 1987 dedicada a la promoción literaria, docencia especializada en la Escuela de Escritores «José Gorostiza» (EEJG), edición de antologías y preservación patrimonial en el Sureste de México."
      }
    </script>

    <slot name="head" />
  </head>
  <body class="bg-paper text-ink font-serif antialiased selection:bg-cacao selection:text-white min-h-screen flex flex-col justify-between">
    <div class="relative flex-1 flex flex-col">
      <slot />
    </div>

    <!-- Menú Desplegable Táctil Móvil Centralizado -->
    <MobileDrawer />
  </body>
</html>
