---
import MobileDrawer from '../components/MobileDrawer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Sociedad de Escritores Letras y Voces de Tabasco, A.C.",
  description = "Portal oficial de la Sociedad de Escritores Letras y Voces de Tabasco, A.C. Difusión literaria, fondo editorial, fonoteca de poesía, convocatorias y gobernanza cultural en el sureste mexicano.",
  image = "/assets/branding/lvt_og_banner.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://letrasyvocesdetabasco.github.io");
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="icon" type="image/svg+xml" href="/assets/branding/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primarios SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Sociedad de Escritores Letras y Voces de Tabasco, A.C." />
    <link rel="canonical" href={canonicalURL} />

    <!-- Tarjetas Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Letras y Voces de Tabasco, A.C." />

    <!-- Tarjetas Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Tipografías Oficiales del Manual de Marca LVT -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Datos Estructurados Schema.org (Asociación Cultural) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "NGO",
        "name": "Sociedad de Escritores Letras y Voces de Tabasco, A.C.",
        "alternateName": "Letras y Voces de Tabasco",
        "url": "https://letrasyvocesdetabasco.github.io",
        "logo": "https://letrasyvocesdetabasco.github.io/assets/branding/logo_lvt.svg",
        "email": "lvt.correo@gmail.com",
        "sameAs": [
          "https://web.facebook.com/profile.php?id=100063472631282"
        ],
        "description": "Asociación civil dedicada a la promoción literaria, edición de antologías y preservación cultural en el estado de Tabasco, México."
      }
    </script>
  </head>
  <body class="bg-editorial text-carbon font-sans antialiased selection:bg-terracota selection:text-white min-h-screen flex flex-col">
    <slot />
    
    <!-- Menú Móvil Táctil Global Independiente del Header -->
    <MobileDrawer />
  </body>
</html>
